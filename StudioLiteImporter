local function matchAny(s, pats)
    s = tostring(s or ""):lower()
    for _, p in ipairs(pats) do
        if s:find(p) then return true end
    end
    return false
end

-- tekan tombol bawaan
-- v7: satu klik = satu tembakan. v6 memakai firesignal DAN getconnections sekaligus (handler jalan dua kali, jadi
-- Pause / Stop batal sendiri dan Play macet di "Memulai Server..."). Pencarian bisa "wide" (seluruh PlayerGui dan
-- nama induk), ada fallback klik virtual, dan daftar tombol bisa ditulis ke file untuk diagnosa.
NV.lastPress = {}

function NV.roots(wide)
    local g = NV.gui()
    local roots = {}
    if g then roots[1] = g end
    if wide then
        local pg = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
        if pg then
            for _, c in ipairs(pg:GetChildren()) do
                if c ~= g and c:IsA("LayerCollector") and c.Name ~= "SLStudio" and c.Name ~= "SLStudioMini"
                    and c.Name ~= "SLImporter" and c.Name:sub(1, 10) ~= "SLPreview_" then
                    roots[#roots + 1] = c
                end
            end
        end
    end
    return roots
end

function NV.candidates(pats, wide)
    local out = {}
    for ri, root in ipairs(NV.roots(wide)) do
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("GuiObject") then
                local isBtn = d:IsA("GuiButton")
                if isBtn or wide then
                    local txt = ""
                    if d:IsA("TextButton") or d:IsA("TextLabel") then pcall(function() txt = d.Text end) end
                    local own = matchAny(d.Name, pats) or matchAny(txt, pats)
                    local hit = own
                    if not hit and wide and isBtn and d.Parent and d.Parent:IsA("GuiObject") then
                        hit = matchAny(d.Parent.Name, pats)
                    end
                    if hit then
                        local target
                        if isBtn then
                            target = d
                        else
                            for _, c in ipairs(d:GetDescendants()) do
                                if c:IsA("GuiButton") then target = c break end
                            end
                            if not target then
                                local a, n = d.Parent, 0
                                while a and n < 3 do
                                    if a:IsA("GuiButton") then target = a break end
                                    a, n = a.Parent, n + 1
                                end
                            end
                        end
                        if target then
                            local score = 0
                            if ri == 1 then score = score + 30 end
                            if target:FindFirstAncestor("TopBar") then score = score + 20 end
                            if own then score = score + 10 end
                            local ln = d.Name:lower()
                            if ln == "play" or ln == "pause" or ln == "stop" then score = score + 15 end
                            local vis = false
                            pcall(function() vis = target.Visible end)
                            if vis then score = score + 5 end
                            score = score - math.min(#d.Name, 30) * 0.1
                            out[#out + 1] = { b = target, score = score, name = d.Name, txt = txt }
                        end
                    end
                end
            end
        end
    end
    table.sort(out, function(a, b) return a.score > b.score end)
    return out
end

local CLICK_SIGNALS = { "MouseButton1Down", "MouseButton1Up", "MouseButton1Click", "Activated" }

-- klik virtual (StudioGui diaktifkan sebentar di atas semua UI lalu disembunyikan lagi)
function NV.virtualClick(b)
    local okV, vim = pcall(function() return game:GetService("VirtualInputManager") end)
    if not okV or not vim then return nil end
    local g = NV.gui()
    if not g then return nil end
    task.spawn(function()
        local was, order = g.Enabled, g.DisplayOrder
        pcall(function() g.Enabled = true end)
        pcall(function() g.DisplayOrder = 2000 end)
        task.wait(0.08)
        local pos, size = b.AbsolutePosition, b.AbsoluteSize
        local inset = Vector2.new(0, 0)
        if not g.IgnoreGuiInset then
            local okI, gi = pcall(function() return GuiService:GetGuiInset() end)
            if okI and gi then inset = gi end
        end
        local x = pos.X + size.X / 2 + inset.X
        local y = pos.Y + size.Y / 2 + inset.Y
        pcall(function() vim:SendMouseButtonEvent(x, y, 0, true, game, 0) end)
        task.wait(0.05)
        pcall(function() vim:SendMouseButtonEvent(x, y, 0, false, game, 0) end)
        task.wait(0.15)
        pcall(function() g.DisplayOrder = order end)
        pcall(function() g.Enabled = was end)
    end)
    return "virtual"
end

function NV.fire(b)
    -- jumlah koneksi yang terlihat (kalau getconnections ada)
    local total, known = 0, false
    if getconnections then
        for _, sig in ipairs(CLICK_SIGNALS) do
            local okC, conns = pcall(getconnections, b[sig])
            if okC and type(conns) == "table" then
                known = true
                total = total + #conns
            end
        end
    end
    if known and total == 0 then
        -- tidak ada handler terlihat (game mungkin memakai InputBegan / getconnections tidak lengkap): klik virtual
        local v = NV.virtualClick(b)
        if v then return v end
    end
    if firesignal then
        local any = false
        for _, sig in ipairs(CLICK_SIGNALS) do
            local ok = pcall(function() firesignal(b[sig]) end)
            any = any or ok
        end
        if any then return "firesignal" end
    end
    if getconnections then
        local seen, n = {}, 0
        for _, sig in ipairs(CLICK_SIGNALS) do
            local okC, conns = pcall(getconnections, b[sig])
            if okC and type(conns) == "table" then
                for _, c in ipairs(conns) do
                    local fn = c.Function
                    if not (fn and seen[fn]) then
                        if fn then seen[fn] = true end
                        if c.Fire and pcall(function() c:Fire() end) then n = n + 1 end
                    end
                end
            end
        end
        if n > 0 then return "getconnections" end
    end
    return NV.virtualClick(b)
end

function NV.press(pats, wide)
    local g = NV.gui()
    if not g then return false end
    local key = table.concat(pats, "|")
    local now = os.clock()
    local last = NV.lastPress[key]
    if last and now - last < 0.6 then return true end -- anti klik ganda
    local list = NV.candidates(pats, wide)
    for i = 1, math.min(#list, 3) do
        local how = NV.fire(list[i].b)
        if how then
            NV.lastPress[key] = now
            logLine("Tombol asli '" .. list[i].name .. "' ditekan (" .. how .. ")", "info")
            return true
        end
    end
    return false
end

-- tulis semua GuiObject StudioGui ke file (buat diagnosa: nama asli tombol Play / Pause / Stop)
function NV.dumpFile()
    local g = NV.gui()
    if not g or not writefile then return false end
    local lines = { "StudioGui dump " .. os.date("%Y-%m-%d %H:%M:%S"), "Enabled=" .. tostring(g.Enabled) .. " DisplayOrder=" .. tostring(g.DisplayOrder), "" }
    for _, d in ipairs(g:GetDescendants()) do
        if d:IsA("GuiObject") then
            local txt = ""
            if d:IsA("TextButton") or d:IsA("TextLabel") or d:IsA("TextBox") then pcall(function() txt = d.Text end) end
            local path = d:GetFullName()
            path = path:gsub("^.-StudioGui", "StudioGui")
            lines[#lines + 1] = string.format("%s [%s] vis=%s text=%q", path, d.ClassName, tostring(d.Visible), txt)
            if #lines > 4000 then break end
        end
    end
    pcall(ensureFolder)
    return (pcall(writefile, CONFIG.Folder .. "/native_ui_dump.txt", table.concat(lines, "\n")))
end

function NV.report()
    if NV.reported and os.clock() - NV.reported < 10 then return end
    NV.reported = os.clock()
    pcall(NV.dump)
    pcall(NV.dumpFile)
end

NV.TP = {
    play = { narrow = { "^play", "^run$", "playbutton" }, broad = { "^play", "play$", "[_%-%s]play", "playbtn", "^run" } },
    pause = { narrow = { "^pause" }, broad = { "pause", "^resume" } },
    stop = { narrow = { "^stop" }, broad = { "stop$", "[_%-%s]stop", "stopbtn", "^halt" } },
}

function NV.transport(kind)
    local tp = NV.TP[kind]
    if not tp then return false end
    local ok = NV.press(tp.narrow, false) or NV.press(tp.broad, true)
    if ok then
        if kind == "play" then ST.playing = true elseif kind == "stop" then ST.playing = false end
        setStatus(kind == "play" and "Play dikirim ke Studio Lite..." or (kind == "pause" and "Pause dikirim." or "Stop dikirim."), "ok")
    else
        NV.report()
        notify("Tombol " .. kind .. " asli tidak ditemukan. Daftar tombol ada di Output dan StudioLiteImports/native_ui_dump.txt.", "warn")
    end
    return ok
end

function NV.close()
    local dlg = NV.dialog
    if not dlg then return end
    NV.dialog = nil
    local g = NV.gui()
    for inst, was in pairs(dlg.saved) do
        if was and inst.Parent then pcall(function() inst.Visible = true end) end
    end
    if g then
        pcall(function() g.DisplayOrder = dlg.order end)
        pcall(function() g.Enabled = dlg.enabled end)
    end
    if NV.banner then
        pcall(function() NV.banner:Destroy() end)
        NV.banner = nil
    end
    NV.applyHidden()
end

-- buka dialog asli: frameName = nama Frame yang harus tampil, pats = pola tombol pemicu
function NV.open(frameName, pats)
    local g = NV.gui()
    if not g then
        notify("UI asli Studio Lite tidak ditemukan (StudioGui).", "warn")
        return
    end
    if NV.dialog then NV.close() end
    local target = g:FindFirstChild(frameName, true)
    local chain = {}
    local cur = target
    while cur and cur ~= g do
        chain[cur] = true
        cur = cur.Parent
    end
    local saved = {}
    for _, c in ipairs(g:GetChildren()) do
        if c:IsA("GuiObject") and not chain[c] and c.Visible then
            saved[c] = true
            c.Visible = false
        end
    end
    local dlg = { saved = saved, target = target, order = g.DisplayOrder, enabled = g.Enabled, t0 = os.clock() }
    NV.dialog = dlg
    g.DisplayOrder = 2000
    g.Enabled = true
    local fired = pats and NV.press(pats)
    if not fired and target and target:IsA("GuiObject") then target.Visible = true end

    -- spanduk kecil untuk menutup dialog asli
    local bn = frame(UI.frame, { Size = UDim2.fromOffset(190, 28), AnchorPoint = V2(0.5, 0), Position = U2(0.5, 0, 0, 36), BackgroundColor3 = T.accent, ZIndex = 60 })
    corner(bn, 14)
    local bl = lbl(bn, { Size = U2(1, 0, 1, 0), Text = "Close native dialog", TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = T.accentText, Font = FONTM, TextSize = 13 })
    local bb = btn(bn, { Size = U2(1, 0, 1, 0) })
    NV.banner = bn
    bn.Parent = UI.pop
    on(bb.MouseButton1Click, function()
        if target and target:IsA("GuiObject") then pcall(function() target.Visible = false end) end
        NV.close()
    end)
    local gen0 = gen
    task.spawn(function()
        while alive() and NV.dialog == dlg and gen0 == gen do
            task.wait(0.3)
            if os.clock() - dlg.t0 > 0.8 then
                local vis = target and target.Parent and target:IsA("GuiObject") and target.Visible
                if not vis then
                    NV.close()
                    if not fired then notify("Dialog asli tidak bisa dibuka dari sini.", "warn") end
                    break
                end
            end
        end
    end)
end

function NV.dump()
    local g = NV.gui()
    if not g then OUT.add("StudioGui tidak ditemukan.", "warn") return end
    local names = {}
    for _, c in ipairs(g:GetChildren()) do names[#names + 1] = c.Name end
    OUT.add("StudioGui: " .. table.concat(names, ", "), "info")
    local tb = g:FindFirstChild("TopBar")
    if tb then
        local btns = {}
        for _, d in ipairs(tb:GetDescendants()) do
            if d:IsA("GuiButton") then
                local t = ""
                pcall(function() t = d.Text end)
                btns[#btns + 1] = d.Name .. (t ~= "" and ('="' .. t .. '"') or "")
            end
        end
        OUT.add("TopBar buttons: " .. table.concat(btns, ", "), "info")
    end
end

