-- [[PARSER BEGIN]]
-- Parser rbxmx minimal (fallback kalau getcustomasset tidak ada)

local function xmlUnescape(s)
    s = s:gsub("&#x(%x+);", function(h) return utf8.char(tonumber(h, 16)) end)
    s = s:gsub("&#(%d+);", function(d) return utf8.char(tonumber(d)) end)
    s = s:gsub("&lt;", "<")
    s = s:gsub("&gt;", ">")
    s = s:gsub("&quot;", '"')
    s = s:gsub("&apos;", "'")
    s = s:gsub("&amp;", "&")
    return s
end

local function xmlParse(xml)
    local root = { children = {} }
    local stack = { root }
    local pos = 1
    while true do
        local lt = xml:find("<", pos, true)
        if not lt then break end
        if lt > pos then
            local text = xml:sub(pos, lt - 1)
            if text:match("%S") then
                local top = stack[#stack]
                top.text = (top.text or "") .. xmlUnescape(text)
            end
        end
        if xml:sub(lt, lt + 8) == "<![CDATA[" then
            local e = xml:find("]]>", lt + 9, true)
            if not e then error("CDATA tidak ditutup") end
            local top = stack[#stack]
            top.text = (top.text or "") .. xml:sub(lt + 9, e - 1)
            pos = e + 3
        elseif xml:sub(lt, lt + 3) == "<!--" then
            local e = xml:find("-->", lt + 4, true)
            if not e then error("komentar tidak ditutup") end
            pos = e + 3
        elseif xml:sub(lt, lt + 1) == "<?" then
            local e = xml:find("?>", lt + 2, true)
            if not e then error("deklarasi XML tidak ditutup") end
            pos = e + 2
        elseif xml:sub(lt, lt + 1) == "<!" then
            local e = xml:find(">", lt, true)
            if not e then error("tag tidak ditutup") end
            pos = e + 1
        elseif xml:sub(lt, lt + 1) == "</" then
            local e = xml:find(">", lt, true)
            if not e then error("tag penutup rusak") end
            if #stack > 1 then table.remove(stack) end
            pos = e + 1
        else
            local e = xml:find(">", lt, true)
            if not e then error("tag tidak ditutup") end
            local tagText = xml:sub(lt + 1, e - 1)
            local selfClose = tagText:sub(-1) == "/"
            if selfClose then tagText = tagText:sub(1, -2) end
            local name, rest = tagText:match("^([^%s]+)%s*(.*)$")
            local node = { name = name, attrs = {}, children = {} }
            for k, q, v in (rest or ""):gmatch("([%w_:%-]+)%s*=%s*([\"'])(.-)%2") do
                node.attrs[k] = xmlUnescape(v)
            end
            local top = stack[#stack]
            top.children[#top.children + 1] = node
            if not selfClose then stack[#stack + 1] = node end
            pos = e + 1
        end
    end
    return root
end

local function xmlChild(node, name)
    for _, c in ipairs(node.children) do
        if c.name == name then return c end
    end
    return nil
end

local function xmlNum(node, name)
    local c = xmlChild(node, name)
    return (c and tonumber(c.text)) or 0
end

local PROP_ALIASES = {
    size = "Size",
    shape = "Shape",
    Color3uint8 = "Color",
}

local function setEnum(inst, prop, raw)
    local n = tonumber(raw)
    if not n then return false end
    local ok, cur = pcall(function() return inst[prop] end)
    if ok and typeof(cur) == "EnumItem" then
        for _, item in ipairs(cur.EnumType:GetEnumItems()) do
            if item.Value == n then
                return pcall(function() inst[prop] = item end)
            end
        end
    end
    return false
end

local function convertValue(p)
    local t = p.name
    if t == "string" or t == "ProtectedString" then
        return true, p.text or ""
    elseif t == "bool" then
        return true, (p.text == "true")
    elseif t == "int" or t == "int64" or t == "float" or t == "double" then
        return true, tonumber(p.text) or 0
    elseif t == "Vector3" then
        return true, Vector3.new(xmlNum(p, "X"), xmlNum(p, "Y"), xmlNum(p, "Z"))
    elseif t == "Vector2" then
        return true, Vector2.new(xmlNum(p, "X"), xmlNum(p, "Y"))
    elseif t == "Color3" then
        if #p.children > 0 then
            return true, Color3.new(xmlNum(p, "R"), xmlNum(p, "G"), xmlNum(p, "B"))
        end
        local n = tonumber(p.text)
        if not n then return false end
        return true, Color3.fromRGB(math.floor(n / 65536) % 256, math.floor(n / 256) % 256, n % 256)
    elseif t == "Color3uint8" then
        local n = tonumber(p.text)
        if not n then return false end
        return true, Color3.fromRGB(math.floor(n / 65536) % 256, math.floor(n / 256) % 256, n % 256)
    elseif t == "CoordinateFrame" or t == "CFrame" then
        return true, CFrame.new(
            xmlNum(p, "X"), xmlNum(p, "Y"), xmlNum(p, "Z"),
            xmlNum(p, "R00"), xmlNum(p, "R01"), xmlNum(p, "R02"),
            xmlNum(p, "R10"), xmlNum(p, "R11"), xmlNum(p, "R12"),
            xmlNum(p, "R20"), xmlNum(p, "R21"), xmlNum(p, "R22")
        )
    elseif t == "UDim2" then
        return true, UDim2.new(xmlNum(p, "XS"), xmlNum(p, "XO"), xmlNum(p, "YS"), xmlNum(p, "YO"))
    elseif t == "UDim" then
        return true, UDim.new(xmlNum(p, "S"), xmlNum(p, "O"))
    elseif t == "BrickColor" then
        local n = tonumber(p.text)
        if not n then return false end
        return true, BrickColor.new(n)
    elseif t == "Content" then
        local u = xmlChild(p, "url") or xmlChild(p, "uri")
        local s = (u and u.text) or p.text
        if not s or s == "" or s == "null" then return false end
        return true, s
    elseif t == "NumberRange" then
        local a, b = (p.text or ""):match("(%S+)%s+(%S+)")
        if not (tonumber(a) and tonumber(b)) then return false end
        return true, NumberRange.new(tonumber(a), tonumber(b))
    elseif t == "Rect2D" or t == "Rect" then
        local mn, mx = xmlChild(p, "min"), xmlChild(p, "max")
        if not (mn and mx) then return false end
        return true, Rect.new(xmlNum(mn, "X"), xmlNum(mn, "Y"), xmlNum(mx, "X"), xmlNum(mx, "Y"))
    elseif t == "Vector3int16" then
        return true, Vector3int16.new(xmlNum(p, "X"), xmlNum(p, "Y"), xmlNum(p, "Z"))
    elseif t == "NumberSequence" then
        local keys = {}
        for a, b, c in (p.text or ""):gmatch("(%S+)%s+(%S+)%s+(%S+)") do
            keys[#keys + 1] = NumberSequenceKeypoint.new(tonumber(a), tonumber(b), tonumber(c))
        end
        if #keys < 2 then return false end
        return true, NumberSequence.new(keys)
    elseif t == "ColorSequence" then
        local keys = {}
        for a, r, g, b in (p.text or ""):gmatch("(%S+)%s+(%S+)%s+(%S+)%s+(%S+)%s+%S+") do
            keys[#keys + 1] = ColorSequenceKeypoint.new(tonumber(a), Color3.new(tonumber(r), tonumber(g), tonumber(b)))
        end
        if #keys < 2 then return false end
        return true, ColorSequence.new(keys)
    end
    return false
end

local function buildItem(node, refs, pending)
    local className = node.attrs and node.attrs.class
    if not className then return nil end
    local ok, inst = pcall(Instance.new, className)
    if not ok or not inst then return nil end
    if node.attrs.referent then refs[node.attrs.referent] = inst end

    local propsNode = xmlChild(node, "Properties")
    if propsNode then
        for _, p in ipairs(propsNode.children) do
            local name = p.attrs and p.attrs.name
            if name then
                name = PROP_ALIASES[name] or name
                if p.name == "Ref" then
                    pending[#pending + 1] = { inst, name, p.text }
                elseif p.name == "token" then
                    setEnum(inst, name, p.text)
                else
                    local okc, val = convertValue(p)
                    if okc then
                        pcall(function() inst[name] = val end)
                    end
                end
            end
        end
    end

    for _, c in ipairs(node.children) do
        if c.name == "Item" then
            local child = buildItem(c, refs, pending)
            if child then
                pcall(function() child.Parent = inst end)
            end
        end
    end
    return inst
end

local function parseRbxmx(text)
    local ok, root = pcall(xmlParse, text)
    if not ok then return nil, "XML rusak: " .. tostring(root) end
    local rbx
    for _, c in ipairs(root.children) do
        if c.name == "roblox" then rbx = c end
    end
    if not rbx then return nil, "bukan file rbxmx yang valid" end

    local refs, pending, out = {}, {}, {}
    for _, c in ipairs(rbx.children) do
        if c.name == "Item" then
            local inst = buildItem(c, refs, pending)
            if inst then out[#out + 1] = inst end
        end
    end
    for _, r in ipairs(pending) do
        local target = refs[r[3]]
        if target then
            pcall(function() r[1][r[2]] = target end)
        end
    end
    if #out == 0 then return nil, "tidak ada instance di dalam file" end
    return out
end

-- ===== Pohon ringan (class, name, source, children) dari file =====
-- Teks script dibaca LANGSUNG dari isi file (XML maupun biner), jadi tidak
-- bergantung pada Script.Source / decompile milik executor.

local SCRIPT_CLASSES = { Script = true, LocalScript = true, ModuleScript = true }

local function xmlToNodes(parent)
    local out = {}
    for _, c in ipairs(parent.children) do
        if c.name == "Item" then
            local node = { class = (c.attrs and c.attrs.class) or "Item" }
            node.name = node.class
            local props = xmlChild(c, "Properties")
            if props then
                for _, p in ipairs(props.children) do
                    local pn = p.attrs and p.attrs.name
                    if pn == "Name" then
                        node.name = p.text or node.name
                    elseif pn == "Source" then
                        node.source = p.text or ""
                    end
                end
            end
            node.children = xmlToNodes(c)
            out[#out + 1] = node
        end
    end
    return out
end

local function parseXmlTree(text)
    if text:sub(1, 3) == "\239\187\191" then text = text:sub(4) end -- buang BOM
    local root = xmlParse(text)
    local rbx
    for _, c in ipairs(root.children) do
        if c.name == "roblox" then rbx = c end
    end
    if not rbx then error("bukan file rbxmx yang valid") end
    return xmlToNodes(rbx)
end

-- ---- Parser rbxm biner (hanya Name + Source + hierarki) ----

local unpackFn = table.unpack or unpack

local function rdU32(s, p)
    local a, b, c, d = s:byte(p, p + 3)
    if not d then error("data rbxm terpotong") end
    return a + b * 256 + c * 65536 + d * 16777216
end

-- LZ4 block decompress (format yang dipakai chunk rbxm)
local function lz4Decompress(src, pos, len, outLen)
    local byte = string.byte
    local out, n = {}, 0
    local stop = pos + len
    if stop - 1 > #src then error("data rbxm terpotong") end
    while pos < stop do
        local token = byte(src, pos)
        pos = pos + 1
        local lit = math.floor(token / 16)
        if lit == 15 then
            local b
            repeat
                b = byte(src, pos)
                if not b then error("LZ4 rusak (literal)") end
                pos = pos + 1
                lit = lit + b
            until b ~= 255
        end
        for i = 0, lit - 1 do
            n = n + 1
            out[n] = byte(src, pos + i)
        end
        pos = pos + lit
        if pos >= stop then break end

        local off = byte(src, pos) + byte(src, pos + 1) * 256
        pos = pos + 2
        local mlen = token % 16
        if mlen == 15 then
            local b
            repeat
                b = byte(src, pos)
                if not b then error("LZ4 rusak (match)") end
                pos = pos + 1
                mlen = mlen + b
            until b ~= 255
        end
        mlen = mlen + 4
        local from = n - off
        if off == 0 or from < 0 then error("LZ4 rusak (offset)") end
        for i = 1, mlen do
            n = n + 1
            out[n] = out[from + i]
        end
    end
    if outLen and n ~= outLen then
        error(string.format("ukuran dekompresi tidak cocok (%d != %d)", n, outLen))
    end
    local parts = {}
    for i = 1, n, 2048 do
        parts[#parts + 1] = string.char(unpackFn(out, i, math.min(i + 2047, n)))
    end
    return table.concat(parts)
end

-- array int32 ter-interleave (+ zigzag, opsional delta) -> array angka, posisi berikutnya
local function rdIntArray(s, p, count, delta)
    local byte = string.byte
    local res = {}
    for i = 0, count - 1 do
        local b0 = byte(s, p + i)
        local b1 = byte(s, p + count + i)
        local b2 = byte(s, p + 2 * count + i)
        local b3 = byte(s, p + 3 * count + i)
        if not b3 then error("array referent terpotong") end
        local v = b0 * 16777216 + b1 * 65536 + b2 * 256 + b3
        if v % 2 == 0 then v = math.floor(v / 2) else v = -math.floor((v + 1) / 2) end
        res[i + 1] = v
    end
    if delta then
        local acc = 0
        for i = 1, count do
            acc = acc + res[i]
            res[i] = acc
        end
    end
    return res, p + count * 4
end

local RBXM_MAGIC = "<roblox!\137\255\13\10\26\10"

local function parseBinaryTree(data)
    if data:sub(1, 14) ~= RBXM_MAGIC then error("header rbxm tidak dikenal") end
    local pos = 33 -- 14 magic + 2 versi + 4 jumlah class + 4 jumlah instance + 8 cadangan
    local classes = {}
    local nodes = {}
    local roots = {}
    local total = #data

    while pos + 15 <= total do
        local cname = data:sub(pos, pos + 3)
        local clen = rdU32(data, pos + 4)
        local ulen = rdU32(data, pos + 8)
        pos = pos + 16

        local payload
        if clen == 0 then
            payload = data:sub(pos, pos + ulen - 1)
            if #payload ~= ulen then error("data rbxm terpotong") end
            pos = pos + ulen
        else
            if data:byte(pos) == 0x28 and data:byte(pos + 1) == 0xB5 and data:byte(pos + 2) == 0x2F then
                error("chunk rbxm terkompres zstd (belum didukung), simpan ulang sebagai .rbxmx")
            end
            payload = lz4Decompress(data, pos, clen, ulen)
            pos = pos + clen
        end

        if cname == "INST" then
            local p = 1
            local classId = rdU32(payload, p); p = p + 4
            local nameLen = rdU32(payload, p); p = p + 4
            local className = payload:sub(p, p + nameLen - 1); p = p + nameLen
            p = p + 1 -- flag service
            local count = rdU32(payload, p); p = p + 4
            local refs = rdIntArray(payload, p, count, true)
            local list = {}
            for i = 1, count do
                local node = { class = className, name = className, children = {} }
                nodes[refs[i]] = node
                list[i] = node
            end
            classes[classId] = list
        elseif cname == "PROP" then
            local p = 1
            local classId = rdU32(payload, p); p = p + 4
            local nameLen = rdU32(payload, p); p = p + 4
            local propName = payload:sub(p, p + nameLen - 1); p = p + nameLen
            local typeId = payload:byte(p); p = p + 1
            local list = classes[classId]
            if typeId == 1 and list and (propName == "Name" or propName == "Source") then
                for i = 1, #list do
                    local l = rdU32(payload, p); p = p + 4
                    local str = payload:sub(p, p + l - 1); p = p + l
                    if propName == "Name" then
                        list[i].name = str
                    else
                        list[i].source = str
                    end
                end
            end
        elseif cname == "PRNT" then
            local p = 2 -- lewati byte versi
            local count = rdU32(payload, p); p = p + 4
            local children, parents
            children, p = rdIntArray(payload, p, count, true)
            parents = rdIntArray(payload, p, count, true)
            for i = 1, count do
                local child = nodes[children[i]]
                if child then
                    local parent = nodes[parents[i]]
                    if parent then
                        parent.children[#parent.children + 1] = child
                    else
                        roots[#roots + 1] = child
                    end
                end
            end
        elseif cname == "END\0" then
            break
        end
    end
    if #roots == 0 then error("tidak ada instance di dalam file") end
    return roots
end

local function parseTree(data)
    if data:sub(1, 8) == "<roblox!" then return parseBinaryTree(data) end
    return parseXmlTree(data)
end

-- Cocokkan pohon file dengan instance hasil GetObjects / parser XML, ambil semua script
local function matchScripts(instList, nodeList, prefix, out)
    local used = {}
    for i, node in ipairs(nodeList) do
        local inst = instList[i]
        if not inst or used[inst] or inst.ClassName ~= node.class or inst.Name ~= node.name then
            inst = nil
            for _, cand in ipairs(instList) do
                if not used[cand] and cand.ClassName == node.class and cand.Name == node.name then
                    inst = cand
                    break
                end
            end
        end
        if inst then
            used[inst] = true
            local path = (prefix == "") and node.name or (prefix .. "/" .. node.name)
            if SCRIPT_CLASSES[node.class] then
                out[#out + 1] = {
                    inst = inst, class = node.class, name = node.name,
                    path = path, source = node.source or "",
                }
            end
            matchScripts(inst:GetChildren(), node.children, path, out)
        end
    end
end
-- [[PARSER END]]

-- File & import logic

local function displayName(path)
    return path:match("([^/\\]+)$") or path
end

local function ensureFolder()
    if makefolder and isfolder and not isfolder(CONFIG.Folder) then
        pcall(makefolder, CONFIG.Folder)
    end
end

local function listImportFiles()
    local out = {}
    if not listfiles then return out, "executor ini tidak punya listfiles, ketik nama file manual" end
    ensureFolder()
    local ok, files = pcall(listfiles, CONFIG.Folder)
    if not ok then return out, "gagal baca folder: " .. tostring(files) end
    for _, f in ipairs(files) do
        local low = f:lower()
        if low:sub(-5) == ".rbxm" or low:sub(-6) == ".rbxmx" then
            out[#out + 1] = f
        end
    end
    table.sort(out)
    return out
end

-- return: objs, cara, isi file (string / nil)
local function loadFile(path)
    local data
    if readfile then
        local okr, d = pcall(readfile, path)
        if okr and type(d) == "string" then data = d end
    end

    local getAsset = getcustomasset or getsynasset
    local nativeErr = "getcustomasset tidak tersedia"
    if getAsset then
        local ok, res = pcall(function()
            return game:GetObjects(getAsset(path))
        end)
        if ok and type(res) == "table" and #res > 0 then
            return res, "GetObjects", data
        end
        nativeErr = tostring(res)
    end

    if not data then return nil, "gagal baca file (readfile tidak ada / file tidak terbaca)" end
    if data:sub(1, 8) == "<roblox!" then
        return nil, "rbxm biner butuh getcustomasset (" .. nativeErr .. "). Simpan ulang sebagai .rbxmx lalu coba lagi."
    end
    local objs, err = parseRbxmx(data)
    if objs then return objs, "parser rbxmx", data end
    return nil, err
end

-- Kumpulkan teks script. Sumber utama: isi file (XML maupun biner) lewat parseTree,
-- dicocokkan ke instance hasil import. Cadangan kalau file gagal diparse:
-- best effort lewat instance (Source / gethiddenproperty / decompile).
local function gatherScripts(data, objs)
    local parseErr
    if data then
        local ok, roots = pcall(parseTree, data)
        if ok and type(roots) == "table" then
            local out = {}
            matchScripts(objs, roots, "", out)
            return out, nil
        end
        parseErr = tostring(roots)
    end

    local scripts = {}
    for _, obj in ipairs(objs) do
        local list = obj:GetDescendants()
        table.insert(list, obj)
        for _, d in ipairs(list) do
            if d:IsA("LuaSourceContainer") then
                local src, decompiled
                pcall(function() src = d.Source end)
                if (type(src) ~= "string" or src == "") and gethiddenproperty then
                    pcall(function() src = gethiddenproperty(d, "Source") end)
                end
                if (type(src) ~= "string" or src == "") and decompile then
                    pcall(function() src = decompile(d) end)
                    decompiled = true
                end
                if type(src) ~= "string" then src = "" end
                if decompiled and src ~= "" then
                    src = "-- hasil decompile, mungkin tidak persis sama dengan aslinya\n" .. src
                end
                scripts[#scripts + 1] = {
                    inst = d, class = d.ClassName, name = d.Name, path = d:GetFullName(), source = src,
                }
            end
        end
    end
    return scripts, parseErr
end

local function safeName(s)
    return (s:gsub("[^%w_%-]", "_"))
end

-- Tulis tiap script ke file .lua (cadangan kalau clipboard tidak ada)
local function exportScripts(path, scripts)
    if #scripts == 0 or not writefile then return nil end
    local base = displayName(path):gsub("%.rbxmx?$", "")
    base = safeName(base)
    local dir = CONFIG.Folder .. "/scripts_out"
    if makefolder and isfolder then
        if not isfolder(dir) then pcall(makefolder, dir) end
        dir = dir .. "/" .. base
        if not isfolder(dir) then pcall(makefolder, dir) end
    else
        dir = dir .. "_" .. base
    end
    for i, s in ipairs(scripts) do
        pcall(writefile, string.format("%s/%02d_%s.lua", dir, i, safeName(s.name)), s.source)
    end
    return dir
end

local function sanitize(obj)
    if not CONFIG.DisableScripts then return end
    local list = obj:GetDescendants()
    table.insert(list, obj)
    for _, d in ipairs(list) do
        if d:IsA("BaseScript") then
            pcall(function() d.Disabled = true end)
        end
    end
end

local function placeInFront(obj)
    local cam = workspace.CurrentCamera
    if not cam then return end
    local target = cam.CFrame.Position + cam.CFrame.LookVector * 25
    if obj:IsA("Model") then
        pcall(function() obj:PivotTo(CFrame.new(target)) end)
    elseif obj:IsA("BasePart") then
        pcall(function() obj.Position = target end)
    end
end

-- ===== Pemasang teks script untuk Studio Lite =====
-- Dari dump game: editor Studio Lite TIDAK memakai Script.Source. Teks script disimpan
-- di objek TextBox bernama SL_CodeTextBox yang jadi anak dari script, dan editor menulis
-- balik lewat ObjectValue "SaveChangesTo" (SaveChangesTo.Value.Text = teks). Script yang
-- dibuat Instance.new() tidak punya struktur itu, makanya editor kelihatan kosong.
-- Solusi: salin struktur itu dari script bawaan Studio Lite, lalu isi teksnya.

local HOLDER_BOX = "SL_CodeTextBox"
local HOLDER_PTR = "SaveChangesTo"
local MARK = "_SLI_mark"

local function setMark(inst, v)
    pcall(function() inst:SetAttribute(MARK, v) end)
end

local function hasMark(inst, v)
    local ok, cur = pcall(function() return inst:GetAttribute(MARK) end)
    return ok and (cur == v or cur == "both")
end

local function findMarked(root, v)
    if hasMark(root, v) then return root end
    for _, d in ipairs(root:GetDescendants()) do
        if hasMark(d, v) then return d end
    end
    return nil
end

local function clearMarks(root)
    setMark(root, nil)
    for _, d in ipairs(root:GetDescendants()) do setMark(d, nil) end
end

local function nativeRoots()
    local roots = {}
    for _, name in ipairs({ "ReplicatedStorage", "Workspace", "StarterGui", "StarterPack", "Lighting", "ReplicatedFirst" }) do
        local ok, svc = pcall(function() return game:GetService(name) end)
        if ok and svc then roots[#roots + 1] = svc end
    end
    return roots
end

-- script bawaan Studio Lite = LuaSourceContainer yang punya TextBox SL_CodeTextBox
local function findNativeTemplates()
    local found, seen = {}, {}
    for _, root in ipairs(nativeRoots()) do
        local ok, list = pcall(function() return root:GetDescendants() end)
        if ok then
            for _, d in ipairs(list) do
                if d.Name == HOLDER_BOX and d:IsA("TextBox") and not seen[d] then
                    local owner = d.Parent
                    while owner and not owner:IsA("LuaSourceContainer") do owner = owner.Parent end
                    if owner then
                        seen[d] = true
                        found[#found + 1] = { owner = owner, box = d }
                    end
                end
            end
        end
    end
    return found
end

local function pickTemplate(list, class)
    for _, t in ipairs(list) do
        if t.owner.ClassName == class then return t end
    end
    return list[1]
end

-- Siapkan prototipe yang akan di-clone ke tiap script hasil import
local function buildInstaller(t)
    local owner, box = t.owner, t.box
    local ptr = box:FindFirstChild(HOLDER_PTR)
    local target
    if ptr and ptr:IsA("ObjectValue") then target = ptr.Value end

    local function branchOf(inst)
        local cur = inst
        while cur and cur.Parent ~= owner do cur = cur.Parent end
        return cur
    end
    local boxBranch = branchOf(box)
    local targetBranch
    if target then
        targetBranch = target:IsDescendantOf(owner) and branchOf(target) or target
    end

    if target == box then
        setMark(box, "both")
    else
        setMark(box, "box")
        if target then setMark(target, "target") end
    end
    local protoBox = boxBranch and boxBranch:Clone()
    local protoTarget
    if targetBranch and targetBranch ~= boxBranch then protoTarget = targetBranch:Clone() end
    setMark(box, nil)
    if target then setMark(target, nil) end

    if not protoBox then return nil, "clone SL_CodeTextBox gagal (Archivable mati?)" end
    return { protoBox = protoBox, protoTarget = protoTarget }
end

local function writeText(obj, src)
    if not obj then return false end
    local ok = pcall(function()
        if obj:IsA("ValueBase") then obj.Value = src else obj.Text = src end
    end)
    if not ok then return false end
    local back
    pcall(function()
        if obj:IsA("ValueBase") then back = obj.Value else back = obj.Text end
    end)
    return back == src
end

-- return: berhasil?, keterangan
local function installOne(installer, s)
    local inst = s.inst
    if not inst then return false, "instance tidak ditemukan" end
    local src = s.source or ""
    src = src:gsub("\r\n", "\n")
    src = src:gsub("\r", "\n")
    local box, holder

    local existing = inst:FindFirstChild(HOLDER_BOX)
    if existing and existing:IsA("TextBox") then
        -- file ini sudah membawa struktur editor Studio Lite (hasil simpan dari Studio Lite)
        if src == "" then return true, "editor bawaan sudah ada, tidak diubah" end
        box = existing
        local p = existing:FindFirstChild(HOLDER_PTR)
        if p and p:IsA("ObjectValue") then holder = p.Value end
    else
        local bb = installer.protoBox:Clone()
        if not bb then return false, "clone editor gagal" end
        bb.Parent = inst
        box = findMarked(bb, "box")
        holder = findMarked(bb, "target")
        local extra
        if not holder and installer.protoTarget then
            extra = installer.protoTarget:Clone()
            if extra then
                extra.Parent = inst
                holder = findMarked(extra, "target")
            end
        end
        clearMarks(bb)
        if extra then clearMarks(extra) end
        if not box then return false, "SL_CodeTextBox tidak ketemu di hasil clone" end
        local ptr = box:FindFirstChild(HOLDER_PTR)
        if ptr and ptr:IsA("ObjectValue") and holder then
            pcall(function() ptr.Value = holder end)
        end
    end

    -- teks polos ke SEMUA penampung (kalau SL_CodeTextBox sendiri penampungnya, itu sudah cukup)
    local okBox = writeText(box, src)
    local okHolder = true
    if holder and holder ~= box then okHolder = writeText(holder, src) end
    if not okBox then return false, "gagal menulis teks ke SL_CodeTextBox (terlalu panjang?)" end
    if not okHolder then return false, "gagal menulis teks ke penampung SaveChangesTo" end
    return true, "ok"
end

-- return: { ok = n, fail = n, firstReason = str|nil, notes = { [i] = "..." } }
local function installScriptText(list)
    local stats = { ok = 0, fail = 0, notes = {} }
    if #list == 0 then return stats end

    local templates = findNativeTemplates()
    if #templates == 0 then
        stats.fail = #list
        stats.firstReason = "script bawaan Studio Lite (SL_CodeTextBox) tidak ditemukan, buka/insert satu script dulu lalu tekan Scan"
        for i = 1, #list do stats.notes[i] = stats.firstReason end
        return stats
    end

    local cache = {}
    for i, s in ipairs(list) do
        local t = pickTemplate(templates, s.class)
        local installer = cache[t]
        local ierr
        if installer == nil then
            installer, ierr = buildInstaller(t)
            cache[t] = installer or false
        elseif installer == false then
            ierr = "prototipe editor tidak bisa dibuat"
        end
        local ok, why
        if installer then
            local okc, a, b = pcall(installOne, installer, s)
            if okc then ok, why = a, b else ok, why = false, tostring(a) end
        else
            ok, why = false, ierr or "prototipe editor tidak bisa dibuat"
        end
        stats.notes[i] = why
        if ok then
            stats.ok = stats.ok + 1
        else
            stats.fail = stats.fail + 1
            stats.firstReason = stats.firstReason or why
        end
    end
    return stats
end

-- ===== Scan: catat struktur script bawaan Studio Lite (buat diagnosa) =====

local function oneLine(s, n)
    s = tostring(s):gsub("[\r\n]+", " / ")
    if #s > n then s = s:sub(1, n) .. "..." end
    return s
end

local function describe(inst)
    local info = inst.ClassName .. "  " .. inst.Name
    if inst:IsA("GuiObject") then
        info = info .. "  Visible=" .. tostring(inst.Visible)
    end
    if inst:IsA("TextBox") or inst:IsA("TextLabel") or inst:IsA("TextButton") then
        info = info .. string.format("  RichText=%s  Text(%d)=\"%s\"",
            tostring(inst.RichText), #inst.Text, oneLine(inst.Text, 70))
    elseif inst:IsA("ObjectValue") then
        info = info .. "  -> " .. (inst.Value and inst.Value:GetFullName() or "nil")
    elseif inst:IsA("StringValue") then
        info = info .. string.format("  Value(%d)=\"%s\"", #inst.Value, oneLine(inst.Value, 70))
    elseif inst:IsA("ValueBase") then
        info = info .. "  Value=" .. tostring(inst.Value)
    elseif inst:IsA("LuaSourceContainer") then
        local dis
        pcall(function() dis = inst.Disabled end)
        if dis ~= nil then info = info .. "  Disabled=" .. tostring(dis) end
    end
    local okA, attrs = pcall(function() return inst:GetAttributes() end)
    if okA and next(attrs) then
        local parts = {}
        for k, v in pairs(attrs) do parts[#parts + 1] = k .. "=" .. oneLine(v, 30) end
        table.sort(parts)
        info = info .. "  attrs{" .. table.concat(parts, ", ") .. "}"
    end
    return info
end

local function dumpTree(inst, depth, maxDepth, lines)
    for _, c in ipairs(inst:GetChildren()) do
        lines[#lines + 1] = string.rep("  ", depth) .. describe(c)
        if depth < maxDepth then dumpTree(c, depth + 1, maxDepth, lines) end
    end
end

local function scanNative()
    local templates = findNativeTemplates()
    local lines = {
        "# Scan script bawaan Studio Lite",
        "PlaceId: " .. tostring(game.PlaceId),
        "Template (SL_CodeTextBox): " .. #templates,
        "",
    }
    local seenOwner, shown = {}, 0
    for _, t in ipairs(templates) do
        if not seenOwner[t.owner] and shown < 25 then
            seenOwner[t.owner] = true
            shown = shown + 1
            lines[#lines + 1] = "== " .. t.owner:GetFullName() .. "  [" .. t.owner.ClassName .. "]"
            dumpTree(t.owner, 1, 5, lines)
            lines[#lines + 1] = ""
        end
    end

    -- script di Workspace yang TIDAK punya SL_CodeTextBox (buat lihat bentuk lain)
    local others = 0
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("LuaSourceContainer") and not d:FindFirstChild(HOLDER_BOX) and others < 10 then
            others = others + 1
            if others == 1 then lines[#lines + 1] = "== Script di Workspace tanpa SL_CodeTextBox" end
            lines[#lines + 1] = d:GetFullName() .. "  [" .. d.ClassName .. "]"
            dumpTree(d, 1, 2, lines)
        end
    end

    local report = table.concat(lines, "\n")
    local saved
    if writefile then
        ensureFolder()
        local p = CONFIG.Folder .. "/scan_studio_lite.txt"
        if pcall(writefile, p, report) then saved = p end
    end
    local clip = setclipboard or toclipboard
    local copied = clip and pcall(clip, report)

    local msg = string.format("Scan: %d template ditemukan.", #templates)
    if saved then msg = msg .. " Disimpan: " .. saved .. "." end
    if copied then msg = msg .. " Hasil juga disalin ke clipboard." end
    return msg
end

-- Catat hasil import per script (buat cek kalau ada yang gagal)
local function writeImportLog(path, scripts, stats, parseErr)
    if not writefile then return nil end
    local lines = { "# Import log: " .. displayName(path), "script: " .. #scripts }
    if parseErr then lines[#lines + 1] = "peringatan baca file: " .. parseErr end
    for i, s in ipairs(scripts) do
        lines[#lines + 1] = string.format("[%d] %s (%s) %d byte -> %s",
            i, s.path, s.class, #s.source, tostring(stats.notes[i] or "teks tidak dipasang"))
    end
    local p = CONFIG.Folder .. "/import_log.txt"
    if pcall(writefile, p, table.concat(lines, "\n")) then return p end
    return nil
end

local TARGETS = { "Workspace", "ReplicatedStorage", "StarterGui", "StarterPack", "Lighting" }
local targetIndex = 1
local lastImported = {}
local scriptList = {}
local scriptIdx = 0

local function doImport(path)
    local objs, how, data = loadFile(path)
    if not objs then return false, how end

    local parseErr
    scriptList, parseErr = gatherScripts(data, objs)
    scriptIdx = 0
    local outDir = exportScripts(path, scriptList)

    -- pasang teks script SEBELUM objek dimasukkan ke game (struktur editor Studio Lite)
    local stats = { ok = 0, fail = 0, notes = {} }
    if CONFIG.InstallScriptText and #scriptList > 0 then
        local oki, res = pcall(installScriptText, scriptList)
        if oki then
            stats = res
        else
            stats.fail = #scriptList
            stats.firstReason = tostring(res)
        end
    end

    local target = game:GetService(TARGETS[targetIndex])
    local added = {}
    for _, obj in ipairs(objs) do
        sanitize(obj)
        if target == workspace and CONFIG.SpawnInFrontOfCamera then
            placeInFront(obj)
        end
        local ok = pcall(function() obj.Parent = target end)
        if ok then added[#added + 1] = obj end
    end
    lastImported = added

    local logPath = writeImportLog(path, scriptList, stats, parseErr)

    local msg = string.format("Berhasil: %d objek dari %s -> %s (via %s).",
        #added, displayName(path), TARGETS[targetIndex], how)
    if #scriptList > 0 then
        if CONFIG.InstallScriptText then
            msg = msg .. string.format(" Teks script terpasang: %d/%d.", stats.ok, #scriptList)
            if stats.fail > 0 then
                msg = msg .. " Gagal: " .. tostring(stats.firstReason) .. "."
            end
        else
            msg = msg .. string.format(" %d script (teks tidak dipasang, pakai tombol Salin).", #scriptList)
        end
        if parseErr then msg = msg .. " Peringatan baca file: " .. parseErr:sub(1, 80) .. "." end
        if stats.fail > 0 or parseErr then
            if logPath then msg = msg .. " Log: " .. logPath end
        end
        if outDir and stats.fail > 0 then msg = msg .. " Cadangan .lua: " .. outDir end
    end
    return true, msg
end

