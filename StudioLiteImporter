-- ###################################################################
-- PANEL PROPERTIES (kategori, editor per tipe, Attributes, Tags)
-- ###################################################################
local PR = { rows = {}, targets = {}, rowH = 24, filter = "" }

local CAT_PRIO = { Appearance = 1, Data = 2, Transform = 3, Part = 4, Pivot = 5, Behavior = 6, Collision = 7, Assembly = 8, Surface = 9,
    Image = 10, Text = 11, Layout = 12, Scrolling = 13, Control = 14 }

local function lowerCmp(a, b) return a:lower() < b:lower() end

local function guardWritable(inst, name)
    if name == "Parent" and isProtected(inst) then return false end
    if name == "Name" and inst.Parent == game then return false end
    return true
end

-- tulis properti / attribute ke semua target (dengan Undo)
function PR.write(p, fn, label)
    local rec = {}
    for _, inst in ipairs(PR.targets) do
        if guardWritable(inst, p.name) then
            local okr, old = pcall(function()
                if p.attr then return inst:GetAttribute(p.name) end
                return inst[p.name]
            end)
            if okr then
                local okn, nv = pcall(fn, old, inst)
                if okn and nv ~= nil then
                    local okw = pcall(function()
                        if p.attr then inst:SetAttribute(p.name, nv) else inst[p.name] = nv end
                    end)
                    if okw then rec[#rec + 1] = { inst, old, nv } end
                end
            end
        end
    end
    if #rec == 0 then
        PR.refresh()
        return false
    end
    local function applyAll(idx)
        for _, r in ipairs(rec) do
            pcall(function()
                if p.attr then r[1]:SetAttribute(p.name, r[idx]) else r[1][p.name] = r[idx] end
            end)
        end
        PR.refresh()
    end
    HIST.push(label or ("Set " .. p.name), function() applyAll(2) end, function() applyAll(3) end)
    PR.refresh()
    return true
end

-- baca nilai (nilai bersama, atau mixed)
function PR.read(p, getter)
    local first, mixed, any
    local n = math.min(#PR.targets, 60)
    for i = 1, n do
        local t = PR.targets[i]
        local ok, v = pcall(function()
            local x
            if p.attr then x = t:GetAttribute(p.name) else x = t[p.name] end
            if getter then return getter(x) end
            return x
        end)
        if ok then
            if not any then
                first, any = v, true
            elseif not VT.equal(first, v) then
                mixed = true
                break
            end
        end
    end
    return first, mixed, any
end

function PR.rebuild()
    local targets = {}
    for _, i in ipairs(SEL.list) do
        if typeof(i) == "Instance" then targets[#targets + 1] = i end
    end
    PR.targets = targets
    local rows = {}
    if #targets == 0 then
        PR.rows = rows
        PR.empty.Visible = true
        PR.title.Text = "Properties"
        PR.L.setCount(0)
        return
    end
    PR.empty.Visible = false
    local cn = targets[1].ClassName
    local allSame = true
    for _, t in ipairs(targets) do
        if t.ClassName ~= cn then allSame = false break end
    end
    if #targets == 1 then
        PR.title.Text = "Properties - " .. cn .. ' "' .. targets[1].Name .. '"'
    else
        PR.title.Text = "Properties - " .. #targets .. " items" .. (allSame and (" (" .. cn .. ")") or "")
    end

    local common = {}
    for _, p in ipairs(DB.props(cn)) do common[#common + 1] = p end
    if #targets > 1 and not allSame then
        local classes = {}
        for _, t in ipairs(targets) do classes[t.ClassName] = true end
        for c in pairs(classes) do
            if c ~= cn then
                local map = {}
                for _, p in ipairs(DB.props(c)) do map[p.name] = p.type end
                local keep = {}
                for _, p in ipairs(common) do
                    if map[p.name] == p.type then keep[#keep + 1] = p end
                end
                common = keep
            end
        end
    end

    local q = PR.filter:lower()
    local cats = {}
    for _, p in ipairs(common) do
        if q == "" or p.name:lower():find(q, 1, true) then
            local l = cats[p.cat]
            if not l then
                l = {}
                cats[p.cat] = l
            end
            l[#l + 1] = p
        end
    end
    local names = {}
    for c in pairs(cats) do names[#names + 1] = c end
    table.sort(names, function(a, b)
        local pa, pb = CAT_PRIO[a] or 100, CAT_PRIO[b] or 100
        if pa ~= pb then return pa < pb end
        return a < b
    end)

    local function addProp(p, depth)
        rows[#rows + 1] = { k = "prop", p = p, depth = depth or 0 }
        local ty = p.type
        local kind = VT.kind(ty)
        local comps = (kind == "cframe") and VT.cframeParts() or VT.comps(ty)
        if comps and ST.propExpanded[p.name] then
            for _, c in ipairs(comps) do
                rows[#rows + 1] = { k = "comp", p = p, comp = c, depth = 1, cframe = (kind == "cframe") }
            end
        end
    end

    for _, c in ipairs(names) do
        local list = cats[c]
        table.sort(list, function(a, b) return lowerCmp(a.name, b.name) end)
        local collapsed = ST.propCollapsed[c] and q == ""
        rows[#rows + 1] = { k = "cat", name = c, collapsed = collapsed, n = #list }
        if not collapsed then
            for _, p in ipairs(list) do addProp(p, 0) end
        end
    end

    if #targets == 1 then
        local t = targets[1]
        local attrs = {}
        local okA, all = pcall(function() return t:GetAttributes() end)
        if okA then
            for name, v in pairs(all) do
                if not name:find("^SL_") and (q == "" or name:lower():find(q, 1, true)) then attrs[#attrs + 1] = { name = name, v = v } end
            end
        end
        table.sort(attrs, function(a, b) return lowerCmp(a.name, b.name) end)
        local coll = ST.propCollapsed.Attributes and q == ""
        rows[#rows + 1] = { k = "cat", name = "Attributes", collapsed = coll, n = #attrs }
        if not coll then
            for _, a in ipairs(attrs) do
                rows[#rows + 1] = { k = "prop", depth = 0, p = { name = a.name, type = typeOfValue(a.v), cat = "Attributes", attr = true, ro = false } }
            end
            rows[#rows + 1] = { k = "add", what = "attr" }
        end
        local tags = {}
        local okT, tl = pcall(function() return CollectionService:GetTags(t) end)
        if okT then tags = tl end
        table.sort(tags, lowerCmp)
        local coll2 = ST.propCollapsed.Tags and q == ""
        rows[#rows + 1] = { k = "cat", name = "Tags", collapsed = coll2, n = #tags }
        if not coll2 then
            for _, tg in ipairs(tags) do rows[#rows + 1] = { k = "tag", name = tg } end
            rows[#rows + 1] = { k = "add", what = "tag" }
        end
    end
    PR.rows = rows
    PR.L.setCount(#rows)
end

function PR.refresh()
    if PR.L then PR.L.refresh(true) end
end

local function typeClass(ty)
    return ty:sub(3)
end

-- aksi klik pada sel nilai (enum, warna, instance, font, ...)
local function cellAction(r)
    local d = r.d
    if not d or not d.p then return end
    local p = d.p
    local ty = d.cframe and "Vector3" or p.type
    local kind = VT.kind(ty)
    if p.ro then return end
    local cur, mixed = PR.read(p)
    if kind == "bool" then
        PR.write(p, function(old) return not (cur == true and not mixed) end)
    elseif kind == "enum" then
        local items = VT.enumItems(ty)
        local menu, at = {}, nil
        for i, it in ipairs(items) do
            local isCur = (not mixed) and cur == it
            if isCur then at = i end
            menu[#menu + 1] = { text = it.Name, checked = isCur, fn = function() PR.write(p, function() return it end) end }
        end
        UI.dropdown(r.valHolder, menu, { scrollTo = at, maxH = 320 })
    elseif kind == "color3" then
        local before = {}
        for _, t in ipairs(PR.targets) do
            local ok, v = pcall(function() if p.attr then return t:GetAttribute(p.name) end return t[p.name] end)
            if ok then before[#before + 1] = { t, v } end
        end
        UI.colorPicker(typeof(cur) == "Color3" and cur or rgb(255, 255, 255), function(c, final)
            for _, b in ipairs(before) do
                pcall(function() if p.attr then b[1]:SetAttribute(p.name, c) else b[1][p.name] = c end end)
            end
            if final then
                local changed = false
                for _, b in ipairs(before) do
                    if not VT.equal(b[2], c) then changed = true break end
                end
                if changed then
                    HIST.push("Set " .. p.name, function()
                        for _, b in ipairs(before) do pcall(function() if p.attr then b[1]:SetAttribute(p.name, b[2]) else b[1][p.name] = b[2] end end) end
                        PR.refresh()
                    end, function()
                        for _, b in ipairs(before) do pcall(function() if p.attr then b[1]:SetAttribute(p.name, c) else b[1][p.name] = c end end) end
                        PR.refresh()
                    end)
                end
            end
            PR.refresh()
        end, p.name)
    elseif kind == "brick" then
        UI.brickPicker(typeof(cur) == "BrickColor" and cur or nil, function(bcv) PR.write(p, function() return bcv end) end)
    elseif kind == "font" then
        local menu = {}
        for _, it in ipairs(Enum.Font:GetEnumItems()) do
            if it ~= Enum.Font.Unknown then
                menu[#menu + 1] = { text = it.Name, fn = function()
                    PR.write(p, function(old)
                        local ok, f = pcall(Font.fromEnum, it)
                        return ok and f or nil
                    end)
                end }
            end
        end
        UI.dropdown(r.valHolder, menu, { maxH = 320 })
    elseif kind == "inst" then
        local want = typeClass(ty)
        local menu = {}
        if typeof(cur) == "Instance" and not mixed then
            menu[#menu + 1] = { text = 'Select "' .. cur.Name .. '"', fn = function() setSel({ cur }) end }
        end
        local pick
        for _, s in ipairs(SEL.list) do
            local isTarget = table.find(PR.targets, s)
            if not isTarget and s:IsA(want) then pick = s break end
        end
        menu[#menu + 1] = { text = pick and ('Set to "' .. pick.Name .. '" (selected)') or "Set to selected object", disabled = pick == nil,
            fn = function() PR.write(p, function() return pick end) end }
        menu[#menu + 1] = { text = "Clear (nil)", disabled = p.name == "Parent", fn = function() PR.write(p, function() return nil end) end }
        UI.dropdown(r.valHolder, menu, { minW = 220 })
    end
end

local function commitText(r)
    local d = r.d
    if not d or not d.p then return end
    local p = d.p
    local text = r.tb.Text
    if d.k == "comp" then
        local nv
        if d.cframe then
            nv = VT.parse(text, "Vector3")
            if not nv then PR.refresh() return end
            PR.write(p, function(old) return d.comp.set(old, nv) end)
        else
            nv = tonumber(text) or nums(text)[1]
            if not nv then PR.refresh() return end
            if d.comp.int then nv = math.floor(nv + 0.5) end
            PR.write(p, function(old) return d.comp.set(old, nv) end)
        end
        return
    end
    local cur = PR.read(p)
    local nv = VT.parse(text, p.type, cur)
    if nv == nil then
        PR.refresh()
        return
    end
    if cur ~= nil and VT.equal(cur, nv) then
        PR.refresh()
        return
    end
    PR.write(p, function() return nv end)
end

function PR.addAttribute()
    local t = PR.targets[1]
    if not t then return end
    UI.prompt("Add Attribute", "Attribute name", "", function(name)
        name = name:gsub("^%s+", ""):gsub("%s+$", "")
        if name == "" or name:find("^RBX") or not name:match("^[%w_ ]+$") then
            notify("Nama attribute tidak valid (huruf / angka / _ saja).", "warn")
            return
        end
        local sz = UI.size()
        local types = {
            { "string", "" }, { "boolean", false }, { "number", 0 }, { "Color3", rgb(255, 255, 255) },
            { "Vector3", Vector3.new() }, { "UDim2", UDim2.new() },
        }
        local menu = {}
        for _, ty in ipairs(types) do
            menu[#menu + 1] = { text = ty[1], fn = function()
                pcall(function() t:SetAttribute(name, ty[2]) end)
                HIST.push("Add Attribute", function() pcall(function() t:SetAttribute(name, nil) end) PR.rebuild() end,
                    function() pcall(function() t:SetAttribute(name, ty[2]) end) PR.rebuild() end)
                PR.rebuild()
            end }
        end
        UI.menu(menu, sz.X / 2 * UI.sc - 90, sz.Y / 2 * UI.sc - 100, { minW = 180 })
    end)
end

function PR.addTag()
    local t = PR.targets[1]
    if not t then return end
    UI.prompt("Add Tag", "Tag name", "", function(name)
        if name == "" then return end
        pcall(function() CollectionService:AddTag(t, name) end)
        HIST.push("Add Tag", function() pcall(function() CollectionService:RemoveTag(t, name) end) PR.rebuild() end,
            function() pcall(function() CollectionService:AddTag(t, name) end) PR.rebuild() end)
        PR.rebuild()
    end)
end

