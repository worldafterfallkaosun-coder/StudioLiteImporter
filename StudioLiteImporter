-- buat host decal: part papan (anchored) yang menghadap kamera. return part
local function makeBoardPart(base, texture, w, h, target, placeState)
    local longest = 8
    local sx, sy
    if w >= h then
        sx, sy = longest, math.max(0.5, longest * h / w)
    else
        sy, sx = longest, math.max(0.5, longest * w / h)
    end
    local part = Instance.new("Part")
    part.Name = base
    part.Anchored = true
    part.Size = Vector3.new(sx, sy, 0.2)
    local d = Instance.new("Decal")
    d.Name = base
    d.Texture = texture
    d.Face = Enum.NormalId.Front
    d.Parent = part
    local cam = workspace.CurrentCamera
    if cam and isWorld(target) and CONFIG.SpawnInFrontOfCamera then
        placeState = placeState or { offset = 0 }
        local c = cam.CFrame
        local pos = c.Position + c.LookVector * 25 + c.RightVector * (placeState.offset + sx / 2)
        placeState.offset = placeState.offset + sx + 4
        part.CFrame = CFrame.lookAt(pos, c.Position)
    end
    part.Parent = target
    return part
end

-- terapkan texture ke host: BasePart terpilih (Studio Lite) / target part / papan baru.
-- return: added (list), keterangan
local function applyTexture(base, texture, w, h, target, placeState)
    local added = {}
    local parts = {}
    local okS, sel = pcall(SEL.read)
    if okS and type(sel) == "table" then
        for _, i in ipairs(sel) do
            if i:IsA("BasePart") and not isProtected(i) then parts[#parts + 1] = i end
        end
    end
    if #parts == 0 and target:IsA("BasePart") and not isProtected(target) then parts = { target } end

    if #parts > 0 then
        for _, p in ipairs(parts) do
            for _, f in ipairs(faceList(CONFIG.DecalFace)) do
                local d = Instance.new("Decal")
                d.Name = base
                d.Texture = texture
                d.Face = Enum.NormalId[f]
                d.Parent = p
                added[#added + 1] = d
            end
        end
        return added, string.format("decal di %d part (sisi %s)", #parts, CONFIG.DecalFace)
    end
    local part = makeBoardPart(base, texture, w, h, target, placeState)
    added[1] = part
    return added, "papan decal baru"
end

local function importImageFile(entry, target, placeState)
    local asset, err = localAsset(entry)
    if not asset then return false, err end
    local w, h
    if readfile then
        local okr, d = pcall(readfile, entry.raw)
        if okr and type(d) == "string" then w, h = imageSize(d) end
    end
    w, h = w or 256, h or 256

    local guiTarget = target:IsA("GuiObject") or target:IsA("LayerCollector")
    if CONFIG.ImageMode == "gui" or guiTarget then
        local added = {}
        local host = target
        if not guiTarget then
            local sg = Instance.new("ScreenGui")
            sg.Name = entry.base
            sg.ResetOnSpawn = false
            sg.Parent = target
            added[#added + 1] = sg
            host = sg
        end
        local lab = Instance.new("ImageLabel")
        lab.Name = entry.base
        lab.BackgroundTransparency = 1
        lab.Image = asset
        local k = math.min(1, 300 / math.max(w, h))
        lab.Size = UDim2.fromOffset(math.max(8, math.floor(w * k)), math.max(8, math.floor(h * k)))
        lab.Parent = host
        if host == target then added[#added + 1] = lab end
        return true, withNote(string.format("%s -> %s: ImageLabel %dx%d", entry.name, X.pathOf(target), w, h)),
            added, {}, EMPTY_STATS()
    end

    local added, how = applyTexture(entry.base, asset, w, h, target, placeState)
    return true, withNote(string.format("%s -> %s: %s (%dx%d)", entry.name, X.pathOf(target), how, w, h)),
        added, {}, EMPTY_STATS()
end

-- ---- Audio lokal -> Sound ----
local function makeSound(name, soundId, parent)
    local s = Instance.new("Sound")
    s.Name = name
    s.SoundId = soundId
    s.Volume = 0.5
    s.Parent = parent
    return s
end

local function importAudioFile(entry, target)
    local asset, err = localAsset(entry)
    if not asset then return false, err end
    local s = makeSound(entry.base, asset, target)
    return true, withNote(string.format("%s -> %s: Sound", entry.name, X.pathOf(target))), { s }, {}, EMPTY_STATS()
end

-- ---- Dispatcher ----
-- entry: tabel entri scanner { raw, name, base, kind, ... } -> ok, pesan, added, scripts, stats
local function doImport(entry, opts, placeState)
    local target = opts.target
    if typeof(target) ~= "Instance" or not target:IsDescendantOf(game) then
        return false, "target import tidak ditemukan (dihapus?), pilih ulang di tab Explorer"
    end
    local kind = entry.kind or "model"
    if kind == "place" then return importPlaceFile(entry, target, placeState) end
    if kind == "image" then return importImageFile(entry, target, placeState) end
    if kind == "audio" then return importAudioFile(entry, target) end
    return importModelFile(entry, target, placeState)
end

-- ---- Batch import ----
function E.runBatch(list)
    if S.busy then notify("Masih ada proses berjalan.", "warn") return end
    if #list == 0 then notify("Belum ada file dipilih.", "warn") return end
    local tinst = E.getTarget()
    if not tinst then
        notify("Target import tidak ditemukan: " .. S.target .. ". Pilih ulang di tab Explorer.", "err")
        return
    end
    local tlabel = X.pathOf(tinst)
    X.pushRecent(tinst)
    S.busy, S.cancel = true, false
    fire("busy", true)

    local function body()
        local total = #list
        local batch = { objs = {}, target = tlabel, count = total }
        local okN, failN, objN, scriptN = 0, 0, 0, 0
        local placeState = { offset = 0 }
        local allScripts = {}
        local report = {
            "# Import log " .. os.date("%Y-%m-%d %H:%M:%S"),
            "target: " .. tlabel, "file: " .. total, "",
        }
        logLine(string.format("Batch dimulai: %d file -> %s", total, tlabel), "info")

        for i, e in ipairs(list) do
            if S.cancel or not alive() then
                logLine(string.format("Dibatalkan sebelum file %d/%d", i, total), "warn")
                break
            end
            S.status[e.path] = "busy"
            fire("progress", (i - 1) / total, string.format("Import %d/%d: %s", i, total, e.name))
            fire("rows")
            task.wait()

            local okc, ok, msg, added, scripts, stats = pcall(doImport, e,
                { target = E.getTarget() or tinst }, placeState)
            if not okc then
                msg = tostring(ok)
                ok = false
            end

            if ok then
                S.status[e.path], S.reason[e.path] = "ok", nil
                S.selected[e.path] = nil
                okN = okN + 1
                for _, o in ipairs(added) do batch.objs[#batch.objs + 1] = o end
                objN = objN + #added
                scriptN = scriptN + #scripts
                for _, s in ipairs(scripts) do
                    s.file = e.name
                    allScripts[#allScripts + 1] = s
                end
                logLine(msg, "ok")
                report[#report + 1] = "[OK] " .. msg
                for j, s in ipairs(scripts) do
                    report[#report + 1] = string.format("    (%d) %s [%s] %d byte -> %s",
                        j, s.path, s.class, #s.source, tostring(stats.notes[j] or "teks tidak dipasang"))
                end
            else
                S.status[e.path], S.reason[e.path] = "fail", tostring(msg)
                failN = failN + 1
                logLine(e.name .. ": " .. tostring(msg), "err")
                report[#report + 1] = "[GAGAL] " .. e.name .. ": " .. tostring(msg)
            end
            fire("progress", i / total, string.format("Selesai %d/%d", i, total))
            fire("selection")
            fire("rows")
            task.wait()
        end

        if #batch.objs > 0 then
            S.history[#S.history + 1] = batch
            if #S.history > 20 then table.remove(S.history, 1) end
        end
        if #allScripts > 0 then
            S.scriptList, S.scriptIdx = allScripts, 0
        end
        if writefile then
            ensureFolder()
            pcall(writefile, CONFIG.Folder .. "/import_log.txt", table.concat(report, "\n"))
        end

        local summary = string.format("Batch selesai: %d berhasil, %d gagal | %d objek, %d script",
            okN, failN, objN, scriptN)
        if S.cancel then summary = "Batch dibatalkan. " .. summary end
        notify(summary, failN > 0 and (okN > 0 and "warn" or "err") or "ok")
        if okN > 0 and CONFIG.AutoHideAfterImport then fire("autohide") end
    end

    task.spawn(function()
        local ok, err = pcall(body)
        if not ok then notify("Error batch: " .. tostring(err), "err") end
        S.busy, S.cancel = false, false
        fire("busy", false)
        fire("progress", 0, "")
        fire("history")
        fire("selection")
        fire("rows")
    end)
end

function E.cancel()
    if S.busy then
        S.cancel = true
        setStatus("Membatalkan setelah file ini selesai...", "warn")
    end
end

-- ---- Undo ----
function E.undo(all)
    if S.busy then return end
    local n, batches = 0, 0
    while #S.history > 0 do
        local b = table.remove(S.history)
        for _, o in ipairs(b.objs) do
            if o and o.Parent then
                pcall(function() o:Destroy() end)
                n = n + 1
            end
        end
        batches = batches + 1
        if not all then break end
    end
    if batches == 0 then
        notify("Tidak ada batch yang bisa di-undo.", "warn")
    else
        notify(string.format("Undo %d batch: %d objek dihapus.", batches, n), "info")
    end
    fire("history")
end

-- ---- Salin script (clipboard) ----
function E.copyNextScript()
    local n = #S.scriptList
    if n == 0 then notify("Belum ada script dari import terakhir.", "warn") return end
    S.scriptIdx = S.scriptIdx % n + 1
    local s = S.scriptList[S.scriptIdx]
    local clip = setclipboard or toclipboard
    if s.source == "" then
        notify(string.format("Source %s kosong / tidak terbaca (%d/%d).", s.path, S.scriptIdx, n), "err")
    elseif not clip then
        notify("Executor tidak punya setclipboard. Ambil dari folder scripts_out.", "err")
    elseif pcall(clip, s.source) then
        notify(string.format("Disalin: %s [%s] (%d/%d)", s.path, s.class, S.scriptIdx, n), "ok")
    else
        notify("Gagal menyalin ke clipboard.", "err")
    end
end

function E.scanStudioLite()
    local ok, res = pcall(scanNative)
    notify(ok and res or ("Scan error: " .. tostring(res)), ok and "info" or "err")
end

-- ---- Tambah file manual (executor tanpa listfiles / path di luar scan) ----
function E.addManual(text)
    text = (text or ""):match("^%s*(.-)%s*$")
    if text == "" or not isfile then return false end
    local candidates = {
        text, CONFIG.Folder .. "/" .. text,
        CONFIG.Folder .. "/" .. text .. ".rbxmx", CONFIG.Folder .. "/" .. text .. ".rbxm",
    }
    for _, c in ipairs(candidates) do
        local okf, exists = pcall(isfile, c)
        if okf and exists then
            local entry = makeEntry(c)
            if entry then
                local dup = false
                for _, e in ipairs(S.entries) do if e.path == entry.path then dup = true break end end
                if not dup then
                    S.entries[#S.entries + 1] = entry
                    sortList(S.entries, "name")
                    S.known[entry.path] = true
                end
                S.selected[entry.path] = true
                E.applyView()
                fire("selection")
                notify("Ditambahkan manual: " .. entry.name, "ok")
                return true
            end
        end
    end
    return false
end

-- ===================================================================
-- EXPLORER LIVE (pohon instance Studio Lite -> pilihan "Import to")
-- ===================================================================
-- Explorer Studio Lite menampilkan isi game di sisi client, jadi sumbernya diambil
-- langsung dari DataModel (Workspace, ReplicatedStorage, StarterGui, dst.) lalu diikuti
-- perubahannya secara live. Hasilnya tampil di tab Explorer sebagai pohon yang bisa
-- dibuka-tutup, dicari, dipin, dan dipilih sebagai target import.

local function inGame(inst)
    return typeof(inst) == "Instance" and inst:IsDescendantOf(game)
end

local function kidsOf(inst)
    local ok, list = pcall(inst.GetChildren, inst)
    if ok and type(list) == "table" then return list end
    return {}
end

-- "Workspace/Map/Props". unique=true menambah #n untuk nama kembar (dipakai untuk simpan).
function X.pathOf(inst, unique)
    local parts, cur, guard = {}, inst, 0
    while cur and cur ~= game and guard < 100 do
        local seg = cur.Name
        if unique and cur.Parent then
            local same, idx = 0, 0
            for _, c in ipairs(kidsOf(cur.Parent)) do
                if c.Name == cur.Name then
                    same = same + 1
                    if c == cur then idx = same end
                end
            end
            if same > 1 then seg = seg .. "#" .. idx end
        end
        table.insert(parts, 1, seg)
        cur = cur.Parent
        guard = guard + 1
    end
    return table.concat(parts, "/")
end

local function pickChild(parent, seg)
    local name, idx = seg:match("^(.-)#(%d+)$")
    if name then
        local n = 0
        for _, c in ipairs(kidsOf(parent)) do
            if c.Name == name then
                n = n + 1
                if n == tonumber(idx) then return c end
            end
        end
    end
    return parent:FindFirstChild(seg)
end

function X.resolve(path)
    if type(path) ~= "string" or path == "" then return nil end
    local cur = game
    for seg in path:gmatch("[^/]+") do
        cur = pickChild(cur, seg)
        if not cur then return nil end
    end
    if cur == game then return nil end
    return cur
end

-- resolve dengan cache (objek yang hilang dicoba lagi paling cepat tiap 3 detik)
function X.lookup(path)
    local c = X.pathCache[path]
    if c and c.inst and inGame(c.inst) then return c.inst end
    local now = os.clock()
    if c and not c.inst and now - c.t < 3 then return nil end
    local inst = X.resolve(path)
    X.pathCache[path] = { inst = inst, t = now }
    return inst
end

function X.kidCount(inst)
    local c = X.kidCache[inst]
    local now = os.clock()
    if c and now - c[2] < 1.5 then return c[1] end
    local n = #kidsOf(inst)
    X.kidCache[inst] = { n, now }
    return n
end

local function sortedKids(inst)
    local list = kidsOf(inst)
    X.kidCache[inst] = { #list, os.clock() }
    if #list <= 2000 then
        local keyed = table.create(#list)
        for i, c in ipairs(list) do keyed[i] = { c, c.Name:lower() } end
        table.sort(keyed, function(a, b)
            if a[2] ~= b[2] then return a[2] < b[2] end
            return a[1].ClassName < b[1].ClassName
        end)
        for i, k in ipairs(keyed) do list[i] = k[1] end
    end
    return list
end

function X.roots()
    local out, seen = {}, {}
    local function add(svc)
        if svc and not seen[svc] then
            seen[svc] = true
            out[#out + 1] = svc
        end
    end
    for _, n in ipairs(ROOT_ORDER) do
        local ok, svc = pcall(function() return game:FindService(n) end)
        if ok then add(svc) end
    end
    if CONFIG.ExplorerAllServices then
        for _, c in ipairs(kidsOf(game)) do
            if not ROOT_HIDE[c.ClassName] then add(c) end
        end
    end
    return out
end

-- ---- target import ----
function E.getTarget()
    local t = S.targetInst
    if t and inGame(t) then return t end
    local r = X.lookup(S.target)
    S.targetInst = r
    return r
end

function E.setTarget(inst)
    if S.busy then
        notify("Tunggu batch selesai dulu sebelum ganti target.", "warn")
        return false
    end
    if not inGame(inst) then
        notify("Target tidak valid (objek sudah dihapus).", "warn")
        return false
    end
    S.targetInst = inst
    S.target = X.pathOf(inst, true)
    X.pathCache[S.target] = { inst = inst, t = os.clock() }
    X.lastTargetOk = true
    E.saveSettings()
    fire("target")
    setStatus("Target import: " .. X.pathOf(inst), "ok")
    return true
end

function X.pushRecent(inst)
    local p = X.pathOf(inst, true)
    local i = table.find(X.recent, p)
    if i then table.remove(X.recent, i) end
    table.insert(X.recent, 1, p)
    while #X.recent > 6 do table.remove(X.recent) end
    X.pathCache[p] = { inst = inst, t = os.clock() }
    X.dirty = true
    E.saveSettings()
end

function X.togglePin(p, inst)
    local i = table.find(X.pins, p)
    if i then
        table.remove(X.pins, i)
    else
        if #X.pins >= 12 then
            notify("Favorit penuh (maks 12). Lepas salah satu dulu.", "warn")
            return
        end
        X.pins[#X.pins + 1] = p
    end
    if inst then X.pathCache[p] = { inst = inst, t = os.clock() } end
    E.saveSettings()
    X.refresh(true)
end

-- buka semua induk objek supaya kelihatan di pohon
function X.reveal(inst)
    if not inGame(inst) then return end
    local p, guard = inst.Parent, 0
    while p and p ~= game and guard < 100 do
        X.expanded[p] = true
        p = p.Parent
        guard = guard + 1
    end
end

function X.toggle(inst)
    if X.expanded[inst] then X.expanded[inst] = nil else X.expanded[inst] = true end
    X.refresh(true)
end

function X.collapseAll()
    X.expanded = setmetatable({}, { __mode = "k" })
    X.refresh(true)
end

-- ---- bangun daftar baris (mode pohon / mode hasil pencarian) ----
function X.build()
    local rows = {}
    local function head(text) rows[#rows + 1] = { kind = "head", text = text } end

    X.pinSet = setmetatable({}, { __mode = "k" })
    for _, p in ipairs(X.pins) do
        local inst = X.lookup(p)
        if inst then X.pinSet[inst] = p end
    end

    if X.query ~= "" then
        if X.searching then
            head("MENCARI '" .. X.query .. "' ...")
        else
            local txt = "HASIL: " .. #X.results
            if X.searchTrunc then txt = txt .. " (dibatasi, persempit kata kunci)" end
            if #X.results == 0 then txt = txt .. " - coba kata lain" end
            head(txt)
            for _, r in ipairs(X.results) do
                if inGame(r.inst) then rows[#rows + 1] = r end
            end
        end
        return rows
    end

    if #X.pins > 0 then
        head("FAVORIT")
        for _, p in ipairs(X.pins) do
            rows[#rows + 1] = { kind = "path", path = p, inst = X.lookup(p), pinned = true }
        end
    end
    if #X.recent > 0 then
        head("TERAKHIR DIPAKAI")
        for _, p in ipairs(X.recent) do
            rows[#rows + 1] = { kind = "path", path = p, inst = X.lookup(p) }
        end
    end
    head("EXPLORER (LIVE)")

    local function walk(inst, depth)
        rows[#rows + 1] = { kind = "node", inst = inst, depth = depth }
        if X.expanded[inst] then
            local kids = sortedKids(inst)
            local cap = CONFIG.ExplorerMaxChildren
            for i, c in ipairs(kids) do
                if i > cap then
                    rows[#rows + 1] = { kind = "more", depth = depth + 1, n = #kids - cap }
                    break
                end
                walk(c, depth + 1)
            end
        end
    end
    for _, r in ipairs(X.roots()) do walk(r, 0) end
    return rows
end

local function sameRows(a, b)
    if #a ~= #b then return false end
    for i = 1, #a do
        local x, y = a[i], b[i]
        if x.kind ~= y.kind or x.inst ~= y.inst or x.depth ~= y.depth or x.path ~= y.path
            or x.text ~= y.text or x.n ~= y.n or x.pinned ~= y.pinned then
            return false
        end
    end
    return true
end

function X.refresh(force)
    if not alive() then return end
    X.dirty = false
    local rows = X.build()
    if force or not sameRows(rows, X.rows) then
        X.rows = rows
        X.stamp = os.date("%H:%M:%S")
        fire("explorerView")
    else
        fire("explorerPaint")
    end
    local ok = E.getTarget() ~= nil
    if ok ~= X.lastTargetOk then
        X.lastTargetOk = ok
        fire("target")
    end
end

-- ---- pencarian (async, tidak membekukan game) ----
function X.search(q, silent)
    local terms = {}
    for w in (q or ""):lower():gmatch("%S+") do terms[#terms + 1] = w end
    if silent and X.searchBusy then return end
    X.searchToken = X.searchToken + 1
    local token = X.searchToken
    if #terms == 0 then
        X.results, X.searching, X.searchBusy, X.searchTrunc = {}, false, false, false
        X.dirty = true
        return
    end
    X.searchBusy = true
    X.lastSearch = os.clock()
    if not silent then
        X.searching = true
        X.dirty = true
    end

    task.spawn(function()
        local found, visited, truncated = {}, 0, false
        local stack = {}
        local roots = X.roots()
        for i = #roots, 1, -1 do stack[#stack + 1] = roots[i] end

        while #stack > 0 do
            if token ~= X.searchToken or not alive() then return end
            local inst = table.remove(stack)
            visited = visited + 1
            local hay = inst.Name:lower() .. " " .. inst.ClassName:lower()
            local okm = true
            for _, t in ipairs(terms) do
                if not hay:find(t, 1, true) then okm = false break end
            end
            if okm then
                if #found >= CONFIG.ExplorerSearchResults then
                    truncated = true
                    break
                end
                found[#found + 1] = inst
            end
            if visited >= CONFIG.ExplorerSearchMax then
                truncated = true
                break
            end
            if not inst:IsA("Terrain") then
                local list = kidsOf(inst)
                for i = #list, 1, -1 do stack[#stack + 1] = list[i] end
            end
            if visited % 1500 == 0 then task.wait() end
        end
        if token ~= X.searchToken or not alive() then return end

        table.sort(found, function(a, b)
            local an, bn = a.Name:lower(), b.Name:lower()
            if an ~= bn then return an < bn end
            return a.ClassName < b.ClassName
        end)
        local res = {}
        for _, inst in ipairs(found) do
            local par = inst.Parent
            res[#res + 1] = {
                kind = "node", inst = inst, depth = 0, flat = true,
                sub = inst.ClassName .. " | " .. ((par and par ~= game) and X.pathOf(par) or "game"),
            }
        end
        X.results, X.searchTrunc = res, truncated
        X.searching, X.searchBusy = false, false
        X.refresh(true)
    end)
end

-- dipanggil dari kolom cari (debounce 0.35 detik)
function X.setQuery(text)
    text = (text or ""):match("^%s*(.-)%s*$")
    if text == X.query then return end
    X.query = text
    X.qToken = X.qToken + 1
    local tok = X.qToken
    if text == "" then
        X.search("")
        X.refresh(true)
    else
        X.searching = true
        X.dirty = true
        task.delay(0.35, function()
            if tok == X.qToken and alive() then
                X.search(text)
                X.refresh(true)
            end
        end)
    end
end

-- ---- live: dengarkan perubahan di seluruh game ----
function X.hook()
    if X.hooked then return end
    X.hooked = true
    local function touch(d)
        if X.query ~= "" then
            X.dirty, X.searchStale = true, true
            return
        end
        local p = d.Parent
        if p == game or X.expanded[p] then X.dirty = true end
    end
    local ok = pcall(function()
        bind(game.DescendantAdded, touch)
        bind(game.DescendantRemoving, touch)
    end)
    if not ok then
        logLine("Explorer live: event DescendantAdded tidak tersedia, pakai polling tiap "
            .. CONFIG.ExplorerRefresh .. " detik.", "warn")
    end
end

-- UI memberi tahu engine kapan tab Explorer benar-benar terlihat
function X.setActive(on)
    on = on and true or false
    if on == X.active then return end
    X.active = on
    if on then
        X.hook()
