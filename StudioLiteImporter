local function on(signal, fn)
    return signal:Connect(function(...)
        if CORE.fixIdentity then CORE.fixIdentity() end
        local ok, err = pcall(fn, ...)
        if not ok then logLine("Studio: " .. tostring(err), "err") end
    end)
end

