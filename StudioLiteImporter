    end

    -- ---- Drag generik (mouse & touch) ----
    local function draggable(handle, target, onEnd, canDrag)
        local dragging, moved, dragStart, startPos = false, false, nil, nil
        bind(handle.InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                if canDrag and not canDrag() then
                    if onEnd then onEnd(false) end
                    return
                end
                dragging, moved = true, false
                dragStart, startPos = input.Position, target.Position
                local c
                c = input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                        c:Disconnect()
                        if onEnd then onEnd(moved) end
                    end
                end)
            end
        end)
        bind(UIS.InputChanged, function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                local d = input.Position - dragStart
                if not moved and d.Magnitude < 5 then return end
                moved = true
                local vp = viewport()
                local nx = math.clamp(startPos.X.Offset + d.X, -(target.AbsoluteSize.X - 70), vp.X - 70)
                local ny = math.clamp(startPos.Y.Offset + d.Y, 0, vp.Y - 30)
                target.Position = UDim2.fromOffset(nx, ny)
            end
        end)
    end

