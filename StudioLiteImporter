-- Parser rbxmx minimal (fallback kalau getcustomasset tidak ada)

local function xmlUnescape(s)
    s = s:gsub("&#x(%x+);", function(h) return utf8.char(tonumber(h, 16)) end)
    s = s:gsub("&#(%d+);", function(d) return utf8.char(tonumber(d)) end)
    s = s:gsub("&lt;", "<")
    s = s:gsub("&gt;", ">")
    s = s:gsub("&quot;", '"')
    s = s:gsub("&apos;", "'")
    s = s:gsub("&amp;", "&")
    return s
end

local function xmlParse(xml)
    local root = { children = {} }
    local stack = { root }
    local pos = 1
    while true do
        local lt = xml:find("<", pos, true)
        if not lt then break end
        if lt > pos then
            local text = xml:sub(pos, lt - 1)
            if text:match("%S") then
                local top = stack[#stack]
                top.text = (top.text or "") .. xmlUnescape(text)
            end
        end
        if xml:sub(lt, lt + 8) == "<![CDATA[" then
            local e = xml:find("]]>", lt + 9, true)
            if not e then error("CDATA tidak ditutup") end
            local top = stack[#stack]
            top.text = (top.text or "") .. xml:sub(lt + 9, e - 1)
            pos = e + 3
        elseif xml:sub(lt, lt + 3) == "<!--" then
            local e = xml:find("-->", lt + 4, true)
            if not e then error("komentar tidak ditutup") end
            pos = e + 3
        elseif xml:sub(lt, lt + 1) == "<?" then
            local e = xml:find("?>", lt + 2, true)
            if not e then error("deklarasi XML tidak ditutup") end
            pos = e + 2
        elseif xml:sub(lt, lt + 1) == "<!" then
            local e = xml:find(">", lt, true)
            if not e then error("tag tidak ditutup") end
            pos = e + 1
        elseif xml:sub(lt, lt + 1) == "</" then
            local e = xml:find(">", lt, true)
            if not e then error("tag penutup rusak") end
            if #stack > 1 then table.remove(stack) end
            pos = e + 1
        else
            local e = xml:find(">", lt, true)
            if not e then error("tag tidak ditutup") end
            local tagText = xml:sub(lt + 1, e - 1)
            local selfClose = tagText:sub(-1) == "/"
            if selfClose then tagText = tagText:sub(1, -2) end
            local name, rest = tagText:match("^([^%s]+)%s*(.*)$")
            local node = { name = name, attrs = {}, children = {} }
            for k, q, v in (rest or ""):gmatch("([%w_:%-]+)%s*=%s*([\"'])(.-)%2") do
                node.attrs[k] = xmlUnescape(v)
            end
            local top = stack[#stack]
            top.children[#top.children + 1] = node
            if not selfClose then stack[#stack + 1] = node end
            pos = e + 1
        end
    end
    return root
end

local function xmlChild(node, name)
    for _, c in ipairs(node.children) do
        if c.name == name then return c end
    end
    return nil
end

local function xmlNum(node, name)
    local c = xmlChild(node, name)
    return (c and tonumber(c.text)) or 0
end

local PROP_ALIASES = {
    size = "Size",
    shape = "Shape",
    Color3uint8 = "Color",
}

local function setEnum(inst, prop, raw)
    local n = tonumber(raw)
    if not n then return false end
    local ok, cur = pcall(function() return inst[prop] end)
    if ok and typeof(cur) == "EnumItem" then
        for _, item in ipairs(cur.EnumType:GetEnumItems()) do
            if item.Value == n then
                return pcall(function() inst[prop] = item end)
            end
        end
    end
    return false
end

local function convertValue(p)
    local t = p.name
    if t == "string" or t == "ProtectedString" then
        return true, p.text or ""
    elseif t == "bool" then
        return true, (p.text == "true")
    elseif t == "int" or t == "int64" or t == "float" or t == "double" then
        return true, tonumber(p.text) or 0
    elseif t == "Vector3" then
        return true, Vector3.new(xmlNum(p, "X"), xmlNum(p, "Y"), xmlNum(p, "Z"))
    elseif t == "Vector2" then
        return true, Vector2.new(xmlNum(p, "X"), xmlNum(p, "Y"))
    elseif t == "Color3" then
        if #p.children > 0 then
            return true, Color3.new(xmlNum(p, "R"), xmlNum(p, "G"), xmlNum(p, "B"))
        end
        local n = tonumber(p.text)
        if not n then return false end
        return true, Color3.fromRGB(math.floor(n / 65536) % 256, math.floor(n / 256) % 256, n % 256)
    elseif t == "Color3uint8" then
        local n = tonumber(p.text)
        if not n then return false end
        return true, Color3.fromRGB(math.floor(n / 65536) % 256, math.floor(n / 256) % 256, n % 256)
    elseif t == "CoordinateFrame" or t == "CFrame" then
        return true, CFrame.new(
            xmlNum(p, "X"), xmlNum(p, "Y"), xmlNum(p, "Z"),
            xmlNum(p, "R00"), xmlNum(p, "R01"), xmlNum(p, "R02"),
            xmlNum(p, "R10"), xmlNum(p, "R11"), xmlNum(p, "R12"),
            xmlNum(p, "R20"), xmlNum(p, "R21"), xmlNum(p, "R22")
        )
    elseif t == "UDim2" then
        return true, UDim2.new(xmlNum(p, "XS"), xmlNum(p, "XO"), xmlNum(p, "YS"), xmlNum(p, "YO"))
    elseif t == "UDim" then
        return true, UDim.new(xmlNum(p, "S"), xmlNum(p, "O"))
    elseif t == "BrickColor" then
        local n = tonumber(p.text)
        if not n then return false end
        return true, BrickColor.new(n)
    elseif t == "Content" then
        local u = xmlChild(p, "url")
        local s = (u and u.text) or p.text
        if not s or s == "" or s == "null" then return false end
        return true, s
    elseif t == "NumberSequence" then
        local keys = {}
        for a, b, c in (p.text or ""):gmatch("(%S+)%s+(%S+)%s+(%S+)") do
            keys[#keys + 1] = NumberSequenceKeypoint.new(tonumber(a), tonumber(b), tonumber(c))
        end
        if #keys < 2 then return false end
        return true, NumberSequence.new(keys)
    elseif t == "ColorSequence" then
        local keys = {}
        for a, r, g, b in (p.text or ""):gmatch("(%S+)%s+(%S+)%s+(%S+)%s+(%S+)%s+%S+") do
            keys[#keys + 1] = ColorSequenceKeypoint.new(tonumber(a), Color3.new(tonumber(r), tonumber(g), tonumber(b)))
        end
        if #keys < 2 then return false end
        return true, ColorSequence.new(keys)
    end
    return false
end

local function buildItem(node, refs, pending)
    local className = node.attrs and node.attrs.class
    if not className then return nil end
    local ok, inst = pcall(Instance.new, className)
    if not ok or not inst then return nil end
    if node.attrs.referent then refs[node.attrs.referent] = inst end

    local propsNode = xmlChild(node, "Properties")
    if propsNode then
        for _, p in ipairs(propsNode.children) do
            local name = p.attrs and p.attrs.name
            if name then
                name = PROP_ALIASES[name] or name
                if p.name == "Ref" then
                    pending[#pending + 1] = { inst, name, p.text }
                elseif p.name == "token" then
                    setEnum(inst, name, p.text)
                else
                    local okc, val = convertValue(p)
                    if okc then
                        pcall(function() inst[name] = val end)
                    end
                end
            end
        end
    end

    for _, c in ipairs(node.children) do
        if c.name == "Item" then
            local child = buildItem(c, refs, pending)
            if child then
                pcall(function() child.Parent = inst end)
            end
        end
    end
    return inst
end

local function parseRbxmx(text)
    local ok, root = pcall(xmlParse, text)
    if not ok then return nil, "XML rusak: " .. tostring(root) end
    local rbx
    for _, c in ipairs(root.children) do
        if c.name == "roblox" then rbx = c end
    end
    if not rbx then return nil, "bukan file rbxmx yang valid" end

    local refs, pending, out = {}, {}, {}
    for _, c in ipairs(rbx.children) do
        if c.name == "Item" then
            local inst = buildItem(c, refs, pending)
            if inst then out[#out + 1] = inst end
        end
    end
    for _, r in ipairs(pending) do
        local target = refs[r[3]]
        if target then
            pcall(function() r[1][r[2]] = target end)
        end
    end
    if #out == 0 then return nil, "tidak ada instance di dalam file" end
    return out
end
-- [[PARSER END]]

-- File & import logic

local function displayName(path)
    return path:match("([^/\\]+)$") or path
end

local function ensureFolder()
    if makefolder and isfolder and not isfolder(CONFIG.Folder) then
        pcall(makefolder, CONFIG.Folder)
    end
end

local function listImportFiles()
    local out = {}
    if not listfiles then return out, "executor ini tidak punya listfiles, ketik nama file manual" end
    ensureFolder()
    local ok, files = pcall(listfiles, CONFIG.Folder)
    if not ok then return out, "gagal baca folder: " .. tostring(files) end
    for _, f in ipairs(files) do
        local low = f:lower()
        if low:sub(-5) == ".rbxm" or low:sub(-6) == ".rbxmx" then
            out[#out + 1] = f
        end
    end
    table.sort(out)
    return out
end

local function loadFile(path)
    local getAsset = getcustomasset or getsynasset
    local nativeErr = "getcustomasset tidak tersedia"
    if getAsset then
        local ok, res = pcall(function()
            return game:GetObjects(getAsset(path))
        end)
        if ok and type(res) == "table" and #res > 0 then
            return res, "GetObjects"
        end
        nativeErr = tostring(res)
    end

    if not readfile then return nil, "executor tidak punya readfile" end
    local okr, data = pcall(readfile, path)
    if not okr or type(data) ~= "string" then
        return nil, "gagal baca file: " .. tostring(data)
    end
    if data:sub(1, 8) == "<roblox!" then
        return nil, "rbxm biner butuh getcustomasset (" .. nativeErr .. "). Simpan ulang sebagai .rbxmx lalu coba lagi."
    end
    local objs, err = parseRbxmx(data)
    if objs then return objs, "parser rbxmx" end
    return nil, err
end

local function sanitize(obj)
    if not CONFIG.DisableScripts then return end
    local list = obj:GetDescendants()
    table.insert(list, obj)
    for _, d in ipairs(list) do
        if d:IsA("BaseScript") then
            pcall(function() d.Disabled = true end)
        end
    end
end

local function placeInFront(obj)
    local cam = workspace.CurrentCamera
    if not cam then return end
    local target = cam.CFrame.Position + cam.CFrame.LookVector * 25
    if obj:IsA("Model") then
        pcall(function() obj:PivotTo(CFrame.new(target)) end)
    elseif obj:IsA("BasePart") then
        pcall(function() obj.Position = target end)
    end
end

local TARGETS = { "Workspace", "ReplicatedStorage", "StarterGui", "StarterPack", "Lighting" }
local targetIndex = 1
local lastImported = {}

local function doImport(path)
    local objs, how = loadFile(path)
    if not objs then return false, how end

    local target = game:GetService(TARGETS[targetIndex])
    local added = {}
    for _, obj in ipairs(objs) do
        sanitize(obj)
        if target == workspace and CONFIG.SpawnInFrontOfCamera then
            placeInFront(obj)
        end
        local ok = pcall(function() obj.Parent = target end)
        if ok then added[#added + 1] = obj end
    end
    lastImported = added
    return true, string.format("Berhasil: %d objek dari %s -> %s (via %s)",
        #added, displayName(path), TARGETS[targetIndex], how)
end

