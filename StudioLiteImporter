    local tb = new("TextBox", { Position = UDim2.fromOffset(24, 0), Size = UDim2.new(1, -30, 1, 0), BackgroundTransparency = 1, Text = "",
        PlaceholderText = "Run a command (Lua; 'selection' = selected objects)", PlaceholderColor3 = T.textDim, ClearTextOnFocus = false, TextColor3 = T.text,
        Font = MONO, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, BorderSizePixel = 0 }, box)
    CMD.box = tb
    on(tb.FocusLost, function(enter)
        if enter then
            local t = tb.Text
            tb.Text = ""
            CMD.run(t)
            task.defer(function() pcall(function() tb:CaptureFocus() end) end)
        end
    end)
    on(tb.Focused, function() ST.lastFocus = "cmd" end)
    bind2(UIS.InputBegan, function(input)
        if not tb:IsFocused() then return end
        if input.KeyCode == Enum.KeyCode.Up and #CMD.history > 0 then
            CMD.hi = math.max(1, CMD.hi - 1)
            tb.Text = CMD.history[CMD.hi] or ""
        elseif input.KeyCode == Enum.KeyCode.Down and #CMD.history > 0 then
            CMD.hi = math.min(#CMD.history + 1, CMD.hi + 1)
            tb.Text = CMD.history[CMD.hi] or ""
        end
    end)
end

-- pesan dari game (print / warn / error) ikut tampil di Output
function OUT.hookGame()
    local okh, hist = pcall(function() return LogService:GetLogHistory() end)
    if okh and type(hist) == "table" and not OUT.histDone then
        OUT.histDone = true
        local start = math.max(1, #hist - 80)
        for i = start, #hist do
            local m = hist[i]
            local k = (m.messageType == Enum.MessageType.MessageError and "err") or (m.messageType == Enum.MessageType.MessageWarning and "warn") or "info"
            OUT.add(m.message, k, os.date("%H:%M:%S", m.timestamp))
        end
    end
    bind2(LogService.MessageOut, function(message, mtype)
        if tostring(message):find("^%[SL") then return end
        local k = (mtype == Enum.MessageType.MessageError and "err") or (mtype == Enum.MessageType.MessageWarning and "warn") or "info"
        OUT.add(message, k)
    end)
end


