local function refreshList()
    for _, b in ipairs(fileButtons) do b:Destroy() end
    fileButtons = {}
    selectedPath = nil
    local files, err = listImportFiles()
    for i, f in ipairs(files) do
        local b = make("TextButton", {
            Text = displayName(f),
            Size = UDim2.new(1, -6, 0, 28),
            BackgroundColor3 = Color3.fromRGB(45, 48, 60),
            TextColor3 = Color3.new(1, 1, 1),
            Font = Enum.Font.Gotham,
            TextSize = 12,
            TextTruncate = Enum.TextTruncate.AtEnd,
            BorderSizePixel = 0,
            LayoutOrder = i,
        }, list)
        corner(b, 5)
        b.MouseButton1Click:Connect(function()
            selectedPath = f
            for _, other in ipairs(fileButtons) do
                other.BackgroundColor3 = Color3.fromRGB(45, 48, 60)
            end
            b.BackgroundColor3 = Color3.fromRGB(60, 110, 190)
            setStatus("Dipilih: " .. displayName(f), INFO)
        end)
        fileButtons[#fileButtons + 1] = b
    end
    if err then
        setStatus(err, ERR)
    elseif #files == 0 then
        setStatus("Belum ada file .rbxm/.rbxmx. Taruh di folder lalu tekan Refresh.", INFO)
    else
        setStatus(#files .. " file ditemukan. Pilih satu lalu Import.", INFO)
    end
end

local function resolvePath()
    local typed = nameBox.Text:match("^%s*(.-)%s*$")
    if typed ~= "" then
        if not isfile then return CONFIG.Folder .. "/" .. typed end
        local candidates = {
            typed,
            CONFIG.Folder .. "/" .. typed,
            CONFIG.Folder .. "/" .. typed .. ".rbxmx",
            CONFIG.Folder .. "/" .. typed .. ".rbxm",
        }
        for _, c in ipairs(candidates) do
            if isfile(c) then return c end
        end
        return nil
    end
    return selectedPath
end

local busy = false

importBtn.MouseButton1Click:Connect(function()
    if busy then return end
    local path = resolvePath()
    if not path then
        setStatus("File tidak ketemu. Pilih dari daftar atau cek nama file.", ERR)
        return
    end
    busy = true
    setStatus("Memuat " .. displayName(path) .. " ...", INFO)
    task.spawn(function()
        local okc, ok, msg = pcall(doImport, path)
        if not okc then
            setStatus("Error: " .. tostring(ok), ERR)
        else
            setStatus(msg, ok and OK or ERR)
        end
        busy = false
    end)
end)

