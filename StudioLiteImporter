function ACT.expand(inst, on)
    ST.expanded[inst] = on and true or nil
    EX.dirty = true
end

function ACT.reveal(inst)
    local p = inst and inst.Parent
    local guard = 0
    while p and p ~= game and guard < 100 do
        ST.expanded[p] = true
        p = p.Parent
        guard = guard + 1
    end
    EX.dirty = true
    EX.pendingScroll = inst
end

function ACT.insert(class, parent, init)
    parent = parent or SEL.list[1] or workspace
    if not canHold(parent) then
        notify("Tidak bisa menambah objek ke " .. tostring(parent and parent.Name) .. ".", "warn")
        return nil
    end
    local ok, inst = pcall(Instance.new, class)
    if not ok or not inst then
        notify(class .. " tidak bisa dibuat dari client.", "warn")
        return nil
    end
    -- v7: objek GUI harus ada di dalam ScreenGui supaya tampil; kalau induknya StarterGui / Workspace / service, bungkus
    if inst:IsA("GuiObject") then
        local sgSvc = game:GetService("StarterGui")
        if parent == sgSvc or parent == workspace or parent.Parent == game then
            local host
            for _, c in ipairs(sgSvc:GetChildren()) do
                if c:IsA("ScreenGui") then host = c break end
            end
            if not host then
                host = Instance.new("ScreenGui")
                host.Name = "ScreenGui"
                host.ResetOnSpawn = false
                host.Parent = sgSvc
            end
            parent = host
        end
    end
    if inst:IsA("BasePart") then
        inst.Anchored = true
        local cam = workspace.CurrentCamera
        if cam and parent:IsDescendantOf(workspace) then
            pcall(function() inst.Position = (cam.CFrame * CFrame.new(0, 0, -14)).Position end)
        end
    elseif inst:IsA("GuiObject") then
        if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
            inst.Size = UDim2.fromOffset(200, 50)
            inst.Text = inst.ClassName == "TextBox" and "" or inst.ClassName == "TextButton" and "Button" or "Label"
        else
            inst.Size = UDim2.fromOffset(100, 100)
        end
    end
    if init then pcall(init, inst) end
    inst.Parent = parent
    if inst.Parent ~= parent then
        notify("Gagal memasang " .. class .. " ke " .. parent.Name .. ".", "err")
        pcall(function() inst:Destroy() end)
        return nil
    end
    if inst:IsA("LuaSourceContainer") then
        local okH, whyH = ACT.ensureScriptHolder(inst, ACT.TEMPLATES[inst.ClassName] or "")
        if not okH then notify("Editor script: " .. tostring(whyH), "warn") end
    end
    HIST.push("Insert " .. class, function()
        pcall(function() inst.Parent = nil end)
    end, function()
        pcall(function() inst.Parent = parent end)
    end)
    ACT.reveal(inst)
    setSel({ inst })
    setStatus("Insert " .. class .. " -> " .. parent.Name, "ok")
    return inst
end

