local function hideCells(r)
    r.check.Visible, r.sw.Visible, r.tb.Visible, r.dd.Visible, r.act.Visible = false, false, false, false, false
    r.del.Visible, r.arrow.Visible, r.nameBtn.Visible, r.vline.Visible = false, false, false, false
end

local function paintPropRow(r, i)
    local d = PR.rows[i]
    r.d = d
    if not d then r.root.Visible = false return end
    local split = SS.propSplit
    hideCells(r)
    r.tR.Visible, r.tD.Visible = false, false
    r.root.BackgroundTransparency = 1
    r.name.Font = FONT
    r.name.TextColor3 = T.text
    r.name.Position = UDim2.fromOffset(22, 0)
    r.name.Size = UDim2.new(split, -26, 1, 0)
    r.valHolder.Position = U2(split, 0, 0, 0)
    r.valHolder.Size = U2(1 - split, 0, 1, 0)
    r.nameBtn.Position, r.nameBtn.Size = UDim2.fromOffset(0, 0), U2(split, 0, 1, 0)
    r.line.BackgroundColor3 = T.line

    if d.k == "cat" then
        r.root.BackgroundColor3, r.root.BackgroundTransparency = T.catHead, 0
        r.arrow.Visible = true
        r.arrow.Position = UDim2.fromOffset(2, 0)
        r.tR.Visible, r.tD.Visible = d.collapsed, not d.collapsed
        r.name.Text = d.name
        r.name.Font = FONTM
        r.name.Size = UDim2.new(1, -30, 1, 0)
        return
    end
    if d.k == "add" then
        r.name.Text = (d.what == "attr") and "+ Add attribute..." or "+ Add tag..."
        r.name.TextColor3 = T.link
        r.name.Size = UDim2.new(1, -30, 1, 0)
        return
    end
    if d.k == "tag" then
        r.name.Text = d.name
        r.name.Size = UDim2.new(1, -40, 1, 0)
        r.del.Visible = true
        r.del.Position = U2(1, -26, 0.5, -9)
        return
    end

    local p = d.p
    local indent = 22 + d.depth * 14
    r.name.Position = UDim2.fromOffset(indent, 0)
    r.name.Size = UDim2.new(split, -indent - 4, 1, 0)
    r.vline.Visible = true
    local ty, getter = p.type, nil
    local kind
    if d.k == "comp" then
        r.name.Text = d.comp.label
        r.name.TextColor3 = T.textDim
        if d.cframe then
            ty = "Vector3"
            getter = d.comp.get
        else
            ty = "double"
            getter = d.comp.get
        end
        kind = (d.cframe and "vec3") or "num"
    else
        r.name.Text = p.name
        kind = VT.kind(ty)
        if p.ro then r.name.TextColor3 = T.textDim end
        local comps = (kind == "cframe") and true or VT.comps(ty)
        if comps then
            r.arrow.Visible = true
            r.arrow.Position = UDim2.fromOffset(2 + d.depth * 14, 0)
            local open = ST.propExpanded[p.name]
            r.tR.Visible, r.tD.Visible = not open, open and true or false
        end
        if p.attr then r.nameBtn.Visible = true end
    end

    local val, mixed, any = PR.read(p, getter)
    local editable = not p.ro and kind ~= "ro"
    if d.k == "comp" or d.cframe then editable = true end
    if p.ro then editable = false end

    local text = ""
    if not any then
        text = ""
    elseif mixed then
        text = ""
    elseif d.k == "comp" and not d.cframe then
        text = fnum(val)
        if d.comp.int then text = tostring(math.floor(val + 0.5)) end
    elseif d.k == "comp" then
        text = VT.fmt(val, "Vector3")
    else
        text = VT.fmt(val, ty)
    end

    if kind == "bool" then
        r.check.Visible = true
        local on = (not mixed) and val == true
        r.check.BackgroundColor3 = on and T.accent or T.input
        r.checkStroke.Color = on and T.accent or T.inputLine
        r.checkMark.Visible = on
        r.checkDash.Visible = mixed and true or false
        if mixed then
            r.check.BackgroundColor3 = T.accent
        end
        r.check.Active = editable
    else
        r.tb.Visible = true
        r.tb.TextEditable = editable and (kind ~= "enum" and kind ~= "brick" and kind ~= "font" and kind ~= "inst" and kind ~= "color3" or kind == "color3")
        if kind == "enum" or kind == "brick" or kind == "font" or kind == "inst" then
            r.tb.TextEditable = false
            r.tb.Selectable = false
        else
            r.tb.Selectable = true
        end
        r.tb.TextColor3 = (editable and T.text) or T.textDim
        r.tb.PlaceholderText = mixed and "<Mixed>" or ""
        local xoff = 6
        if kind == "color3" or kind == "brick" then
            r.sw.Visible = true
            local c = nil
            if kind == "color3" and typeof(val) == "Color3" then c = val end
            if kind == "brick" and typeof(val) == "BrickColor" then c = val.Color end
            r.sw.BackgroundColor3 = c or T.panel
            r.sw.BackgroundTransparency = (c and not mixed) and 0 or 0.6
            xoff = 32
        end
        r.tb.Position = UDim2.fromOffset(xoff, 1)
        r.tb.Size = UDim2.new(1, -(xoff + (kind == "enum" and 18 or 6)), 1, -2)
        if not r.tb:IsFocused() then r.tb.Text = text end
        if (kind == "enum" or kind == "font" or kind == "inst" or kind == "brick") and editable then
            r.dd.Visible = (kind == "enum" or kind == "font")
            r.act.Visible = true
        elseif kind == "color3" then
            r.act.Visible = false
        end
    end
end

function PR.build(parent)
    local top = frame(parent, { Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = T.panel })
    local box = frame(top, { Position = UDim2.fromOffset(8, 5), Size = UDim2.new(1, -16, 0, 25), BackgroundColor3 = T.input })
    corner(box, 5)
    stroke(box, T.inputLine, 1)
    UI.magnifier(box, 8, 6)
    local tb = new("TextBox", { Position = UDim2.fromOffset(26, 0), Size = UDim2.new(1, -34, 1, 0), BackgroundTransparency = 1, Text = "",
        PlaceholderText = "Filter Properties (Ctrl+Shift+P)", PlaceholderColor3 = T.textDim, ClearTextOnFocus = false, TextColor3 = T.text, Font = FONT, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left, BorderSizePixel = 0 }, box)
    PR.filterBox = tb
    local tok = 0
    on(tb:GetPropertyChangedSignal("Text"), function()
        tok = tok + 1
        local mine = tok
        task.delay(0.25, function()
            if mine == tok then
                PR.filter = tb.Text
                PR.rebuild()
            end
        end)
    end)
    on(tb.Focused, function() ST.lastFocus = "pr" end)
    frame(parent, { Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = T.line })
    local holder = new("Frame", { Position = UDim2.fromOffset(0, 35), Size = UDim2.new(1, 0, 1, -35), BackgroundTransparency = 1, ClipsDescendants = true }, parent)
    PR.holder = holder
    PR.L = UI.vlist(holder, PR.rowH, createPropRow, paintPropRow)
    PR.empty = lbl(holder, { Size = U2(1, 0, 1, 0), Text = "Select an object to view its properties", TextXAlignment = Enum.TextXAlignment.Center,
        TextColor3 = T.textDim, TextSize = 13, TextWrapped = true, Active = false })
    pad(PR.empty, 16, 16, 0, 0)

    -- pembagi kolom nama / nilai
    local div = btn(holder, { Position = U2(SS.propSplit, -3, 0, 0), Size = UDim2.new(0, 7, 1, 0), ZIndex = 3 })
    PR.div = div
    dragArea(div, function(p)
        local ap, as = holder.AbsolutePosition, holder.AbsoluteSize
        local f = math.clamp((p.X - ap.X) / math.max(1, as.X), 0.25, 0.75)
        SS.propSplit = f
        div.Position = U2(f, -3, 0, 0)
        PR.L.refresh(true)
    end, function() saveSS() end)

    local myGen = gen
    task.spawn(function()
        while alive() and myGen == gen do
            task.wait(0.25)
            if SS.pr and UI.frame and UI.frame.Parent and not PR.editing and #PR.targets > 0 then
                pcall(PR.L.refresh, true)
            end
        end
    end)
    PR.rebuild()
end

function PR.onSelection()
    PR.rebuild()
end


