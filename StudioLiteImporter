-- hover untuk tombol datar (mouse)
local function hoverable(b, normal, hover, active)
    normal = normal or 1
    on(b.MouseEnter, function()
        if b:GetAttribute("on") then return end
        b.BackgroundColor3, b.BackgroundTransparency = hover or T.btnHover, 0
    end)
    on(b.MouseLeave, function()
        if b:GetAttribute("on") then return end
        b.BackgroundTransparency = normal
    end)
end

