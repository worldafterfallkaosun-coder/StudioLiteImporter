local function calcScale()
    if SS.uiScale then return SS.uiScale end
    local cam = workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or V2(1280, 720)
    local s = math.min(vp.Y / 620, vp.X / 820, 1)
    return math.clamp(s, 0.5, 1)
end

local function guiHost(sg)
    local parented = false
    if gethui then
        local okh, h = pcall(gethui)
        if okh and h then parented = pcall(function() sg.Parent = h end) and sg.Parent ~= nil end
    end
    if not parented then
        local okc = pcall(function() sg.Parent = game:GetService("CoreGui") end)
        parented = okc and sg.Parent ~= nil
    end
    if not parented then sg.Parent = LocalPlayer:WaitForChild("PlayerGui") end
end

local function makePanel(key, title, closable)
