local NV = { dialog = nil }

function NV.gui()
    local pg = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
    return pg and pg:FindFirstChild("StudioGui")
end

-- v8: sembunyikan UI asli lebih keras.
-- v7 hanya mematikan PlayerGui.StudioGui satu kali; kalau game menyalakannya lagi (atau ada ScreenGui native lain
-- seperti dialog "Studio Lite" / tutorial) UI asli tetap muncul di atas Studio Editor dan menelan sentuhan.
-- Sekarang: semua root native dimatikan, DisplayOrder diturunkan, dan dikunci (kalau game menyalakan lagi,
-- langsung dimatikan lagi). Nilai asli disimpan di NV.seen dan dikembalikan saat editor ditutup.
NV.seen = setmetatable({}, { __mode = "k" })
NV.locks = {}
NV.namePats = { "studio", "tutorial", "welcome", "explorer", "toolbox", "properties", "ribbon" }

function NV.isNativeRoot(c)
    if not c:IsA("LayerCollector") then return false end
    local n = c.Name
    if n:sub(1, 2) == "SL" then return false end -- GUI milik script ini (SLStudio, SLImporter, SLGizmoGui, SLPreview_*)
    if n == "StudioGui" then return true end
    if ST.playing then return false end -- saat Play, GUI buatan user tidak boleh ikut disembunyikan
    local l = n:lower()
    for _, p in ipairs(NV.namePats) do
        if l:find(p, 1, true) then return true end
    end
    return false
end

function NV.unlockAll()
    for _, c in pairs(NV.locks) do pcall(function() c:Disconnect() end) end
    NV.locks = {}
end

function NV.lock(g)
    if NV.locks[g] then return end
    NV.locks[g] = g:GetPropertyChangedSignal("Enabled"):Connect(function()
        if NV.dialog or CONFIG.HideNativeUi == false then return end
        if g.Enabled and NV.seen[g] then
            task.defer(function()
                if not NV.dialog and CONFIG.HideNativeUi ~= false and NV.seen[g] then
                    pcall(function() g.Enabled = false end)
                end
            end)
        end
    end)
end

function NV.restoreAll()
    NV.unlockAll()
    for c, rec in pairs(NV.seen) do
        if c.Parent then
            pcall(function() c.DisplayOrder = rec.order end)
            if rec.enabled then pcall(function() c.Enabled = true end) end
        end
        NV.seen[c] = nil
    end
    ST.nativeWas = nil
end

function NV.applyHidden()
    if NV.dialog then return end
    local pg = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return end
    if CONFIG.HideNativeUi ~= false then
        for _, c in ipairs(pg:GetChildren()) do
            if NV.isNativeRoot(c) then
                local rec = NV.seen[c]
                if not rec then
                    rec = { order = c.DisplayOrder, enabled = c.Enabled }
                    NV.seen[c] = rec
                    ST.nativeWas = true
                end
                if c.Enabled then pcall(function() c.Enabled = false end) end
                if c.DisplayOrder > -400 then pcall(function() c.DisplayOrder = -500 end) end
                NV.lock(c)
            end
        end
    else
        NV.restoreAll()
    end
end

-- daftar ScreenGui di PlayerGui ke Output (diagnosa: kalau masih ada UI asli yang nongol, namanya kelihatan di sini)
function NV.logGuis()
