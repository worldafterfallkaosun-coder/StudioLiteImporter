function UI.toast(text, kind)
    if not UI.frame or not UI.frame.Parent then return end
    local col = (kind == "err" and T.err) or (kind == "warn" and T.warn) or (kind == "ok" and T.ok) or T.accent
    local sz = UI.size()
    local w = math.min(math.max(textWidth(text, 13) + 40, 160), sz.X - 40)
    local t = frame(UI.pop, { Size = UDim2.fromOffset(w, 30), AnchorPoint = V2(0.5, 1), Position = UDim2.fromOffset(sz.X / 2, sz.Y - 34),
        BackgroundColor3 = T.panel, ZIndex = 40 })
    corner(t, 8)
    stroke(t, T.lineStrong, 1)
    frame(t, { Size = UDim2.fromOffset(4, 30), BackgroundColor3 = col })
    lbl(t, { Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -22, 1, 0), Text = text, TextSize = 13, TextTruncate = Enum.TextTruncate.AtEnd })
    for i, o in ipairs(UI.toasts) do
        if o.Parent then o.Position = o.Position - UDim2.fromOffset(0, 36) end
    end
    UI.toasts[#UI.toasts + 1] = t
    while #UI.toasts > 4 do
        local o = table.remove(UI.toasts, 1)
        pcall(function() o:Destroy() end)
    end
    task.delay(3.2, function()
        local i = table.find(UI.toasts, t)
        if i then table.remove(UI.toasts, i) end
        pcall(function() t:Destroy() end)
    end)
end


