        end
        local need = math.ceil(math.max(xList.AbsoluteSize.Y, 60) / XR_H) + 3
        while #xPool < need do xPool[#xPool + 1] = makeXRow() end
        curTarget = E.getTarget()
        local first = math.max(1, math.floor(xList.CanvasPosition.Y / XR_H) + 1)
        for i, row in ipairs(xPool) do
