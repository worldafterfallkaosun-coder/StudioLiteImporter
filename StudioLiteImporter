        if ok then
            ensureFolder()
            pcall(writefile, CONFIG.SettingsFile, json)
        end
    end)
end

-- ---- Daftar / filter / urutan ----
local function sortList(list, mode)
    table.sort(list, function(a, b)
        if mode == "name_desc" then
            if a.lname ~= b.lname then return a.lname > b.lname end
        elseif mode == "folder" then
            if a.ldir ~= b.ldir then return a.ldir < b.ldir end
            if a.lname ~= b.lname then return a.lname < b.lname end
        elseif mode == "format" then
            if a.ext ~= b.ext then return a.ext < b.ext end
            if a.lname ~= b.lname then return a.lname < b.lname end
        else
            if a.lname ~= b.lname then return a.lname < b.lname end
        end
        return a.path < b.path
    end)
end

function E.applyView()
    local terms = {}
    for w in S.query:lower():gmatch("%S+") do terms[#terms + 1] = w end
    local v = {}
    local counts = { all = 0, model = 0, place = 0, image = 0, audio = 0 }
    for _, e in ipairs(S.entries) do
        local okm = true
        for _, t in ipairs(terms) do
            if not e.lower:find(t, 1, true) then okm = false break end
        end
        if okm then
            counts.all = counts.all + 1
            counts[e.kind] = counts[e.kind] + 1
            if S.filter == "all" or S.filter == e.kind then v[#v + 1] = e end
        end
    end
    sortList(v, S.sort)
    S.view, S.counts = v, counts
    fire("view")
end

