-- v7: antrean kerja yang dijalankan dari Heartbeat milik kita (identity thread normal)
E.deferQ = {}
function E.defer(fn)
    E.deferQ[#E.deferQ + 1] = fn
end
do
    bind(game:GetService("RunService").Heartbeat, function()
        local q = E.deferQ
        if #q == 0 then return end
        E.deferQ = {}
        for _, job in ipairs(q) do
            local ok, err = pcall(job)
            if not ok then warn("[SLImporter] deferred: " .. tostring(err)) end
        end
    end)
end

function E.runHook(label, fn, ...)
    fixIdentity()
    local ok, err = pcall(fn, ...)
    if ok then return end
    if tostring(err):find("capability", 1, true) then
        -- thread saat ini kekurangan capability: ulangi dari Heartbeat milik kita
        local args = table.pack(...)
        E.defer(function()
            local ok2, err2 = pcall(fn, table.unpack(args, 1, args.n))
            if not ok2 then warn("[SLImporter] " .. label .. ": " .. tostring(err2)) end
        end)
    else
        warn("[SLImporter] " .. label .. ": " .. tostring(err))
    end
end

local function fire(name, ...)
    local f = H[name]
    if f then E.runHook("hook " .. name, f, ...) end
    local l = HL[name]
    if l then
        for _, fn in ipairs(l) do E.runHook("listener " .. name, fn, ...) end
    end
end

function E.listen(name, fn)
    HL[name] = HL[name] or {}
    table.insert(HL[name], fn)
    return function()
        local l = HL[name]
        local i = l and table.find(l, fn)
        if i then table.remove(l, i) end
    end
end

local function logLine(text, kind)
    local line = { t = os.date("%H:%M:%S"), text = tostring(text), kind = kind or "info" }
    S.log[#S.log + 1] = line
    if #S.log > 300 then table.remove(S.log, 1) end
    fire("log", line)
end

local function setStatus(text, kind)
    fire("status", text, kind or "info")
end

local function notify(text, kind)
    logLine(text, kind)
    setStatus(text, kind)
    fire("toast", text, kind or "info")
end

local function fmtBytes(n)
    if n < 1024 then return n .. " B" end
    if n < 1048576 then return string.format("%.1f KB", n / 1024) end
    return string.format("%.2f MB", n / 1048576)
end

