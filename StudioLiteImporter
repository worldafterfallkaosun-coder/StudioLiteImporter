-- objek yang tidak boleh disentuh operasi: service, Terrain, Camera, internal Studio Lite,
-- PlayerGui / CoreGui, gizmo, dan GUI importer ini sendiri
local function isProtected(inst)
    if typeof(inst) ~= "Instance" then return true end
    if inst == game or inst.Parent == game then return true end
    if inst:IsA("Terrain") or inst:IsA("Camera") then return true end
    local sl = ReplicatedStorageSvc:FindFirstChild("StudioLiteFolder")
    if sl and (inst == sl or inst:IsDescendantOf(sl)) then return true end
    if inst:IsDescendantOf(Players) then return true end
    local okc, inCore = pcall(function() return CoreGuiSvc ~= nil and inst:IsDescendantOf(CoreGuiSvc) end)
    if okc and inCore then return true end
    local okg, isGizmo = pcall(function() return inst:GetAttribute("SL_Gizmo") end)
    if okg and isGizmo then return true end
    local g = env.__SLImporterGui
    if g and (inst == g or inst:IsDescendantOf(g)) then return true end
    local g2 = env.__SLStudioGui
    if g2 and (inst == g2 or inst:IsDescendantOf(g2)) then return true end
    return false
end

-- buang objek yang merupakan turunan dari objek lain di daftar yang sama
local function topLevel(list)
    local set = {}
    for _, i in ipairs(list) do set[i] = true end
    local out = {}
    for _, i in ipairs(list) do
        local skip = false
        local p = i.Parent
        while p do
            if set[p] then skip = true break end
            p = p.Parent
        end
        if not skip then out[#out + 1] = i end
    end
    return out
end

-- ---- Cek integritas: bandingkan isi file (pohon) dengan instance yang benar-benar terbentuk ----
local function tallyNodes(nodes, t)
    for _, n in ipairs(nodes) do
        t[n.class] = (t[n.class] or 0) + 1
        tallyNodes(n.children, t)
    end
    return t
end

local function tallyInst(objs, t)
    for _, o in ipairs(objs) do
        t[o.ClassName] = (t[o.ClassName] or 0) + 1
        for _, d in ipairs(o:GetDescendants()) do t[d.ClassName] = (t[d.ClassName] or 0) + 1 end
    end
    return t
end

local function integrityReport(nodes, objs)
    local want, got = tallyNodes(nodes, {}), tallyInst(objs, {})
    local missing, total, lost = {}, 0, 0
    for cls, n in pairs(want) do
        total = total + n
        local g = got[cls] or 0
        if g < n then
            missing[#missing + 1] = { cls = cls, n = n - g }
            lost = lost + (n - g)
        end
    end
    table.sort(missing, function(a, b)
        if a.n ~= b.n then return a.n > b.n end
        return a.cls < b.cls
    end)
    return { expected = total, lost = lost, missing = missing }
end

local function integrityText(rep)
    if rep.lost == 0 then return string.format("integritas OK (%d objek)", rep.expected) end
    local parts = {}
    for i, m in ipairs(rep.missing) do
        if i > 4 then parts[#parts + 1] = "..." break end
        parts[#parts + 1] = m.cls .. "x" .. m.n
    end
    return string.format("INTEGRITAS: %d dari %d objek tidak terbentuk (%s)", rep.lost, rep.expected, table.concat(parts, ", "))
end

-- ---- Freeze: anchor part yang tidak di-anchor supaya model tidak berantakan karena fisika ----
-- Nilai asli disimpan di atribut SL_OrigAnchored supaya bisa dikembalikan (tombol "Lepas anchor asli").
local function freezeParts(objs)
    local n = 0
    local function one(d)
        if d:IsA("BasePart") and not d:IsA("Terrain") then
            local okA, anch = pcall(function() return d.Anchored end)
            if okA and anch == false then
                pcall(function() d:SetAttribute("SL_OrigAnchored", false) end)
                if pcall(function() d.Anchored = true end) then n = n + 1 end
            end
        end
    end
    for _, o in ipairs(objs) do
        one(o)
        for _, d in ipairs(o:GetDescendants()) do one(d) end
    end
    return n
end

-- ---- Tail import bersama (model, isi place, aset Toolbox) ----
-- objs: root instance (Parent nil). roots: pohon file (untuk teks script & integritas), boleh nil.
-- return: ok, pesan, added, scripts, stats
local function finishImport(objs, roots, label, how, dest, opts)
    opts = opts or {}
    local scripts, parseErr = gatherScripts(nil, objs, roots)
    parseErr = parseErr or opts.parseErr
    local outDir = exportScripts(label, scripts)

    -- pasang teks script SEBELUM objek masuk ke game (struktur editor Studio Lite)
    local stats = { ok = 0, fail = 0, notes = {} }
    if CONFIG.InstallScriptText and #scripts > 0 then
        local oki, res = pcall(installScriptText, scripts)
        if oki then
            stats = res
        else
            stats.fail = #scripts
            stats.firstReason = tostring(res)
        end
    end

    for _, obj in ipairs(objs) do sanitize(obj) end

    local world = isWorld(dest)
    local froze = 0
    if CONFIG.FreezeOnImport and world then froze = freezeParts(objs) end
    if world and CONFIG.SpawnInFrontOfCamera and not opts.noPlace then
        local okp, perr = pcall(placeGroup, objs, opts.placeState)
        if not okp then logLine("placeGroup: " .. tostring(perr), "warn") end
    end

    local added = {}
    for _, obj in ipairs(objs) do
        local ok = pcall(function() obj.Parent = dest end)
        if ok and obj.Parent == dest then added[#added + 1] = obj end
    end

    local msg = string.format("%s -> %s: %d objek (via %s)", label, X.pathOf(dest), #added, how)
    if #scripts > 0 then
        if CONFIG.InstallScriptText then
            msg = msg .. string.format(", teks script %d/%d", stats.ok, #scripts)
            if stats.fail > 0 then msg = msg .. " (gagal: " .. tostring(stats.firstReason) .. ")" end
        else
            msg = msg .. string.format(", %d script (teks tidak dipasang)", #scripts)
        end
    end
    if froze > 0 then msg = msg .. string.format(", %d part di-anchor", froze) end
    if CONFIG.IntegrityCheck and roots then
        local okr, rep = pcall(integrityReport, roots, objs)
        if okr then msg = msg .. ", " .. integrityText(rep) end
    end
    if parseErr then msg = msg .. " | peringatan baca file: " .. tostring(parseErr):sub(1, 80) end
    if outDir and stats.fail > 0 then msg = msg .. " | cadangan .lua: " .. outDir end
    return #added > 0, (#added > 0) and msg or (msg .. " | tidak ada objek yang bisa dipasang"), added, scripts, stats
end

local function parseOrNil(data)
    if not data then return nil end
    local ok, r = pcall(parseTree, data)
    if ok and type(r) == "table" and r[1] then return r end
    return nil, tostring(r)
end

