local DB = { cats = {}, types = {}, raw = {}, parsed = {}, chainCache = {}, propCache = {}, insertable = {} }
for c in PROPDB_CATS:gmatch("[^,]+") do DB.cats[#DB.cats + 1] = c end
for c in PROPDB_TYPES:gmatch("[^,]+") do DB.types[#DB.types + 1] = c end
for line in PROPDB_SRC:gmatch("[^\n]+") do
    local name, super, flags, props = line:match("^([^|]*)|([^|]*)|([^|]*)|(.*)$")
    if name then
        DB.raw[name] = { super = super, flags = flags, props = props }
        if flags:find("c", 1, true) and not flags:find("s", 1, true) then DB.insertable[#DB.insertable + 1] = name end
    end
end
table.sort(DB.insertable)

function DB.super(name)
    local r = DB.raw[name]
    if r then return (r.super ~= "" and r.super) or nil end
    return "Instance"
end

function DB.chain(name)
    local c = DB.chainCache[name]
    if c then return c end
    c = {}
    local n, guard = name, 0
    while n and guard < 40 do
        c[#c + 1] = n
        n = DB.super(n)
        guard = guard + 1
    end
    DB.chainCache[name] = c
    return c
end

function DB.isA(class, ancestor)
    for _, n in ipairs(DB.chain(class)) do
        if n == ancestor then return true end
    end
    return false
end

local function ownProps(name)
    local p = DB.parsed[name]
    if p then return p end
    p = {}
    local r = DB.raw[name]
    if r and r.props ~= "" then
        for item in r.props:gmatch("[^;]+") do
            local pn, ci, ti, fl = item:match("^([^,]+),(%d+),(%d+),?(.*)$")
            if pn then
                p[#p + 1] = { name = pn, cat = DB.cats[tonumber(ci) + 1] or "Data",
                    type = DB.types[tonumber(ti) + 1] or "string", ro = (fl == "r"), from = name }
            end
        end
    end
    DB.parsed[name] = p
    return p
end

-- semua properti sebuah class (termasuk turunan dari class induk), per nama
function DB.props(class)
    local c = DB.propCache[class]
    if c then return c end
    c = {}
    local seen = {}
    for _, n in ipairs(DB.chain(class)) do
        for _, p in ipairs(ownProps(n)) do
            if not seen[p.name] then
                seen[p.name] = true
                c[#c + 1] = p
            end
        end
    end
    DB.propCache[class] = c
    return c
end

DB.isService = function(name)
    local r = DB.raw[name]
    return r ~= nil and r.flags:find("s", 1, true) ~= nil
end

