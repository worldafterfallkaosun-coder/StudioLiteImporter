local function specText(s) if type(s.text) == "function" then return s.text() end return s.text end

local function buildButton(parent, spec, x, y, big)
    local label = specText(spec)
    local w = big and math.max(52, textWidth(label, 12) + 16) or math.max(86, textWidth(label, 12) + 40 + (spec.menu and 10 or 0))
    local b
    if big then
        b = btn(parent, { Position = UDim2.fromOffset(x, 3), Size = UDim2.fromOffset(w, 66) })
        corner(b, 6)
        local ic = new("Frame", { Position = UDim2.new(0.5, -14, 0, 5), Size = UDim2.fromOffset(28, 28), BackgroundTransparency = 1, Active = false }, b)
        spec.icon(ic, 28)
        local l = lbl(b, { Position = UDim2.fromOffset(0, 38), Size = U2(1, 0, 0, 24), Text = label, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center,
            TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Active = false })
        spec._lbl = l
        if spec.menu then tri(b, "down", T.textDim, 5, { Position = U2(0.5, 0, 1, -5) }) end
    else
        b = btn(parent, { Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, 21) })
        corner(b, 5)
        local ic = new("Frame", { Position = UDim2.fromOffset(5, 2), Size = UDim2.fromOffset(17, 17), BackgroundTransparency = 1, Active = false }, b)
        spec.icon(ic, 17)
        local l = lbl(b, { Position = UDim2.fromOffset(27, 0), Size = UDim2.new(1, -30, 1, 0), Text = label, TextSize = 12, Active = false,
            TextTruncate = Enum.TextTruncate.AtEnd })
        spec._lbl = l
        if spec.menu then tri(b, "down", T.textDim, 4, { Position = U2(1, -8, 0.5, 0) }) end
    end
    hoverable(b)
    spec._btn = b
    on(b.MouseButton1Click, function()
        if spec.dis and spec.dis() then return end
        UI.closeMenus()
        if spec.menu and big then
            -- tombol besar dengan menu: klik = aksi utama, panah/klik di bawah = menu
            local mp = UIS:GetMouseLocation()
            local ap, as = b.AbsolutePosition, b.AbsoluteSize
            if mp.Y > ap.Y + as.Y * 0.62 or not spec.fn then
                UI.dropdown(b, spec.menu(), { minW = 190 })
                return
            end
        elseif spec.menu then
            UI.dropdown(b, spec.menu(), { minW = 190 })
            return
        end
        if spec.fn then spec.fn(b) end
        RB.refresh()
    end)
    if spec.rfn then
        on(b.InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton2 then spec.rfn() RB.refresh() end
        end)
    end
    RB.paints[#RB.paints + 1] = function()
        local dis = spec.dis and spec.dis()
        local act = spec.on and spec.on()
        setOn(b, act and true or false)
        local alpha = dis and 0.55 or 0
        for _, d in ipairs(b:GetDescendants()) do
            if d:IsA("TextLabel") then
                d.TextTransparency = alpha
                if type(spec.text) == "function" and d == spec._lbl then d.Text = spec.text() end
            elseif d:IsA("Frame") and d.BackgroundTransparency < 0.99 and d.Parent ~= b then
                -- ikon: biarkan
            end
        end
    end
    return w
end

function RB.buildTabs(parent)
    local defs = RB.defs()
    RB.defsT = defs
    -- baris tab
    local tabRow = frame(parent, { Name = "TabRow", Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = T.topbar })
    frame(tabRow, { Position = U2(0, 0, 1, -1), Size = U2(1, 0, 0, 1), BackgroundColor3 = T.line })
    local file = btn(tabRow, { Position = UDim2.fromOffset(6, 3), Size = UDim2.fromOffset(52, 24), BackgroundTransparency = 0, BackgroundColor3 = T.accent })
    corner(file, 5)
    lbl(file, { Size = U2(1, 0, 1, 0), Text = "File", TextXAlignment = Enum.TextXAlignment.Center, Font = FONTM, TextSize = 13, TextColor3 = T.accentText })
    on(file.MouseButton1Click, function() RB.fileMenu(file) end)
    local x = 68
    RB.tabBtns = {}
    for _, name in ipairs(RB.TABS) do
        local w = textWidth(name, 13) + 22
        local b = btn(tabRow, { Position = UDim2.fromOffset(x, 3), Size = UDim2.fromOffset(w, 24) })
        corner(b, 5)
        local l = lbl(b, { Size = U2(1, 0, 1, 0), Text = name, TextXAlignment = Enum.TextXAlignment.Center, Font = FONTM, TextSize = 12 })
        RB.tabBtns[name] = { b = b, l = l }
        on(b.MouseButton1Click, function()
            UI.closeMenus()
            if SS.tab == name and not SS.ribbonCollapsed then
                -- klik tab aktif: tidak apa-apa
            end
            SS.tab = name
            if SS.ribbonCollapsed then RB.collapse(false) end
            RB.paintTabs()
            RB.showTab()
            saveSS()
        end)
        x = x + w + 2
    end
    -- kanan: undo, redo, importer
    local right = new("Frame", { AnchorPoint = V2(1, 0), Position = U2(1, -6, 0, 3), Size = UDim2.fromOffset(250, 24), BackgroundTransparency = 1 }, tabRow)
    local function smallIcon(xx, kind, fn, tip)
        local b = btn(right, { Position = UDim2.fromOffset(xx, 0), Size = UDim2.fromOffset(26, 24) })
        corner(b, 5)
        local ic = new("Frame", { Position = UDim2.fromOffset(3, 1), Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1, Active = false }, b)
        RB.glyph(ic, kind, 20)
        hoverable(b)
        on(b.MouseButton1Click, fn)
        return b
    end
    RB.undoB = smallIcon(0, "undo", function() HIST.undo() end)
    RB.redoB = smallIcon(30, "redo", function() HIST.redo() end)
    local imp = btn(right, { Position = UDim2.fromOffset(64, 0), Size = UDim2.fromOffset(100, 24), BackgroundTransparency = 0, BackgroundColor3 = T.panelHead })
    corner(imp, 12)
    stroke(imp, T.lineStrong, 1)
    lbl(imp, { Size = U2(1, 0, 1, 0), Text = "Importer", TextXAlignment = Enum.TextXAlignment.Center, Font = FONTM, TextSize = 12 })
    on(imp.MouseButton1Click, function() openImporter() end)
    local gearB = smallIcon(172, "gear", function() RB.gearMenu(RB.gearBtn) end)
    RB.gearBtn = gearB
    local col = smallIcon(202, "window", function() RB.collapse(not SS.ribbonCollapsed) end)

    -- isi ribbon
    local body = frame(parent, { Name = "RibbonBody", Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 84), BackgroundColor3 = T.ribbon })
    frame(body, { Position = U2(0, 0, 1, -1), Size = U2(1, 0, 0, 1), BackgroundColor3 = T.line })
    RB.body = body
    RB.pages = {}
    for _, name in ipairs(RB.TABS) do
        local page = new("ScrollingFrame", { Name = name, Size = U2(1, 0, 1, -1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 0,
            CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollingDirection = Enum.ScrollingDirection.X, Visible = false }, body)
        local px = 6
        for _, group in ipairs(defs[name] or {}) do
            local gx = px
            for _, col in ipairs(group.cols) do
                if col.big then
                    px = px + buildButton(page, col, px, 0, true) + 2
                else
                    local widest = 0
                    for i, spec in ipairs(col) do
                        local w = buildButton(page, spec, px, 3 + (i - 1) * 22, false)
                        if w > widest then widest = w end
                    end
                    -- samakan lebar
                    for _, spec in ipairs(col) do spec._btn.Size = UDim2.fromOffset(widest, 21) end
                    px = px + widest + 2
                end
            end
            lbl(page, { Position = UDim2.fromOffset(gx, 68), Size = UDim2.fromOffset(math.max(px - gx, 40), 14), Text = group.name, TextSize = 11, TextColor3 = T.textDim,
                TextXAlignment = Enum.TextXAlignment.Center })
            px = px + 4
            frame(page, { Position = UDim2.fromOffset(px, 6), Size = UDim2.fromOffset(1, 70), BackgroundColor3 = T.line })
            px = px + 6
        end
        RB.pages[name] = page
    end
    RB.paintTabs()
    RB.showTab()
end

function RB.paintTabs()
    for name, o in pairs(RB.tabBtns) do
        local act = (SS.tab == name)
        o.b.BackgroundTransparency = act and 0 or 1
        o.b.BackgroundColor3 = T.tabActive
        o.l.TextColor3 = act and T.text or T.textDim
    end
end

function RB.showTab()
    if not RB.pages then return end
    if not RB.pages[SS.tab] then SS.tab = "HOME" end
    for name, p in pairs(RB.pages) do p.Visible = (name == SS.tab) end
    RB.refresh()
end

function RB.refresh()
    for _, fn in ipairs(RB.paints) do pcall(fn) end
    if RB.undoB then
        local canU, canR = #HIST.undoStack > 0, #HIST.redoStack > 0
        RB.undoB.Active = canU
        RB.redoB.Active = canR
    end
end

