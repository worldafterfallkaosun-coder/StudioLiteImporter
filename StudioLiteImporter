local CMD = { history = {}, hi = 0 }

function CMD.run(text)
    text = tostring(text or "")
    if text:match("^%s*$") then return end
    CMD.history[#CMD.history + 1] = text
    CMD.hi = #CMD.history + 1
    OUT.add("> " .. text, "dim")
    if not loadstring then
        OUT.add("Executor tidak punya loadstring.", "err")
        return
    end
    local sel = {}
    for i, v in ipairs(SEL.list) do sel[i] = v end
    local f = loadstring("local selection = ... return " .. text)
    if not f then
        local f2, err = loadstring("local selection = ...\n" .. text)
        if not f2 then
            OUT.add(tostring(err), "err")
            return
        end
        f = f2
    end
    task.spawn(function()
        local res = table.pack(pcall(f, sel))
        if not res[1] then
            OUT.add(tostring(res[2]), "err")
        else
            for i = 2, res.n do
                local v = res[i]
                local s = (typeof(v) == "Instance") and v:GetFullName() or tostring(v)
                OUT.add("= " .. s, "ok")
            end
        end
    end)
end

function CMD.build(parent)
    local box = frame(parent, { Position = UDim2.fromOffset(6, 3), Size = UDim2.new(1, -12, 1, -6), BackgroundColor3 = T.input })
    corner(box, 5)
