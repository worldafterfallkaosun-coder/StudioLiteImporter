local function splitter(vertical, onMove, onEnd)
    local s = new("TextButton", { Name = "Splitter", BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 6, BorderSizePixel = 0 }, UI.frame)
