    -- reset = pencarian baru; more = halaman berikutnya
    function H.toolboxRefresh(reset, more)
        paintToolboxBar()
        if tbs.view ~= "results" then
            renderCards()
            return
        end
        if reset then
            tbs.items, tbs.cursor, tbs.page, tbs.more, tbs.err, tbs.sel = {}, nil, 0, false, nil, nil
        elseif not more then
            renderCards()
            return
        end
        if tbs.loading then return end
        tbs.started = true
        tbs.loading = true
        tbs.token = tbs.token + 1
        local tok = tbs.token
        renderCards()
        task.spawn(function()
            local items, nextCursor, err = TB.search(tbs.cat, tbs.query, TB.SORTS[tbs.sortIdx].v, tbs.cursor, tbs.page)
            if tok ~= tbs.token or not alive() then return end
            tbs.loading = false
            if not items then
                tbs.err = tostring(err)
                renderCards()
                return
            end
            local have = {}
            for _, it in ipairs(tbs.items) do have[it.id] = true end
            for _, it in ipairs(items) do
                if not have[it.id] then tbs.items[#tbs.items + 1] = it end
            end
            tbs.cursor = nextCursor
            tbs.page = tbs.page + 1
            tbs.more = (nextCursor ~= nil) or (#items >= CONFIG.ToolboxPageSize)
            renderCards()
        end)
    end

