function RB.applyLayout()
    if not UI.frame or not P.ex then return end
    local sz = UI.size()
    local W, H = sz.X, sz.Y
    local topH = SS.ribbonCollapsed and 30 or 114
    RB.top.Size = UDim2.new(1, 0, 0, topH)
    RB.body.Visible = not SS.ribbonCollapsed
    local statusH, cmdH = 22, SS.cmd and 28 or 0
    local y0 = topH
    local yBot = H - statusH - cmdH
    local availH = math.max(100, yBot - y0)
    local maxSide = math.floor(W * 0.4)
    local lw = SS.tb and math.clamp(SS.lw, 190, maxSide) or 0
    local rw = (SS.ex or SS.pr) and math.clamp(SS.rw, 190, maxSide) or 0
    local midW = math.max(60, W - lw - rw)
    local bh = SS.out and math.clamp(SS.bh, 90, math.floor(availH * 0.6)) or 0
    local exH = (SS.ex and SS.pr) and math.floor(availH * SS.exFrac) or (SS.ex and availH or 0)
    local prH = (SS.ex and SS.pr) and (availH - exH) or (SS.pr and availH or 0)

    P.tb.frame.Visible = SS.tb
    P.tb.frame.Position, P.tb.frame.Size = UDim2.fromOffset(0, y0), UDim2.fromOffset(lw, availH)
    P.ex.frame.Visible = SS.ex
    P.ex.frame.Position, P.ex.frame.Size = UDim2.fromOffset(W - rw, y0), UDim2.fromOffset(rw, exH)
    P.pr.frame.Visible = SS.pr
    P.pr.frame.Position, P.pr.frame.Size = UDim2.fromOffset(W - rw, y0 + exH), UDim2.fromOffset(rw, prH)
    P.out.frame.Visible = SS.out
    P.out.frame.Position, P.out.frame.Size = UDim2.fromOffset(lw, yBot - bh), UDim2.fromOffset(midW, bh)
    P.cmd.Visible = SS.cmd
    P.cmd.Position, P.cmd.Size = UDim2.fromOffset(0, yBot), UDim2.fromOffset(W, cmdH)
    P.status.Position, P.status.Size = UDim2.fromOffset(0, H - statusH), UDim2.fromOffset(W, statusH)

    SP.l.Visible = SS.tb
    SP.l.Position, SP.l.Size = UDim2.fromOffset(lw - 3, y0), UDim2.fromOffset(6, availH)
    SP.r.Visible = (SS.ex or SS.pr)
    SP.r.Position, SP.r.Size = UDim2.fromOffset(W - rw - 3, y0), UDim2.fromOffset(6, availH)
    SP.b.Visible = SS.out
    SP.b.Position, SP.b.Size = UDim2.fromOffset(lw, yBot - bh - 3), UDim2.fromOffset(midW, 6)
    SP.m.Visible = SS.ex and SS.pr
    SP.m.Position, SP.m.Size = UDim2.fromOffset(W - rw, y0 + exH - 3), UDim2.fromOffset(rw, 6)
    if ACT.edLayout then ACT.edLayout(lw, y0, midW, math.max(60, availH - bh)) end
    ED.geo = { W = W, H = H, y0 = y0, yBot = yBot, availH = availH, lw = lw, rw = rw }
end

function ACT.relayout()
    if UI.frame and P.ex then RB.applyLayout() end
end

function RB.togglePanel(key)
    SS[key] = not SS[key]
    RB.applyLayout()
    RB.refresh()
    saveSS()
end

function RB.collapse(on)
    SS.ribbonCollapsed = on and true or false
    RB.applyLayout()
    RB.refresh()
    saveSS()
end

function RB.resetLayout()
    for k, v in pairs(DEFAULTS) do SS[k] = v end
    SS.uiScale = nil
    saveSS()
    RB.rebuild()
end

function RB.setTheme(name)
    CONFIG.StudioTheme = name
    E.saveSettings()
    RB.rebuild()
end

function RB.toggleTheme() RB.setTheme(T.name == "dark" and "light" or "dark") end

function RB.toggleUi()
    ST.uiHidden = not ST.uiHidden
    if UI.root then UI.root.Enabled = not ST.uiHidden end
    if ED.mini then ED.mini.Enabled = ST.uiHidden end
    if ST.uiHidden then UI.closeMenus() end
end

