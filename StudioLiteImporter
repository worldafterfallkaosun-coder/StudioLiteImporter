-- UI mendaftarkan callback di sini; engine hanya memanggil lewat fire()
local H = {}
local function fire(name, ...)
    local f = H[name]
    if f then
        local ok, err = pcall(f, ...)
        if not ok then warn("[SLImporter] hook " .. name .. ": " .. tostring(err)) end
    end
end

local function logLine(text, kind)
    local line = { t = os.date("%H:%M:%S"), text = tostring(text), kind = kind or "info" }
    S.log[#S.log + 1] = line
    if #S.log > 300 then table.remove(S.log, 1) end
    fire("log", line)
end

local function setStatus(text, kind)
    fire("status", text, kind or "info")
end

local function notify(text, kind)
    logLine(text, kind)
    setStatus(text, kind)
    fire("toast", text, kind or "info")
end

local function fmtBytes(n)
    if n < 1024 then return n .. " B" end
    if n < 1048576 then return string.format("%.1f KB", n / 1024) end
    return string.format("%.2f MB", n / 1048576)
end

