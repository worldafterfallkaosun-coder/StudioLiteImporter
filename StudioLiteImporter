function ACT.expandAll(inst, on)
    local function rec(i, depth)
        if depth > 60 then return end
        local kc = kidsOf2(i)
        if #kc > 0 then ST.expanded[i] = on and true or nil end
        if on and depth > 6 then return end
        for _, c in ipairs(kc) do rec(c, depth + 1) end
    end
    if inst then
        rec(inst, 0)
    else
        ST.expanded = setmetatable({}, { __mode = "k" })
        if on then
            for _, r in ipairs(serviceRoots()) do ST.expanded[r] = true end
        end
    end
    EX.dirty = true
end

local function sectionItems(parent)
