-- Color picker (HSV) — onChange(color, final)
-- ---------------------------------------------------------------
function UI.colorPicker(initial, onChange, title)
    local M = UI.modal(272, 318, title or "Color")
    local scope = {}
    M.dim.Destroying:Connect(function()
        for _, c in ipairs(scope) do pcall(function() c:Disconnect() end) end
    end)
    local h, s, v = initial:ToHSV()
    local col = initial
    local body = M.body

    local svBox = new("Frame", { Position = UDim2.fromOffset(14, 10), Size = UDim2.fromOffset(244, 150), BackgroundColor3 = Color3.fromHSV(h, 1, 1),
        BorderSizePixel = 0, Active = true }, body)
    corner(svBox, 4)
    local white = new("Frame", { Size = U2(1, 0, 1, 0), BackgroundColor3 = rgb(255, 255, 255), BorderSizePixel = 0, Active = false }, svBox)
    corner(white, 4)
    new("UIGradient", { Transparency = NumberSequence.new(0, 1) }, white)
    local black = new("Frame", { Size = U2(1, 0, 1, 0), BackgroundColor3 = rgb(0, 0, 0), BorderSizePixel = 0, Active = false }, svBox)
    corner(black, 4)
    new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0) }, black)
    local knob = new("Frame", { AnchorPoint = V2(0.5, 0.5), Size = UDim2.fromOffset(12, 12), BackgroundTransparency = 1, Active = false }, svBox)
    corner(knob, 6)
    stroke(knob, rgb(255, 255, 255), 2)

    local hueBar = new("Frame", { Position = UDim2.fromOffset(14, 168), Size = UDim2.fromOffset(244, 14), BackgroundColor3 = rgb(255, 255, 255),
        BorderSizePixel = 0, Active = true }, body)
    corner(hueBar, 4)
    local kp = {}
    for i = 0, 6 do kp[#kp + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6 % 1 == 0 and (i == 6 and 0.9999 or 0) or i / 6, 1, 1)) end
    new("UIGradient", { Color = ColorSequence.new(kp) }, hueBar)
    local hueKnob = new("Frame", { AnchorPoint = V2(0.5, 0.5), Position = U2(0, 0, 0.5, 0), Size = UDim2.fromOffset(6, 18), BackgroundColor3 = rgb(255, 255, 255),
        BorderSizePixel = 0, Active = false }, hueBar)
    corner(hueKnob, 3)
    stroke(hueKnob, rgb(60, 60, 70), 1)

    local newSw = frame(body, { Position = UDim2.fromOffset(14, 196), Size = UDim2.fromOffset(40, 40), BackgroundColor3 = col })
    corner(newSw, 5)
    stroke(newSw, T.lineStrong, 1)
    local oldSw = frame(body, { Position = UDim2.fromOffset(58, 196), Size = UDim2.fromOffset(24, 40), BackgroundColor3 = initial })
    corner(oldSw, 5)
    stroke(oldSw, T.lineStrong, 1)
    local fields = {}
    local function field(label, x, w, yy)
        lbl(body, { Position = UDim2.fromOffset(x, yy - 14), Size = UDim2.fromOffset(w, 12), Text = label, TextSize = 11, TextColor3 = T.textDim,
            TextXAlignment = Enum.TextXAlignment.Center })
        local f = frame(body, { Position = UDim2.fromOffset(x, yy), Size = UDim2.fromOffset(w, 24), BackgroundColor3 = T.input })
        corner(f, 4)
        stroke(f, T.inputLine, 1)
        local tb = new("TextBox", { Size = U2(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", ClearTextOnFocus = false, TextColor3 = T.text,
            Font = FONT, TextSize = 13, BorderSizePixel = 0 }, f)
        return tb
    end
    fields.r = field("R", 94, 50, 212)
    fields.g = field("G", 148, 50, 212)
    fields.b = field("B", 202, 56, 212)
    fields.hex = field("Hex", 94, 164, 250)
    fields.hex.TextXAlignment = Enum.TextXAlignment.Center
    fields.r.TextXAlignment, fields.g.TextXAlignment, fields.b.TextXAlignment = Enum.TextXAlignment.Center, Enum.TextXAlignment.Center, Enum.TextXAlignment.Center

    local function r255(x) return math.floor(x * 255 + 0.5) end
    local function sync(fromFields)
        col = Color3.fromHSV(h, s, v)
        svBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        knob.Position = U2(s, 0, 1 - v, 0)
        hueKnob.Position = U2(h, 0, 0.5, 0)
        newSw.BackgroundColor3 = col
        if not fromFields then
            fields.r.Text, fields.g.Text, fields.b.Text = tostring(r255(col.R)), tostring(r255(col.G)), tostring(r255(col.B))
            fields.hex.Text = string.format("#%02X%02X%02X", r255(col.R), r255(col.G), r255(col.B))
        end
        if onChange then onChange(col, false) end
    end
    local function setColor(c3)
        h, s, v = c3:ToHSV()
        sync(false)
    end
    local function bump(rel, box)
        return math.clamp((rel.X) / math.max(1, box.AbsoluteSize.X), 0, 1), math.clamp((rel.Y) / math.max(1, box.AbsoluteSize.Y), 0, 1)
    end
    dragArea(svBox, function(p)
        local fx, fy = bump(p - svBox.AbsolutePosition, svBox)
        s, v = fx, 1 - fy
        sync(false)
    end, nil, nil, scope)
    dragArea(hueBar, function(p)
        local fx = bump(p - hueBar.AbsolutePosition, hueBar)
        h = math.min(fx, 0.9999)
        sync(false)
    end, nil, nil, scope)
    for _, key in ipairs({ "r", "g", "b" }) do
        on(fields[key].FocusLost, function()
            local r = tonumber(fields.r.Text) or r255(col.R)
            local g = tonumber(fields.g.Text) or r255(col.G)
            local b = tonumber(fields.b.Text) or r255(col.B)
            setColor(rgb(math.clamp(r, 0, 255), math.clamp(g, 0, 255), math.clamp(b, 0, 255)))
        end)
    end
    on(fields.hex.FocusLost, function()
        local hx = fields.hex.Text:match("#?(%x%x%x%x%x%x)")
        if hx then
            setColor(rgb(tonumber(hx:sub(1, 2), 16), tonumber(hx:sub(3, 4), 16), tonumber(hx:sub(5, 6), 16)))
        else
            sync(false)
        end
    end)
    on(oldSw.InputBegan, function(input) if isPress(input) then setColor(initial) end end)

    local ok = pillButton(body, "OK", true, { Position = U2(1, -186, 1, -42), Size = UDim2.fromOffset(84, 28) })
    local cancel = pillButton(body, "Cancel", false, { Position = U2(1, -96, 1, -42), Size = UDim2.fromOffset(84, 28) })
    local finished = false
    local function finish(apply)
        if finished then return end
        finished = true
        if not apply and onChange then onChange(initial, false) end
        if onChange then onChange(apply and col or initial, true) end
        M.close()
    end
    on(ok.MouseButton1Click, function() finish(true) end)
    on(cancel.MouseButton1Click, function() finish(false) end)
    -- klik di luar kotak = OK
    on(M.dim.InputBegan, function(input)
        if isPress(input) and not finished then
            local p = pointer(input)
            local ap, as = M.box.AbsolutePosition, M.box.AbsoluteSize
            if p.X < ap.X or p.Y < ap.Y or p.X > ap.X + as.X or p.Y > ap.Y + as.Y then finish(true) end
        end
    end)
    sync(false)
    return M
end

