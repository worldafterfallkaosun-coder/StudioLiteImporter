local OUT = { lines = {}, filter = "all", rowH = 18, auto = true, search = "" }

local function lineColor(kind)
    if kind == "err" then return T.err end
    if kind == "warn" then return T.warn end
    if kind == "ok" then return T.ok end
    if kind == "dim" then return T.textDim end
    return T.text
end

function OUT.add(text, kind, stamp)
    local lines = OUT.lines
    lines[#lines + 1] = { text = tostring(text), kind = kind or "info", t = stamp or os.date("%H:%M:%S") }
    if #lines > 700 then table.remove(lines, 1) end
    OUT.dirty = true
end

function OUT.visible()
    local out = {}
    local q = OUT.search:lower()
    for _, l in ipairs(OUT.lines) do
        local pass = true
        if OUT.filter == "warn" then pass = (l.kind == "warn")
        elseif OUT.filter == "err" then pass = (l.kind == "err")
        elseif OUT.filter == "msg" then pass = (l.kind ~= "warn" and l.kind ~= "err") end
        if pass and q ~= "" and not l.text:lower():find(q, 1, true) then pass = false end
        if pass then out[#out + 1] = l end
    end
    return out
end

function OUT.flush()
    if not OUT.L then return end
    OUT.dirty = false
    OUT.shown = OUT.visible()
    OUT.L.setCount(#OUT.shown)
    if OUT.auto and #OUT.shown > 0 then
        OUT.L.sf.CanvasPosition = V2(0, math.max(0, #OUT.shown * OUT.rowH - OUT.L.sf.AbsoluteSize.Y / UI.sc))
        OUT.L.refresh(true)
    end
end

