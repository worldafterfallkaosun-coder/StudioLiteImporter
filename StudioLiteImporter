local function importModelFile(entry, target, placeState)
    local objs, how, data = loadFile(entry.raw)
    if not objs then return false, how end
    local roots, perr = parseOrNil(data)
    return finishImport(objs, roots, entry.name, how, target, { placeState = placeState, parseErr = perr })
end

-- ---- Place (.rbxl / .rbxlx) ----
local function nodeChildrenOfClass(roots, class, used)
    for i, n in ipairs(roots) do
        if not used[i] and n.class == class then
            used[i] = true
            return n.children
        end
    end
    return nil
end

local function importPlaceFile(entry, target, placeState)
    local objs, how, data = loadFile(entry.raw)
    if not objs then return false, how end
    local roots, perr = parseOrNil(data)

    -- kelompok: { svc = nama service, objs = {instance}, nodes = {node} | nil }
    local groups = {}
    local function addGroup(svc, list, nodes)
        local fo, fn = {}, nil
        for _, o in ipairs(list) do
            if not PLACE_SKIP[o.ClassName] then fo[#fo + 1] = o end
        end
        if nodes then
            fn = {}
            for _, n in ipairs(nodes) do
                if not PLACE_SKIP[n.class] then fn[#fn + 1] = n end
            end
        end
        if #fo > 0 then groups[#groups + 1] = { svc = svc, objs = fo, nodes = fn } end
    end

    local hasServiceObjs = false
    for _, o in ipairs(objs) do
        if SERVICE_CLASS[o.ClassName] then hasServiceObjs = true break end
    end

    if hasServiceObjs then
        local used = {}
        for _, o in ipairs(objs) do
            if SERVICE_CLASS[o.ClassName] then
                addGroup(o.ClassName, o:GetChildren(), roots and nodeChildrenOfClass(roots, o.ClassName, used) or nil)
            else
                addGroup("(lainnya)", { o }, nil)
            end
        end
    else
        local allServices = roots ~= nil and #roots > 0
        local total = 0
        if allServices then
            for _, n in ipairs(roots) do
                if not SERVICE_CLASS[n.class] then allServices = false break end
                total = total + #n.children
            end
        end
        if allServices and total == #objs then
            local idx = 1
            for _, n in ipairs(roots) do
                local slice = {}
                for i = 1, #n.children do
                    slice[#slice + 1] = objs[idx]
                    idx = idx + 1
                end
                addGroup(n.class, slice, n.children)
            end
        else
            addGroup("(isi place)", objs, nil)
        end
    end
    if #groups == 0 then return false, "place tidak berisi objek yang bisa diimpor (hanya Camera/Terrain?)" end

    local added, allScripts, lines = {}, {}, {}
    local totalObjs, okGroups = 0, 0
    local wrapper
    if CONFIG.PlaceMode ~= "merge" then
        wrapper = Instance.new("Folder")
        wrapper.Name = entry.base
        wrapper.Parent = target
        added[#added + 1] = wrapper
    end

    local anyStats = { ok = 0, fail = 0, notes = {}, firstReason = nil }
    for _, g in ipairs(groups) do
        local dest
        if wrapper then
            dest = Instance.new("Folder")
            dest.Name = g.svc
            dest.Parent = wrapper
        elseif MERGE_SERVICE[g.svc] then
            dest = game:GetService(g.svc)
        else
            dest = Instance.new("Folder")
            dest.Name = g.svc .. " (place)"
            dest.Parent = target
            added[#added + 1] = dest
        end
        local okc, ok, msg, gAdded, gScripts, gStats = pcall(finishImport, g.objs, g.nodes, entry.name .. " [" .. g.svc .. "]",
            how, dest, { placeState = placeState, noPlace = true, parseErr = (g == groups[1]) and perr or nil })
        if okc and ok then
            okGroups = okGroups + 1
            totalObjs = totalObjs + #gAdded
            if not wrapper then
                for _, o in ipairs(gAdded) do added[#added + 1] = o end
            end
            for _, s in ipairs(gScripts) do allScripts[#allScripts + 1] = s end
            anyStats.ok = anyStats.ok + gStats.ok
            anyStats.fail = anyStats.fail + gStats.fail
            anyStats.firstReason = anyStats.firstReason or gStats.firstReason
            lines[#lines + 1] = msg
            logLine(msg, "info")
        else
            lines[#lines + 1] = g.svc .. ": " .. tostring(okc and msg or ok)
            logLine(entry.name .. " [" .. g.svc .. "]: " .. tostring(okc and msg or ok), "warn")
        end
    end

    local summary = string.format("%s -> %s: %d grup, %d objek (via %s, mode %s), teks script %d/%d",
        entry.name, X.pathOf(target), okGroups, totalObjs, how, wrapper and "folder" or "merge",
        anyStats.ok, #allScripts)
    if anyStats.fail > 0 then summary = summary .. " (gagal: " .. tostring(anyStats.firstReason) .. ")" end
    summary = summary .. " | posisi asli dipertahankan; Terrain/Camera dilewati"
    return totalObjs > 0, summary, added, allScripts, anyStats
end

-- ---- Gambar lokal -> Decal / ImageLabel ----
local FACES = { "Front", "Back", "Left", "Right", "Top", "Bottom" }
local function faceList(name)
    if name == "All" then return FACES end
    return { name }
end

local function localAsset(entry)
    local getAsset = getcustomasset or getsynasset
    if not getAsset then return nil, "executor tidak punya getcustomasset (aset lokal tidak bisa dimuat)" end
    local ok, asset = pcall(getAsset, entry.raw)
    if not ok or type(asset) ~= "string" or asset == "" then
        return nil, "gagal membuat aset lokal: " .. tostring(asset)
    end
    return asset
end

local function withNote(msg)
    if not S.warnedLocal then
        S.warnedLocal = true
        return msg .. " | catatan: " .. LOCAL_NOTE
    end
    return msg
end

-- buat host decal: part papan (anchored) yang menghadap kamera. return part
local function makeBoardPart(base, texture, w, h, target, placeState)
    local longest = 8
    local sx, sy
    if w >= h then
        sx, sy = longest, math.max(0.5, longest * h / w)
    else
        sy, sx = longest, math.max(0.5, longest * w / h)
    end
    local part = Instance.new("Part")
    part.Name = base
    part.Anchored = true
    part.Size = Vector3.new(sx, sy, 0.2)
    local d = Instance.new("Decal")
    d.Name = base
    d.Texture = texture
    d.Face = Enum.NormalId.Front
    d.Parent = part
    local cam = workspace.CurrentCamera
    if cam and isWorld(target) and CONFIG.SpawnInFrontOfCamera then
        placeState = placeState or { offset = 0 }
        local c = cam.CFrame
        local pos = c.Position + c.LookVector * 25 + c.RightVector * (placeState.offset + sx / 2)
        placeState.offset = placeState.offset + sx + 4
        part.CFrame = CFrame.lookAt(pos, c.Position)
    end
    part.Parent = target
    return part
end

-- terapkan texture ke host: BasePart terpilih (Studio Lite) / target part / papan baru.
-- return: added (list), keterangan
local function applyTexture(base, texture, w, h, target, placeState)
    local added = {}
    local parts = {}
    local okS, sel = pcall(SEL.read)
    if okS and type(sel) == "table" then
        for _, i in ipairs(sel) do
            if i:IsA("BasePart") and not isProtected(i) then parts[#parts + 1] = i end
        end
    end
    if #parts == 0 and target:IsA("BasePart") and not isProtected(target) then parts = { target } end

    if #parts > 0 then
        for _, p in ipairs(parts) do
            for _, f in ipairs(faceList(CONFIG.DecalFace)) do
                local d = Instance.new("Decal")
                d.Name = base
                d.Texture = texture
                d.Face = Enum.NormalId[f]
                d.Parent = p
                added[#added + 1] = d
            end
        end
        return added, string.format("decal di %d part (sisi %s)", #parts, CONFIG.DecalFace)
    end
    local part = makeBoardPart(base, texture, w, h, target, placeState)
    added[1] = part
    return added, "papan decal baru"
end

local function importImageFile(entry, target, placeState)
    local asset, err = localAsset(entry)
    if not asset then return false, err end
    local w, h
    if readfile then
        local okr, d = pcall(readfile, entry.raw)
        if okr and type(d) == "string" then w, h = imageSize(d) end
    end
    w, h = w or 256, h or 256

    local guiTarget = target:IsA("GuiObject") or target:IsA("LayerCollector")
    if CONFIG.ImageMode == "gui" or guiTarget then
        local added = {}
        local host = target
        if not guiTarget then
            local sg = Instance.new("ScreenGui")
            sg.Name = entry.base
            sg.ResetOnSpawn = false
            sg.Parent = target
            added[#added + 1] = sg
            host = sg
        end
        local lab = Instance.new("ImageLabel")
        lab.Name = entry.base
        lab.BackgroundTransparency = 1
        lab.Image = asset
        local k = math.min(1, 300 / math.max(w, h))
        lab.Size = UDim2.fromOffset(math.max(8, math.floor(w * k)), math.max(8, math.floor(h * k)))
        lab.Parent = host
        if host == target then added[#added + 1] = lab end
        return true, withNote(string.format("%s -> %s: ImageLabel %dx%d", entry.name, X.pathOf(target), w, h)),
            added, {}, EMPTY_STATS()
    end

    local added, how = applyTexture(entry.base, asset, w, h, target, placeState)
    return true, withNote(string.format("%s -> %s: %s (%dx%d)", entry.name, X.pathOf(target), how, w, h)),
        added, {}, EMPTY_STATS()
end

-- ---- Audio lokal -> Sound ----
local function makeSound(name, soundId, parent)
    local s = Instance.new("Sound")
    s.Name = name
    s.SoundId = soundId
    s.Volume = 0.5
    s.Parent = parent
    return s
end

local function importAudioFile(entry, target)
    local asset, err = localAsset(entry)
    if not asset then return false, err end
    local s = makeSound(entry.base, asset, target)
    return true, withNote(string.format("%s -> %s: Sound", entry.name, X.pathOf(target))), { s }, {}, EMPTY_STATS()
end

-- ---- Dispatcher ----
-- entry: tabel entri scanner { raw, name, base, kind, ... } -> ok, pesan, added, scripts, stats
local function doImport(entry, opts, placeState)
    local target = opts.target
    if typeof(target) ~= "Instance" or not target:IsDescendantOf(game) then
        return false, "target import tidak ditemukan (dihapus?), pilih ulang di tab Explorer"
    end
    local kind = entry.kind or "model"
    if kind == "place" then return importPlaceFile(entry, target, placeState) end
    if kind == "image" then return importImageFile(entry, target, placeState) end
    if kind == "audio" then return importAudioFile(entry, target) end
    return importModelFile(entry, target, placeState)
end

-- ---- Batch import ----
function E.runBatch(list)
    if S.busy then notify("Masih ada proses berjalan.", "warn") return end
    if #list == 0 then notify("Belum ada file dipilih.", "warn") return end
    local tinst = E.getTarget()
    if not tinst then
        notify("Target import tidak ditemukan: " .. S.target .. ". Pilih ulang di tab Explorer.", "err")
        return
    end
    local tlabel = X.pathOf(tinst)
    X.pushRecent(tinst)
    S.busy, S.cancel = true, false
    fire("busy", true)

    local function body()
        local total = #list
        local batch = { objs = {}, target = tlabel, count = total }
        local okN, failN, objN, scriptN = 0, 0, 0, 0
        local placeState = { offset = 0 }
        local allScripts = {}
        local report = {
            "# Import log " .. os.date("%Y-%m-%d %H:%M:%S"),
            "target: " .. tlabel, "file: " .. total, "",
        }
        logLine(string.format("Batch dimulai: %d file -> %s", total, tlabel), "info")

        for i, e in ipairs(list) do
            if S.cancel or not alive() then
                logLine(string.format("Dibatalkan sebelum file %d/%d", i, total), "warn")
                break
            end
            S.status[e.path] = "busy"
            fire("progress", (i - 1) / total, string.format("Import %d/%d: %s", i, total, e.name))
            fire("rows")
            task.wait()

            local okc, ok, msg, added, scripts, stats = pcall(doImport, e,
                { target = E.getTarget() or tinst }, placeState)
            if not okc then
                msg = tostring(ok)
                ok = false
            end

            if ok then
                S.status[e.path], S.reason[e.path] = "ok", nil
                S.selected[e.path] = nil
                okN = okN + 1
                for _, o in ipairs(added) do batch.objs[#batch.objs + 1] = o end
                objN = objN + #added
                scriptN = scriptN + #scripts
                for _, s in ipairs(scripts) do
                    s.file = e.name
                    allScripts[#allScripts + 1] = s
                end
                logLine(msg, "ok")
                report[#report + 1] = "[OK] " .. msg
                for j, s in ipairs(scripts) do
                    report[#report + 1] = string.format("    (%d) %s [%s] %d byte -> %s",
                        j, s.path, s.class, #s.source, tostring(stats.notes[j] or "teks tidak dipasang"))
                end
            else
                S.status[e.path], S.reason[e.path] = "fail", tostring(msg)
                failN = failN + 1
                logLine(e.name .. ": " .. tostring(msg), "err")
                report[#report + 1] = "[GAGAL] " .. e.name .. ": " .. tostring(msg)
            end
            fire("progress", i / total, string.format("Selesai %d/%d", i, total))
            fire("selection")
            fire("rows")
            task.wait()
        end

        if #batch.objs > 0 then
            S.history[#S.history + 1] = batch
            if #S.history > 20 then table.remove(S.history, 1) end
        end
        if #allScripts > 0 then
            S.scriptList, S.scriptIdx = allScripts, 0
        end
        if writefile then
            ensureFolder()
            pcall(writefile, CONFIG.Folder .. "/import_log.txt", table.concat(report, "\n"))
        end

        local summary = string.format("Batch selesai: %d berhasil, %d gagal | %d objek, %d script",
            okN, failN, objN, scriptN)
        if S.cancel then summary = "Batch dibatalkan. " .. summary end
        notify(summary, failN > 0 and (okN > 0 and "warn" or "err") or "ok")
        if okN > 0 and CONFIG.AutoHideAfterImport then fire("autohide") end
    end

    task.spawn(function()
        local ok, err = pcall(body)
        if not ok then notify("Error batch: " .. tostring(err), "err") end
        S.busy, S.cancel = false, false
        fire("busy", false)
        fire("progress", 0, "")
        fire("history")
        fire("selection")
        fire("rows")
    end)
end

function E.cancel()
    if S.busy then
        S.cancel = true
        setStatus("Membatalkan setelah file ini selesai...", "warn")
    end
end

-- ---- Undo ----
function E.undo(all)
    if S.busy then return end
    local n, batches = 0, 0
    while #S.history > 0 do
        local b = table.remove(S.history)
        for _, o in ipairs(b.objs) do
            if o and o.Parent then
                pcall(function() o:Destroy() end)
                n = n + 1
            end
        end
        batches = batches + 1
        if not all then break end
    end
    if batches == 0 then
        notify("Tidak ada batch yang bisa di-undo.", "warn")
    else
        notify(string.format("Undo %d batch: %d objek dihapus.", batches, n), "info")
    end
    fire("history")
end

-- ---- Salin script (clipboard) ----
function E.copyNextScript()
    local n = #S.scriptList
    if n == 0 then notify("Belum ada script dari import terakhir.", "warn") return end
    S.scriptIdx = S.scriptIdx % n + 1
    local s = S.scriptList[S.scriptIdx]
    local clip = setclipboard or toclipboard
    if s.source == "" then
        notify(string.format("Source %s kosong / tidak terbaca (%d/%d).", s.path, S.scriptIdx, n), "err")
    elseif not clip then
        notify("Executor tidak punya setclipboard. Ambil dari folder scripts_out.", "err")
    elseif pcall(clip, s.source) then
        notify(string.format("Disalin: %s [%s] (%d/%d)", s.path, s.class, S.scriptIdx, n), "ok")
    else
        notify("Gagal menyalin ke clipboard.", "err")
    end
end

