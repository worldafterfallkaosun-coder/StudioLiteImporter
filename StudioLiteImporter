local function tri(parent, dir, color, s, props)
    local f = new("Frame", {
        AnchorPoint = V2(0.5, 0.5), Size = UDim2.fromOffset(s, s), BackgroundColor3 = color,
        BorderSizePixel = 0, Rotation = TRI_ROT[dir] or 45, Active = false,
    }, parent)
    new("UIGradient", { Transparency = TRI_SEQ, Rotation = 45 }, f)
    for k, v in pairs(props or {}) do f[k] = v end
    return f
end

