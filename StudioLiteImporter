        return make("UIStroke", {
            Color = color, Thickness = th or 1, Transparency = tr or 0,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        }, o)
    end
    local function tween(o, t, props, style)
        TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
    end
    local function label(parent, props)
        local base = {
            BackgroundTransparency = 1, TextColor3 = T.text, Font = Enum.Font.Gotham,
            TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, BorderSizePixel = 0,
