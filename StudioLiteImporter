function E.insertAsset(item)
    if TB.busy or S.busy then notify("Masih ada proses berjalan.", "warn") return end
    local target = E.getTarget()
    if not target then notify("Target import tidak ditemukan. Pilih di tab Explorer.", "err") return end
    X.pushRecent(target)
    TB.busy = true
    fire("toolbox")
    task.spawn(function()
        local okc, ok, msg, added = pcall(TB.insert, item, target, { offset = 0 })
        if not okc then ok, msg = false, tostring(ok) end
        if ok and added and #added > 0 then
            S.history[#S.history + 1] = { objs = added, target = X.pathOf(target), count = 1 }
            if #S.history > 20 then table.remove(S.history, 1) end
            TB.pushRecent(item)
