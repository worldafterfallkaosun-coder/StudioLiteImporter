-- Naikkan identity thread sebelum kode UI dijalankan.
local fixIdentity
do
    local f = (syn and syn.set_thread_identity) or setthreadidentity or set_thread_identity
        or setidentity or setthreadcontext or set_thread_context
    fixIdentity = function()
        if f then pcall(f, 8) end
    end
end

local function bind(signal, fn)
    local c = signal:Connect(function(...)
        fixIdentity()
        return fn(...)
    end)
    conns[#conns + 1] = c
    return c
end

