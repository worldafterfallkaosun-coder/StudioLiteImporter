-- TOOL: mode Geser / Putar / Skala dengan gizmo (Handles / ArcHandles) seperti Roblox Studio
-- ===================================================================
-- Gizmo = part proxy tak terlihat (di bawah Camera, bukan di Workspace asli supaya tidak ikut
-- tersimpan oleh Save Studio Lite) + Handles/ArcHandles di GUI host. Semua perubahan lewat
-- riwayat (HIST) sehingga bisa di-undo / redo.

TOOL.mode = "select"
TOOL.MOVE_SNAPS = { 0, 0.1, 0.25, 0.5, 1, 2, 4, 8 }
TOOL.ROT_SNAPS = { 0, 1, 5, 15, 45, 90 }
TOOL.SCALE_SNAPS = { 0, 0.1, 0.25, 0.5, 1 }
TOOL.MODES = { "select", "move", "scale", "rotate" }
TOOL.MODE_LABEL = { select = "Pilih", move = "Geser", scale = "Skala", rotate = "Putar" }

local gz = { proxy = nil, gui = nil, handles = nil, hconns = {}, dragging = false, states = nil, startCF = nil, startSize = nil, built = nil }

local function snapVal(v, step)
    if not step or step <= 0 then return v end
    return math.floor(v / step + 0.5) * step
end
TOOL.snapVal = snapVal

local function gizmoHost()
    if gz.gui and gz.gui.Parent then return gz.gui end
    local sg = Instance.new("ScreenGui")
    sg.Name = "SLGizmoGui"
    sg.ResetOnSpawn = false
    sg.DisplayOrder = 997
    pcall(function() sg:SetAttribute("SL_Gizmo", true) end)
    local parented = false
    if CoreGuiSvc then parented = pcall(function() sg.Parent = CoreGuiSvc end) and sg.Parent ~= nil end
    if not parented and gethui then
        local okh, h = pcall(gethui)
        if okh and h then parented = pcall(function() sg.Parent = h end) and sg.Parent ~= nil end
    end
    if not parented then sg.Parent = LocalPlayer:WaitForChild("PlayerGui") end
    gz.gui = sg
    return sg
end

local function ensureProxy()
    if gz.proxy and gz.proxy.Parent then return gz.proxy end
    local p = Instance.new("Part")
    p.Name = "__SLGizmo"
    p.Anchored = true
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    p.CastShadow = false
    p.Transparency = 1
    p.Locked = true
    p.Size = Vector3.new(2, 2, 2)
    pcall(function() p:SetAttribute("SL_Gizmo", true) end)
    p.Parent = workspace.CurrentCamera or workspace
    gz.proxy = p
    return p
end

local function dropHandles()
    for _, c in ipairs(gz.hconns) do pcall(function() c:Disconnect() end) end
    gz.hconns = {}
    if gz.handles then pcall(function() gz.handles:Destroy() end) end
    gz.handles = nil
    gz.built = nil
    gz.dragging = false
end

function TOOL.destroy()
    dropHandles()
    if gz.proxy then pcall(function() gz.proxy:Destroy() end) end
    if gz.gui then pcall(function() gz.gui:Destroy() end) end
    gz.proxy, gz.gui = nil, nil
end

local function beginDrag()
    local items = xformItems(SEL.list)
    gz.items = items
    gz.states = captureState(items)
    gz.startCF = gz.proxy.CFrame
    gz.startSize = gz.proxy.Size
    gz.dragging = true
end

local function endDrag(name)
    if not gz.dragging then return end
    gz.dragging = false
    if gz.states and gz.items then
        OPS.commitTransform(name, gz.states, captureState(gz.items))
    end
    gz.states, gz.items = nil, nil
    TOOL.update()
end

local function bindHandle(sig, fn)
    gz.hconns[#gz.hconns + 1] = sig:Connect(function(...)
        local ok, err = pcall(fn, ...)
        if not ok then logLine("Gizmo: " .. tostring(err), "err") end
    end)
end

-- ---- Geser ----
local function onMoveDrag(face, dist)
    if not gz.dragging then return end
    local d = snapVal(dist, CONFIG.MoveSnap)
    local dir = gz.startCF:VectorToWorldSpace(Vector3.FromNormalId(face))
    local delta = dir * d
    for _, st in ipairs(gz.states) do setPivotOf(st.inst, st.pivot + delta) end
    gz.proxy.CFrame = gz.startCF + delta
end

-- ---- Putar ----
local function onRotDrag(axis, angle)
    if not gz.dragging then return end
    local a = angle * (CONFIG.RotateInvert and -1 or 1)
    if CONFIG.RotSnap and CONFIG.RotSnap > 0 then a = snapVal(a, math.rad(CONFIG.RotSnap)) end
    local axisW = gz.startCF:VectorToWorldSpace(Vector3.FromAxis(axis))
    local center = gz.startCF.Position
    local rot = CFrame.fromAxisAngle(axisW, a)
    local around = CFrame.new(center) * rot * CFrame.new(-center)
    for _, st in ipairs(gz.states) do setPivotOf(st.inst, around * st.pivot) end
    if TOOL.space == "local" then
        gz.proxy.CFrame = around * gz.startCF
    end
end

-- ---- Skala ----
local MIN_SIZE, MAX_SIZE = 0.05, 2048

local function clampSize(v)
    return Vector3.new(math.clamp(v.X, MIN_SIZE, MAX_SIZE), math.clamp(v.Y, MIN_SIZE, MAX_SIZE), math.clamp(v.Z, MIN_SIZE, MAX_SIZE))
end

local function onScaleDrag(face, dist)
    if not gz.dragging then return end
    local n = Vector3.FromNormalId(face)
    local d = snapVal(dist, CONFIG.ScaleSnap)
    local single = gz.states[1]
    -- satu BasePart tanpa mode seragam: tarik satu sisi, sisi seberang tetap
    if #gz.states == 1 and single.size and not single.scale and not CONFIG.UniformScale then
        local absN = Vector3.new(math.abs(n.X), math.abs(n.Y), math.abs(n.Z))
        local base = single.size.X * absN.X + single.size.Y * absN.Y + single.size.Z * absN.Z
        local newLen = math.clamp(base + d, MIN_SIZE, MAX_SIZE)
        local real = newLen - base
        single.inst.Size = clampSize(single.size + absN * real)
        single.inst.CFrame = single.pivot * CFrame.new(n * (real / 2))
        gz.proxy.CFrame = gz.startCF * CFrame.new(n * (real / 2))
        gz.proxy.Size = single.inst.Size
        return
    end
    -- selain itu: faktor seragam (Model:ScaleTo menjaga weld / mesh / attachment tetap utuh)
    local absN = Vector3.new(math.abs(n.X), math.abs(n.Y), math.abs(n.Z))
    local extent = math.max(gz.startSize.X * absN.X + gz.startSize.Y * absN.Y + gz.startSize.Z * absN.Z, 0.5)
    local f = math.clamp((extent + d) / extent, 0.02, 100)
    local center = gz.startCF.Position
    for _, st in ipairs(gz.states) do
        if st.scale and st.inst:IsA("Model") then
            pcall(function() st.inst:ScaleTo(st.scale * f) end)
        end
        if st.size and st.inst:IsA("BasePart") then
            st.inst.Size = clampSize(st.size * f)
        end
        local pos = st.pivot.Position
        local newPos = center + (pos - center) * f
        setPivotOf(st.inst, CFrame.new(newPos) * (st.pivot - pos))
    end
    gz.proxy.Size = clampSize(gz.startSize * f)
end

local function allFaces()
    return Faces.new(Enum.NormalId.Right, Enum.NormalId.Left, Enum.NormalId.Top, Enum.NormalId.Bottom, Enum.NormalId.Front, Enum.NormalId.Back)
end

local function buildHandles(mode)
    dropHandles()
    if mode == "select" then return end
    local host, proxy = gizmoHost(), ensureProxy()
    local h
    if mode == "rotate" then
        h = Instance.new("ArcHandles")
        h.Axes = Axes.new(Enum.Axis.X, Enum.Axis.Y, Enum.Axis.Z)
        h.Color3 = Color3.fromRGB(255, 170, 60)
        bindHandle(h.MouseButton1Down, function() beginDrag() end)
        bindHandle(h.MouseDrag, function(axis, angle) onRotDrag(axis, angle) end)
        bindHandle(h.MouseButton1Up, function() endDrag("Putar") end)
    else
        h = Instance.new("Handles")
        h.Faces = allFaces()
        if mode == "move" then
            h.Style = Enum.HandlesStyle.Movement
            h.Color3 = Color3.fromRGB(80, 160, 255)
            bindHandle(h.MouseButton1Down, function() beginDrag() end)
            bindHandle(h.MouseDrag, function(face, dist) onMoveDrag(face, dist) end)
            bindHandle(h.MouseButton1Up, function() endDrag("Geser") end)
        else
            h.Style = Enum.HandlesStyle.Resize
            h.Color3 = Color3.fromRGB(90, 220, 140)
            bindHandle(h.MouseButton1Down, function() beginDrag() end)
            bindHandle(h.MouseDrag, function(face, dist) onScaleDrag(face, dist) end)
            bindHandle(h.MouseButton1Up, function() endDrag("Skala") end)
        end
    end
    h.Name = "SL_" .. mode
    h.Adornee = proxy
    h.Parent = host
    gz.handles = h
    gz.built = mode
end

-- sinkronkan gizmo dengan seleksi + mode. Aman dipanggil kapan saja.
function TOOL.update()
    if not alive() then return end
    if gz.dragging then return end
    if TOOL.mode == "select" then
        if gz.handles then dropHandles() end
        if gz.proxy then pcall(function() gz.proxy.Parent = nil end) end
        return
    end
    local items = xformItems(SEL.list)
    if #items == 0 then
        if gz.handles then gz.handles.Visible = false end
        return
    end
    local cf, size = gizmoFrame(items, TOOL.space)
    if not cf then
        if gz.handles then gz.handles.Visible = false end
        return
    end
    local proxy = ensureProxy()
    if proxy.Parent == nil then proxy.Parent = workspace.CurrentCamera or workspace end
    proxy.Size = Vector3.new(math.max(size.X, 0.5), math.max(size.Y, 0.5), math.max(size.Z, 0.5))
    proxy.CFrame = cf
    if gz.built ~= TOOL.mode or not gz.handles then buildHandles(TOOL.mode) end
    if gz.handles then gz.handles.Visible = true end
end

function TOOL.setMode(mode)
    if not table.find(TOOL.MODES, mode) then return end
    TOOL.mode = mode
    if mode ~= "select" then pcall(SEL.refresh) end
    TOOL.update()
    fire("tool")
    PLG.emit("tool", mode)
end

function TOOL.setSpace(space)
    TOOL.space = (space == "local") and "local" or "global"
    CONFIG.ToolSpace = TOOL.space
    E.saveSettings()
    TOOL.update()
    fire("tool")
end

function TOOL.cycleSnap(kind, dir)
    local list = (kind == "rot") and TOOL.ROT_SNAPS or (kind == "scale") and TOOL.SCALE_SNAPS or TOOL.MOVE_SNAPS
    local key = (kind == "rot") and "RotSnap" or (kind == "scale") and "ScaleSnap" or "MoveSnap"
    local idx = table.find(list, CONFIG[key]) or 1
    idx = ((idx - 1 + (dir or 1)) % #list) + 1
    CONFIG[key] = list[idx]
    E.saveSettings()
    fire("tool")
end

function TOOL.snapText(kind)
    if kind == "rot" then return (CONFIG.RotSnap > 0) and (CONFIG.RotSnap .. "°") or "off" end
    local v = (kind == "scale") and CONFIG.ScaleSnap or CONFIG.MoveSnap
    return (v > 0) and tostring(v) or "off"
end

