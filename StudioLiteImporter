        c.toggle = button(head, "Aktifkan", T.ok, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(76, 28), TextSize = 11 })
        c.reload = button(head, "Reload", T.panel2, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -90, 0.5, 0), Size = UDim2.fromOffset(52, 28), TextSize = 11, Visible = false })
        c.err = label(card, { Size = UDim2.new(1, -20, 0, 28), Position = UDim2.fromOffset(10, 0), TextSize = 10, TextColor3 = T.err, TextWrapped = true,
            TextYAlignment = Enum.TextYAlignment.Top, Visible = false, LayoutOrder = 2 })
        c.body = make("Frame", { Size = UDim2.new(1, -16, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 3 }, card)
        make("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, c.body)
        local pad = make("UIPadding", { PaddingLeft = UDim.new(0, 8) }, c.body)
        pCards[p.key] = c
        bind(c.toggle.MouseButton1Click, function()
            if p.loaded then
                PLG.disable(p)
                return
            end
            if not PLG.enabled[p.key] and not (confirmKey == p.key and os.clock() - confirmAt < 4) then
                confirmKey, confirmAt = p.key, os.clock()
                c.toggle.Text = "Yakin?"
                task.delay(4, function()
                    if alive() and confirmKey == p.key then
                        confirmKey = nil
                        paintPluginCard(p)
                    end
                end)
                setStatus("Plugin berjalan dengan hak executor penuh. Tap \"Yakin?\" sekali lagi jika kamu mempercayainya.", "warn")
                return
            end
            confirmKey = nil
            PLG.enable(p)
        end)
        bind(c.reload.MouseButton1Click, function() PLG.load(p) end)
