local function pillButton(parent, text, primary, props)
    local b = btn(parent, props)
    b.BackgroundTransparency = 0
    b.BackgroundColor3 = primary and T.accent or T.panelHead
    corner(b, 5)
    if not primary then stroke(b, T.lineStrong, 1) end
    lbl(b, { Size = U2(1, 0, 1, 0), Text = text, TextXAlignment = Enum.TextXAlignment.Center, Font = FONTM, TextSize = 13,
        TextColor3 = primary and T.accentText or T.text })
    return b
end
UI.pillButton = pillButton

function UI.prompt(title, label, default, cb, opts)
    opts = opts or {}
    local M = UI.modal(360, 150, title)
    lbl(M.body, { Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -28, 0, 18), Text = label or "", TextColor3 = T.textDim, TextSize = 13 })
    local tbf = frame(M.body, { Position = UDim2.fromOffset(14, 30), Size = UDim2.new(1, -28, 0, 30), BackgroundColor3 = T.input })
    corner(tbf, 5)
    stroke(tbf, T.inputLine, 1)
    local tb = new("TextBox", { Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -16, 1, 0), BackgroundTransparency = 1,
        Text = tostring(default or ""), PlaceholderText = opts.placeholder or "", ClearTextOnFocus = false, TextColor3 = T.text,
        PlaceholderColor3 = T.textDim, Font = FONT, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, BorderSizePixel = 0 }, tbf)
    local done = false
    local function submit()
        if done then return end
        done = true
        local text = tb.Text
        M.close()
        if cb then task.defer(function() local ok, e = pcall(cb, text) if not ok then logLine("Prompt: " .. tostring(e), "err") end end) end
    end
    local ok = pillButton(M.body, opts.okText or "OK", true, { Position = U2(1, -186, 1, -44), Size = UDim2.fromOffset(84, 30) })
    local cancel = pillButton(M.body, "Cancel", false, { Position = U2(1, -96, 1, -44), Size = UDim2.fromOffset(84, 30) })
    on(ok.MouseButton1Click, submit)
    on(cancel.MouseButton1Click, M.close)
    on(tb.FocusLost, function(enter) if enter then submit() end end)
    task.defer(function() pcall(function() tb:CaptureFocus() end) end)
    return M
end

function UI.confirm(title, text, cb, okText)
    local M = UI.modal(380, 150, title)
    lbl(M.body, { Position = UDim2.fromOffset(16, 10), Size = UDim2.new(1, -32, 0, 56), Text = text, TextWrapped = true,
