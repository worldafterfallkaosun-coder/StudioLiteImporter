    task.spawn(function()
        local okc, ok, msg = pcall(doImport, path)
        if not okc then
            setStatus("Error: " .. tostring(ok), ERR)
        else
            setStatus(msg, ok and OK or ERR)
        end
        updateCopyBtn()
        busy = false
    end)
end)

undoBtn.MouseButton1Click:Connect(function()
    local n = 0
    for _, obj in ipairs(lastImported) do
        if obj and obj.Parent then
            pcall(function() obj:Destroy() end)
            n = n + 1
        end
    end
    lastImported = {}
    setStatus(n .. " objek import terakhir dihapus.", INFO)
end)

targetBtn.MouseButton1Click:Connect(function()
    targetIndex = targetIndex % #TARGETS + 1
    targetBtn.Text = "Target: " .. TARGETS[targetIndex]
end)

scriptBtn.MouseButton1Click:Connect(function()
    CONFIG.DisableScripts = not CONFIG.DisableScripts
    refreshScriptBtn()
end)

refreshBtn.MouseButton1Click:Connect(refreshList)
closeBtn.MouseButton1Click:Connect(function() gui:Destroy() end)

-- drag lewat title bar (mouse & touch)
do
    local dragging, dragStart, startPos = false, nil, nil
    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
            local d = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

