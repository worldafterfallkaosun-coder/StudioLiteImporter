PLG.dir = CONFIG.Folder .. "/plugins"
PLG.list, PLG.byKey, PLG.enabled = {}, {}, {}
PLG.handlers = { selection = {}, import = {}, tool = {}, unload = {} }

function PLG.enabledLoad(t)
    PLG.enabled = {}
    if type(t) == "table" then
        for k, v in pairs(t) do
            if type(k) == "string" and v == true then PLG.enabled[k] = true end
        end
    end
end

function PLG.emit(name, ...)
    local hs = PLG.handlers[name]
    if not hs or #hs == 0 then return end
    local copy = { table.unpack(hs) }
    for _, h in ipairs(copy) do
        local ok, err = pcall(h.fn, ...)
        if not ok then logLine("[plugin " .. h.p.key .. "] " .. name .. ": " .. tostring(err), "err") end
    end
end

local function readMeta(src, key)
    local meta = { name = key, version = "", author = "", desc = "" }
    local n = 0
    for line in (src:sub(1, 2000) .. "\n"):gmatch("([^\r\n]*)[\r\n]") do
        n = n + 1
        if n > 25 then break end
        local k, v = line:match("^%-%-@(%w+)%s+(.-)%s*$")
        if k and meta[k:lower()] ~= nil then meta[k:lower()] = v end
    end
    return meta
end

function PLG.scan()
    if not (listfiles and isfolder) then
        notify("Executor tidak punya listfiles; plugin tidak bisa dipindai.", "warn")
        return
    end
    if makefolder and not isfolder(PLG.dir) then pcall(makefolder, PLG.dir) end
    local ok, files = pcall(listfiles, PLG.dir)
    if not ok or type(files) ~= "table" then return end
    local found = {}
    for _, raw in ipairs(files) do
        local path = (tostring(raw):gsub("\\", "/"))
        local name = path:match("([^/]+)$") or path
        local low = name:lower()
        if low:match("%.lua$") or low:match("%.luau$") or low:match("%.txt$") then
            local p = PLG.byKey[name] or { key = name, loaded = false }
            p.path, p.raw = path, raw
            local src = ""
            if readfile then
                local okr, d = pcall(readfile, raw)
                if okr and type(d) == "string" then src = d end
            end
            p.meta = readMeta(src, name)
            p.size = #src
            PLG.byKey[name] = p
            found[#found + 1] = p
        end
    end
    table.sort(found, function(a, b) return a.key:lower() < b.key:lower() end)
    PLG.list = found
    fire("plugins")
end

local function storagePath(p)
    return PLG.dir .. "/_data/" .. (p.key:gsub("[^%w_%-%.]", "_")) .. ".json"
end

local function makeApi(p)
    local api = { version = "5.0", name = p.meta.name or p.key }
    p.conns, p.mine = {}, {}

    function api.notify(text, kind) notify("[" .. api.name .. "] " .. tostring(text), kind or "info") end
    function api.log(text) logLine("[" .. api.name .. "] " .. tostring(text), "info") end

    api.selection = {
        get = function() local o = {} for i, v in ipairs(SEL.list) do o[i] = v end return o end,
        refresh = function() SEL.refresh() local o = {} for i, v in ipairs(SEL.list) do o[i] = v end return o end,
        set = function(list) SEL.set(list or {}) end,
    }
    api.ops = {
        anchor = function(m) return OPS.setBool("Anchored", m or "toggle") end,
        canCollide = function(m) return OPS.setBool("CanCollide", m or "toggle") end,
        canTouch = function(m) return OPS.setBool("CanTouch", m or "toggle") end,
        canQuery = function(m) return OPS.setBool("CanQuery", m or "toggle") end,
        group = OPS.group, ungroup = OPS.ungroup, delete = OPS.delete, duplicate = OPS.duplicate,
        freeze = OPS.freezeSel, restoreAnchors = OPS.restoreAnchors,
        setPosition = OPS.setPosition, setRotation = OPS.setRotation, setSize = OPS.setSize,
    }
    api.history = { push = HIST.push, undo = HIST.undo, redo = HIST.redo }
    api.tools = {
        setMode = TOOL.setMode, getMode = function() return TOOL.mode end,
        setSpace = TOOL.setSpace, getSpace = function() return TOOL.space end,
        setSnap = function(kind, v)
            local key = (kind == "rot") and "RotSnap" or (kind == "scale") and "ScaleSnap" or "MoveSnap"
            if type(v) == "number" and v >= 0 then CONFIG[key] = v E.saveSettings() fire("tool") end
        end,
        getSnap = function(kind)
            return CONFIG[(kind == "rot") and "RotSnap" or (kind == "scale") and "ScaleSnap" or "MoveSnap"]
        end,
    }
    api.target = { get = E.getTarget, set = E.setTarget }
    api.insertAsset = function(id, kind)
        local n = TB.parseId(id)
        if n then E.insertAsset({ id = n, kind = kind or "model", name = "Asset " .. n }) end
    end
    api.importFile = function(path)
        local entry = makeEntry(path)
        if entry then E.runBatch({ entry }) else notify("Format file tidak dikenali: " .. tostring(path), "warn") end
    end

    function api.on(event, fn)
        local hs = PLG.handlers[event]
        if not hs or type(fn) ~= "function" then return function() end end
        local h = { p = p, fn = fn }
        hs[#hs + 1] = h
        p.mine[#p.mine + 1] = { list = hs, h = h }
        return function()
            local i = table.find(hs, h)
            if i then table.remove(hs, i) end
        end
    end
    function api.connect(signal, fn)
        local c = signal:Connect(fn)
        p.conns[#p.conns + 1] = c
        return c
    end

    api.storage = {
        get = function(key)
            if not (isfile and readfile) then return nil end
            local okf, exists = pcall(isfile, storagePath(p))
            if not (okf and exists) then return nil end
            local okr, raw = pcall(readfile, storagePath(p))
            local t = okr and jsonDecode(raw)
            return t and t[key]
        end,
        set = function(key, value)
            if not writefile then return false end
            if makefolder and isfolder and not isfolder(PLG.dir .. "/_data") then pcall(makefolder, PLG.dir .. "/_data") end
            local t = {}
            if isfile and readfile and isfile(storagePath(p)) then
                local okr, raw = pcall(readfile, storagePath(p))
                t = (okr and jsonDecode(raw)) or {}
            end
            t[key] = value
            local okj, json = pcall(function() return HttpService:JSONEncode(t) end)
            return okj and pcall(writefile, storagePath(p), json)
        end,
    }
    api.ui = {
        button = function(text, cb) return H.pluginButton and H.pluginButton(p, tostring(text), cb) or nil end,
        panel = function(height) return H.pluginPanel and H.pluginPanel(p, tonumber(height) or 80) or nil end,
    }
    return api
end

function PLG.unload(p)
    if not p.loaded then return end
    for _, m in ipairs(p.mine or {}) do
        local i = table.find(m.list, m.h)
        if i then table.remove(m.list, i) end
    end
    for _, c in ipairs(p.conns or {}) do pcall(function() c:Disconnect() end) end
    if p.api and p.api._unload then pcall(p.api._unload) end
    if H.pluginClear then pcall(H.pluginClear, p) end
    p.loaded, p.api, p.conns, p.mine = false, nil, nil, nil
    fire("plugins")
end

function PLG.load(p)
    if p.loaded then PLG.unload(p) end
    p.err = nil
    if not (readfile and loadstring) then
        p.err = "executor tidak punya readfile / loadstring"
        fire("plugins")
        return false
    end
    local okr, src = pcall(readfile, p.raw or p.path)
    if not okr or type(src) ~= "string" then
        p.err = "file tidak bisa dibaca"
        fire("plugins")
        return false
    end
    local fn, err = loadstring("local SL, plugin = ...\n" .. src, "=" .. p.key)
    if not fn then
        p.err = tostring(err)
        logLine("[plugin " .. p.key .. "] syntax: " .. p.err, "err")
        fire("plugins")
        return false
    end
    local api = makeApi(p)
    p.api, p.loaded = api, true
    function api.onUnload(f) api._unload = f end
    task.spawn(function()
        local ok, e = pcall(fn, api, api)
        if not ok then
            p.err = tostring(e)
            logLine("[plugin " .. p.key .. "] error: " .. p.err, "err")
            PLG.unload(p)
            p.err = tostring(e)
            fire("plugins")
        else
            logLine("Plugin dimuat: " .. api.name, "ok")
        end
    end)
    fire("plugins")
    return true
end

function PLG.enable(p)
    PLG.enabled[p.key] = true
    E.saveSettings()
    return PLG.load(p)
end

function PLG.disable(p)
    PLG.enabled[p.key] = nil
    E.saveSettings()
    PLG.unload(p)
end

function PLG.loadEnabled()
    for _, p in ipairs(PLG.list) do
        if PLG.enabled[p.key] and not p.loaded then PLG.load(p) end
    end
end

function PLG.save(name, src)
    if not writefile then return false, "executor tidak punya writefile" end
    name = tostring(name or ""):gsub("[^%w_%-%.]", "_")
    if name == "" then name = "plugin" end
    if not name:lower():match("%.lua$") then name = name .. ".lua" end
    if makefolder and isfolder and not isfolder(PLG.dir) then pcall(makefolder, PLG.dir) end
    local ok, err = pcall(writefile, PLG.dir .. "/" .. name, src)
    if not ok then return false, tostring(err) end
    PLG.scan()
    return true, name
end

