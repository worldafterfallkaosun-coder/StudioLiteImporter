-- Pilih objek lewat klik di viewport
-- ---------------------------------------------------------------
local function sameList(a, b)
    if #a ~= #b then return false end
    for i = 1, #a do if a[i] ~= b[i] then return false end end
    return true
end

local function rayPick(p)
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local ray = cam:ViewportPointToRay(p.X, p.Y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ex = { cam }
    if LocalPlayer and LocalPlayer.Character then ex[#ex + 1] = LocalPlayer.Character end
    params.FilterDescendantsInstances = ex
    local res = workspace:Raycast(ray.Origin, ray.Direction * 3000, params)
    return res and res.Instance
end

local function topModel(part)
    local t = part
    while t.Parent and t.Parent ~= workspace and t.Parent:IsA("Model") do t = t.Parent end
    return t
end

local function viewportClick(v)
    local before = v.before
    task.delay(0.14, function()
        if not UI.frame then return end
        pcall(SEL.refresh)
        if not sameList(SEL.list, before) then return end -- UI asli / plugin sudah menangani seleksi
        local part = rayPick(v.pos)
        local ctrl = UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl)
        if not part or part:IsA("Terrain") then
            if not ctrl then SEL.set({}) end
            return
        end
        local alt = UIS:IsKeyDown(Enum.KeyCode.LeftAlt)
        local target = alt and part or topModel(part)
        if isProtected(target) then return end
        if ctrl then
            local list, found = {}, false
            for _, i in ipairs(SEL.list) do
                if i == target then found = true else list[#list + 1] = i end
            end
            if not found then list[#list + 1] = target end
            SEL.set(list)
        else
            SEL.set({ target })
        end
    end)
end

-- ---------------------------------------------------------------
-- Input global
-- ---------------------------------------------------------------
local function ctrlDown() return UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl) or UIS:IsKeyDown(Enum.KeyCode.LeftMeta) end
local function shiftDown() return UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.RightShift) end

local function hookInput()
    local vp
    bind2(UIS.InputBegan, function(input, gp)
        if input.KeyCode == Enum.KeyCode.RightShift and not UIS:GetFocusedTextBox() then
            RB.toggleUi()
            return
        end
        if ST.uiHidden then return end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if UIS:GetFocusedTextBox() then return end
            local k = input.KeyCode
            local ctrl, shift = ctrlDown(), shiftDown()
            if ctrl and k == Enum.KeyCode.Z then
                if shift then HIST.redo() else HIST.undo() end
            elseif ctrl and k == Enum.KeyCode.Y then HIST.redo()
            elseif ctrl and k == Enum.KeyCode.C then ACT.copy(false)
            elseif ctrl and k == Enum.KeyCode.X then ACT.copy(true)
            elseif ctrl and k == Enum.KeyCode.V then ACT.paste()
            elseif ctrl and k == Enum.KeyCode.D then OPS.duplicate()
            elseif ctrl and k == Enum.KeyCode.G then OPS.group()
            elseif ctrl and k == Enum.KeyCode.U then OPS.ungroup()
            elseif ctrl and shift and k == Enum.KeyCode.X then
                SS.ex = true RB.applyLayout()
                if EX.filterBox then EX.filterBox:CaptureFocus() end
            elseif ctrl and shift and k == Enum.KeyCode.P then
                SS.pr = true RB.applyLayout()
                if PR.filterBox then PR.filterBox:CaptureFocus() end
            elseif ctrl and k == Enum.KeyCode.One then TOOL.setMode("select")
            elseif ctrl and k == Enum.KeyCode.Two then TOOL.setMode("move")
            elseif ctrl and k == Enum.KeyCode.Three then TOOL.setMode("scale")
            elseif ctrl and k == Enum.KeyCode.Four then TOOL.setMode("rotate")
            elseif k == Enum.KeyCode.Delete or k == Enum.KeyCode.Backspace then OPS.delete()
            elseif k == Enum.KeyCode.F2 then ACT.rename()
            elseif k == Enum.KeyCode.F then ACT.zoomTo()
            elseif k == Enum.KeyCode.Escape then
                if #UI.menus > 0 then UI.closeMenus() else OPS.clearSelection() end
            end
            return
        end
        if gp then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if #UI.menus == 0 then
                vp = { pos = pointer(input), t = os.clock(), type = input.UserInputType, before = selList() }
            end
        end
    end)
    bind2(UIS.InputEnded, function(input)
        local v = vp
        if not v or input.UserInputType ~= v.type then return end
        vp = nil
        if ST.uiHidden then return end
        local p = pointer(input)
        if (p - v.pos).Magnitude > 8 or os.clock() - v.t > 0.4 then return end
        viewportClick(v)
    end)
end

-- ---------------------------------------------------------------
-- Build / destroy
-- ---------------------------------------------------------------
local function destroyUi()
    gen = gen + 1
    pcall(ACT.edReset)
    pcall(NV.unlockAll)
    for i = #bc, 1, -1 do
        pcall(function() bc[i]:Disconnect() end)
        bc[i] = nil
    end
    if UI.root then pcall(function() UI.root:Destroy() end) end
    if ED.mini then pcall(function() ED.mini:Destroy() end) end
    UI.root, UI.frame, UI.pop, UI.catcher, ED.mini = nil, nil, nil, nil, nil
    UI.menus, UI.toasts = {}, {}
    RB.paints = {}
    EX.L, PR.L, OUT.L, EX.press, EX.drag, EX.dropRow = nil, nil, nil, nil, nil, nil
    P, SP = {}, {}
    NV.dialog = nil
end

local function build()
    destroyUi()
    setTheme(CONFIG.StudioTheme)
    UI.sc = calcScale()
    local sg = new("ScreenGui", { Name = "SLStudio", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 990,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling })
    pcall(function() sg.ScreenInsets = Enum.ScreenInsets.None end)
    guiHost(sg)
    env.__SLStudioGui = sg
    local root = new("Frame", { Name = "Root", BackgroundTransparency = 1, BorderSizePixel = 0, Size = U2(1 / UI.sc, 0, 1 / UI.sc, 0) }, sg)
    new("UIScale", { Scale = UI.sc }, root)
    UI.root, UI.frame = sg, root
    UI.pop = new("Frame", { Name = "Popups", BackgroundTransparency = 1, BorderSizePixel = 0, Size = U2(1, 0, 1, 0), ZIndex = 50 }, root)

    -- ribbon
    RB.top = frame(root, { Name = "Top", BackgroundColor3 = T.topbar, ZIndex = 3, Active = true })
    RB.buildTabs(RB.top)
    buildStatus()

    -- panel
    P.ex = makePanel("ex", "Explorer")
    P.pr = makePanel("pr", "Properties")
    P.tb = makePanel("tb", "Toolbox")
    P.out = makePanel("out", "Output")
    P.cmd = frame(root, { Name = "Command", BackgroundColor3 = T.panel, ZIndex = 3, Active = true })
    frame(P.cmd, { Size = U2(1, 0, 0, 1), BackgroundColor3 = T.line })
    PR.title = P.pr.title
    EX.build(P.ex.body)
    PR.build(P.pr.body)
    TP.build(P.tb.body)
    OUT.build(P.out.body)
    CMD.build(P.cmd)
    OUT.hookGame()

    -- splitter
    SP.l = splitter(true, function(d) SS.lw = d.X end)
    SP.r = splitter(true, function(d) SS.rw = ED.geo.W - d.X end)
    SP.b = splitter(false, function(d) SS.bh = ED.geo.yBot - d.Y end)
    SP.m = splitter(false, function(d) SS.exFrac = math.clamp((d.Y - ED.geo.y0) / math.max(1, ED.geo.availH), 0.15, 0.85) end)

    -- tombol kecil untuk memunculkan kembali editor (saat disembunyikan)
    local mini = new("ScreenGui", { Name = "SLStudioMini", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 991, Enabled = ST.uiHidden })
    guiHost(mini)
    local mb = new("TextButton", { Position = UDim2.fromOffset(8, 8), Size = UDim2.fromOffset(92, 30), BackgroundColor3 = T.accent, Text = "Studio", TextColor3 = T.accentText,
        Font = FONTM, TextSize = 14, AutoButtonColor = true, BorderSizePixel = 0 }, mini)
    corner(mb, 15)
    on(mb.MouseButton1Click, function() RB.toggleUi() end)
    ED.mini = mini
    if ST.uiHidden then sg.Enabled = false end

    hookInput()
    RB.applyLayout()
    on(root:GetPropertyChangedSignal("AbsoluteSize"), function() RB.applyLayout() end)
    ED.updateStatus()
    RB.refresh()
    do
        local pgN = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
        if pgN then bind2(pgN.ChildAdded, function() task.defer(NV.applyHidden) end) end
    end
    pcall(NV.applyHidden)
    local g = gen
    task.spawn(function()
        local n = 0
        while alive() and g == gen do
            task.wait(0.5)
            n = n + 1
            pcall(RB.refresh)
            pcall(ED.updateStatus)
            pcall(NV.applyHidden)
        end
    end)
end

function RB.rebuild()
    local ok, err = pcall(build)
    if not ok then
        warn("[SLStudio] build gagal: " .. tostring(err))
        logLine("Studio Editor gagal dibangun ulang: " .. tostring(err), "err")
    end
end

-- ---------------------------------------------------------------
-- Hook dari engine
-- ---------------------------------------------------------------
local function startListeners()
    listen("log", function(line) OUT.add(line.text, line.kind, line.t) end)
    listen("status", function(text, kind)
        if P.statusMsg then
            P.statusMsg.Text = tostring(text)
            P.statusMsg.TextColor3 = (kind == "err" and T.err) or (kind == "warn" and T.warn) or (kind == "ok" and T.ok) or T.textDim
        end
    end)
    listen("toast", function(text, kind) UI.toast(tostring(text), kind) end)
    listen("selection2", function()
        if EX.L then pcall(EX.onSelection) end
        if PR.L then pcall(PR.onSelection) end
        pcall(ED.updateStatus)
        pcall(RB.refresh)
    end)
    listen("tool", function() pcall(ED.updateStatus) pcall(RB.refresh) end)
    listen("hist", function() pcall(RB.refresh) end)
    listen("plugins", function() pcall(RB.refresh) end)
end

local function shutdown(restoreNative)
    for _, f in ipairs(ub) do pcall(f) end
    ub = {}
    pcall(NV.close)
    destroyUi()
    pcall(NV.restoreAll)
    env.__SLStudioGui = nil
end

function RB.exitEditor()
    CONFIG.HideNativeUi = false
    shutdown(true)
    local imp = CORE.imp
    if imp then
        pcall(imp.setStudioMode, false)
        pcall(imp.show)
    end
    notify("Studio Editor ditutup. UI asli Studio Lite ditampilkan lagi (jalankan ulang script untuk membuka editor).", "info")
end

-- ---------------------------------------------------------------
-- Start
-- ---------------------------------------------------------------
-- ---------------------------------------------------------------
-- v7: StarterGui preview. ScreenGui di StarterGui tidak tampil sendiri saat mode edit, jadi dibuat klon (tanpa script)
-- di PlayerGui dan disinkronkan. Dimatikan selama ST.playing (Play asli yang menyalin StarterGui sendiri).
-- ---------------------------------------------------------------
do
    local SG = game:GetService("StarterGui")
    local PRE = "SLPreview_"
    local P = { map = {}, dirty = {}, conns = {}, hooked = setmetatable({}, { __mode = "k" }) }
    ST.sgp = P

    local function stripScripts(root)
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("LuaSourceContainer") then pcall(function() d:Destroy() end) end
        end
    end

    local function makeClone(c)
        local okC, cl = pcall(function() return c:Clone() end)
        if not okC or not cl then return nil end
        stripScripts(cl)
        cl.Name = PRE .. c.Name
        pcall(function() cl.ResetOnSpawn = false end)
        pcall(function() cl.Archivable = false end)
        return cl
    end

    local function hook(c)
        if P.hooked[c] then return end
        P.hooked[c] = true
        local key = c:IsA("ScreenGui") and c or "__loose"
        local function m() P.dirty[key] = true end
        local function ignore(d)
            return d:IsA("LuaSourceContainer") or d:FindFirstAncestorWhichIsA("LuaSourceContainer") ~= nil
        end
        local function hookOne(d)
            if ignore(d) then return end
            P.conns[#P.conns + 1] = d.Changed:Connect(m)
        end
        hookOne(c)
        for _, d in ipairs(c:GetDescendants()) do hookOne(d) end
        P.conns[#P.conns + 1] = c.DescendantAdded:Connect(function(d)
            if ignore(d) then return end
            hookOne(d)
            m()
        end)
        P.conns[#P.conns + 1] = c.DescendantRemoving:Connect(function(d)
            if not d:IsA("LuaSourceContainer") then m() end
        end)
    end

    local function destroyAll()
        for k, cl in pairs(P.map) do
            pcall(function() cl:Destroy() end)
            P.map[k] = nil
        end
    end

    local function sync()
        local pg = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
        if not pg then return end
        if ST.playing then
            destroyAll()
            return
        end
        local live, loose = {}, {}
        for _, c in ipairs(SG:GetChildren()) do
            if c:IsA("ScreenGui") then
                live[c] = true
                local cl = P.map[c]
                if P.dirty[c] or not cl or not cl.Parent then
                    if cl then pcall(function() cl:Destroy() end) end
                    P.dirty[c] = nil
                    local nc = makeClone(c)
                    if nc then nc.Parent = pg end
                    P.map[c] = nc
                    hook(c)
                end
            elseif c:IsA("GuiObject") then
                loose[#loose + 1] = c
            end
        end
        if #loose > 0 then
            local cl = P.map.__loose
            if P.dirty.__loose or not cl or not cl.Parent then
                if cl then pcall(function() cl:Destroy() end) end
                P.dirty.__loose = nil
                local host = Instance.new("ScreenGui")
                host.Name = PRE .. "Loose"
                host.ResetOnSpawn = false
                for _, c in ipairs(loose) do
                    local nc = makeClone(c)
                    if nc then nc.Parent = host end
                    hook(c)
                end
                pcall(function() host.Archivable = false end)
                host.Parent = pg
                P.map.__loose = host
            end
        elseif P.map.__loose then
            pcall(function() P.map.__loose:Destroy() end)
            P.map.__loose = nil
        end
        for k, cl in pairs(P.map) do
            if k ~= "__loose" and not live[k] then
                pcall(function() cl:Destroy() end)
                P.map[k] = nil
            end
        end
    end

    local token = {}
    P.token = token
    task.spawn(function()
        while alive() and P.token == token do
            local ok, err = pcall(sync)
            if not ok and not P.errShown then
                P.errShown = true
                logLine("StarterGui preview: " .. tostring(err), "warn")
            end
            task.wait(0.35)
        end
        destroyAll()
    end)

    table.insert(E.onShutdown, function()
        P.token = nil
        destroyAll()
        for _, c in ipairs(P.conns) do pcall(function() c:Disconnect() end) end
    end)
end

table.insert(E.onShutdown, function() shutdown(true) end)
startListeners()
build()
task.defer(function()
    if alive() then
        NV.applyHidden()
        pcall(NV.logGuis)
        setStatus("Studio Editor siap. RightShift = sembunyikan / tampilkan.", "ok")
    end
end)


