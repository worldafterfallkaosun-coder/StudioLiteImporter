-- File & import logic

local function displayName(path)
    return path:match("([^/\\]+)$") or path
end

local function ensureFolder()
    if makefolder and isfolder and not isfolder(CONFIG.Folder) then
        pcall(makefolder, CONFIG.Folder)
    end
end


-- ===== Scanner pintar: rekursif, semua .rbxm / .rbxmx =====

local function normPath(p)
    p = tostring(p):gsub("\\", "/")
    p = p:gsub("^%./", "")
    return p
end

local function splitPath(path)
    local dir, name = path:match("^(.*)/([^/]+)$")
    if not dir then return "", path end
    return dir, name
end

local function extOf(name)
    local low = name:lower()
    if low:sub(-6) == ".rbxmx" then return "rbxmx" end
    if low:sub(-5) == ".rbxm" then return "rbxm" end
    return nil
end

local function isDir(p)
    if not isfolder then return false end
    local ok, r = pcall(isfolder, p)
    return ok and r == true
end

local function makeEntry(raw)
    local path = normPath(raw)
    local dir, name = splitPath(path)
    local ext = extOf(name)
    if not ext then return nil end
    local base = name:gsub("%.[^.]+$", "")
    return {
        raw = raw, path = path, name = name, base = base, dir = dir, ext = ext,
        lname = name:lower(), ldir = dir:lower(), lower = (name .. " " .. dir):lower(),
    }
end

-- return: list entri, info { visited, truncated, err }
local function scanFiles(scope, yieldFn)
    local out, seen = {}, {}
    local info = { visited = 0, truncated = false }
    if not listfiles then
        info.err = "executor ini tidak punya listfiles (ketik path file di kolom cari lalu Enter)"
        return out, info
    end

    local function walk(dir, depth)
        local ok, items = pcall(listfiles, dir)
        if not ok or type(items) ~= "table" then return false end
        for _, raw in ipairs(items) do
            info.visited = info.visited + 1
            if info.visited > CONFIG.MaxEntries then
                info.truncated = true
                return true
            end
            if yieldFn and info.visited % 60 == 0 then yieldFn() end
            local entry = makeEntry(raw)
            if entry then
                if not seen[entry.path] then
                    seen[entry.path] = true
                    out[#out + 1] = entry
                end
            elseif depth < CONFIG.MaxDepth and isDir(raw) then
                local _, folderName = splitPath(normPath(raw))
                if not CONFIG.SkipFolders[folderName:lower()] then
                    walk(raw, depth + 1)
                    if info.truncated then return true end
                end
            end
        end
        return true
    end

    if scope == "all" then
        local ok = walk(".", 0)
        if not ok then ok = walk("", 0) end
        if not ok then
            info.err = "gagal membaca workspace executor"
            scope = "folder"
        end
    end
    if scope == "folder" then
        ensureFolder()
        if not walk(CONFIG.Folder, 0) and not info.err then
            info.err = "gagal membaca folder " .. CONFIG.Folder
        end
    end
    return out, info
end

-- ===== Inspeksi ringan (format, ukuran, jumlah objek & script) =====

local function countTree(nodes)
    local objs, scripts = 0, 0
    local function walk(list)
        for _, n in ipairs(list) do
            objs = objs + 1
            if SCRIPT_CLASSES[n.class] then scripts = scripts + 1 end
            walk(n.children)
        end
    end
    walk(nodes)
    return objs, scripts
end

local function inspectFile(entry)
    if not readfile then return nil, "readfile tidak tersedia" end
    local ok, data = pcall(readfile, entry.raw)
    if not ok or type(data) ~= "string" then return nil, "file tidak bisa dibaca" end
    local info = { size = #data }
    info.binary = data:sub(1, 8) == "<roblox!"
    info.format = info.binary and "RBXM biner" or "RBXMX (XML)"
    if #data > CONFIG.InspectMaxBytes then
        info.skipped = true
        return info
    end
    local okp, roots = pcall(parseTree, data)
    if okp and type(roots) == "table" and roots[1] then
        info.objects, info.scripts = countTree(roots)
        info.roots = #roots
        info.rootClass, info.rootName = roots[1].class, roots[1].name
    else
        info.parseErr = tostring(roots)
    end
    return info
end

-- return: objs, cara, isi file (string / nil)
local function loadFile(path)
    local data
    if readfile then
        local okr, d = pcall(readfile, path)
        if okr and type(d) == "string" then data = d end
    end

    local getAsset = getcustomasset or getsynasset
    local nativeErr = "getcustomasset tidak tersedia"
    if getAsset then
        local ok, res = pcall(function()
            return game:GetObjects(getAsset(path))
        end)
        if ok and type(res) == "table" and #res > 0 then
            return res, "GetObjects", data
        end
        nativeErr = tostring(res)
    end

    if not data then return nil, "gagal baca file (readfile tidak ada / file tidak terbaca)" end
    if data:sub(1, 8) == "<roblox!" then
        return nil, "rbxm biner butuh getcustomasset (" .. nativeErr .. "). Simpan ulang sebagai .rbxmx lalu coba lagi."
    end
    local objs, err = parseRbxmx(data)
    if objs then return objs, "parser rbxmx", data end
    return nil, err
end

-- Kumpulkan teks script. Sumber utama: isi file (XML maupun biner) lewat parseTree,
-- dicocokkan ke instance hasil import. Cadangan kalau file gagal diparse:
-- best effort lewat instance (Source / gethiddenproperty / decompile).
local function gatherScripts(data, objs)
    local parseErr
    if data then
        local ok, roots = pcall(parseTree, data)
        if ok and type(roots) == "table" then
            local out = {}
            matchScripts(objs, roots, "", out)
            return out, nil
        end
        parseErr = tostring(roots)
    end

    local scripts = {}
    for _, obj in ipairs(objs) do
        local list = obj:GetDescendants()
        table.insert(list, obj)
        for _, d in ipairs(list) do
            if d:IsA("LuaSourceContainer") then
                local src, decompiled
                pcall(function() src = d.Source end)
                if (type(src) ~= "string" or src == "") and gethiddenproperty then
                    pcall(function() src = gethiddenproperty(d, "Source") end)
                end
                if (type(src) ~= "string" or src == "") and decompile then
                    pcall(function() src = decompile(d) end)
                    decompiled = true
                end
                if type(src) ~= "string" then src = "" end
                if decompiled and src ~= "" then
                    src = "-- hasil decompile, mungkin tidak persis sama dengan aslinya\n" .. src
                end
                scripts[#scripts + 1] = {
                    inst = d, class = d.ClassName, name = d.Name, path = d:GetFullName(), source = src,
                }
            end
        end
    end
    return scripts, parseErr
end

local function safeName(s)
    return (s:gsub("[^%w_%-]", "_"))
end

-- Tulis tiap script ke file .lua (cadangan kalau clipboard tidak ada)
local function exportScripts(path, scripts)
    if #scripts == 0 or not writefile then return nil end
    local base = displayName(path):gsub("%.rbxmx?$", "")
    base = safeName(base)
    local dir = CONFIG.Folder .. "/scripts_out"
    if makefolder and isfolder then
        if not isfolder(dir) then pcall(makefolder, dir) end
        dir = dir .. "/" .. base
        if not isfolder(dir) then pcall(makefolder, dir) end
    else
        dir = dir .. "_" .. base
    end
    for i, s in ipairs(scripts) do
        pcall(writefile, string.format("%s/%02d_%s.lua", dir, i, safeName(s.name)), s.source)
    end
    return dir
end

local function sanitize(obj)
    if not CONFIG.DisableScripts then return end
    local list = obj:GetDescendants()
    table.insert(list, obj)
    for _, d in ipairs(list) do
        if d:IsA("BaseScript") then
            pcall(function() d.Disabled = true end)
        end
    end
end


-- Taruh di depan kamera. state.offset dipakai batch import supaya tiap file
-- digeser ke samping (RightVector) sesuai ukurannya dan tidak menumpuk.
local function placeInFront(obj, state)
    local cam = workspace.CurrentCamera
    if not cam then return end
    state = state or { offset = 0 }
    local size = 8
    if obj:IsA("Model") then
        local ok, s = pcall(function() return obj:GetExtentsSize() end)
        if ok and s then size = math.max(s.X, s.Z, 2) end
    elseif obj:IsA("BasePart") then
        size = math.max(obj.Size.X, obj.Size.Z, 2)
    else
        return
    end
    local cf = cam.CFrame
    local target = cf.Position + cf.LookVector * 25 + cf.RightVector * (state.offset + size / 2)
    state.offset = state.offset + size + 4
    if obj:IsA("Model") then
        pcall(function() obj:PivotTo(CFrame.new(target)) end)
    else
        pcall(function() obj.Position = target end)
    end
end

-- ===== Pemasang teks script untuk Studio Lite =====
-- Dari dump game: editor Studio Lite TIDAK memakai Script.Source. Teks script disimpan
-- di objek TextBox bernama SL_CodeTextBox yang jadi anak dari script, dan editor menulis
-- balik lewat ObjectValue "SaveChangesTo" (SaveChangesTo.Value.Text = teks). Script yang
-- dibuat Instance.new() tidak punya struktur itu, makanya editor kelihatan kosong.
-- Solusi: salin struktur itu dari script bawaan Studio Lite, lalu isi teksnya.

local HOLDER_BOX = "SL_CodeTextBox"
local HOLDER_PTR = "SaveChangesTo"
local MARK = "_SLI_mark"

local function setMark(inst, v)
    pcall(function() inst:SetAttribute(MARK, v) end)
end

local function hasMark(inst, v)
    local ok, cur = pcall(function() return inst:GetAttribute(MARK) end)
    return ok and (cur == v or cur == "both")
end

local function findMarked(root, v)
    if hasMark(root, v) then return root end
    for _, d in ipairs(root:GetDescendants()) do
        if hasMark(d, v) then return d end
    end
    return nil
end

local function clearMarks(root)
    setMark(root, nil)
    for _, d in ipairs(root:GetDescendants()) do setMark(d, nil) end
end

local function nativeRoots()
    local roots = {}
    for _, name in ipairs({ "ReplicatedStorage", "Workspace", "StarterGui", "StarterPack", "Lighting", "ReplicatedFirst" }) do
        local ok, svc = pcall(function() return game:GetService(name) end)
        if ok and svc then roots[#roots + 1] = svc end
    end
    return roots
end

-- script bawaan Studio Lite = LuaSourceContainer yang punya TextBox SL_CodeTextBox
local function findNativeTemplates()
    local found, seen = {}, {}
    for _, root in ipairs(nativeRoots()) do
        local ok, list = pcall(function() return root:GetDescendants() end)
        if ok then
            for _, d in ipairs(list) do
                if d.Name == HOLDER_BOX and d:IsA("TextBox") and not seen[d] then
                    local owner = d.Parent
                    while owner and not owner:IsA("LuaSourceContainer") do owner = owner.Parent end
                    if owner then
                        seen[d] = true
                        found[#found + 1] = { owner = owner, box = d }
                    end
                end
            end
        end
    end
    return found
end

local function pickTemplate(list, class)
    for _, t in ipairs(list) do
        if t.owner.ClassName == class then return t end
    end
    return list[1]
end

-- Siapkan prototipe yang akan di-clone ke tiap script hasil import
local function buildInstaller(t)
    local owner, box = t.owner, t.box
    local ptr = box:FindFirstChild(HOLDER_PTR)
    local target
    if ptr and ptr:IsA("ObjectValue") then target = ptr.Value end

    local function branchOf(inst)
        local cur = inst
        while cur and cur.Parent ~= owner do cur = cur.Parent end
        return cur
    end
    local boxBranch = branchOf(box)
    local targetBranch
    if target then
        targetBranch = target:IsDescendantOf(owner) and branchOf(target) or target
    end

    if target == box then
        setMark(box, "both")
    else
        setMark(box, "box")
        if target then setMark(target, "target") end
    end
    local protoBox = boxBranch and boxBranch:Clone()
    local protoTarget
    if targetBranch and targetBranch ~= boxBranch then protoTarget = targetBranch:Clone() end
    setMark(box, nil)
    if target then setMark(target, nil) end

    if not protoBox then return nil, "clone SL_CodeTextBox gagal (Archivable mati?)" end
    return { protoBox = protoBox, protoTarget = protoTarget }
end

local function writeText(obj, src)
    if not obj then return false end
    local ok = pcall(function()
        if obj:IsA("ValueBase") then obj.Value = src else obj.Text = src end
    end)
    if not ok then return false end
    local back
    pcall(function()
        if obj:IsA("ValueBase") then back = obj.Value else back = obj.Text end
    end)
    return back == src
end

-- return: berhasil?, keterangan
local function installOne(installer, s)
    local inst = s.inst
    if not inst then return false, "instance tidak ditemukan" end
    local src = s.source or ""
    src = src:gsub("\r\n", "\n")
    src = src:gsub("\r", "\n")
    local box, holder

    local existing = inst:FindFirstChild(HOLDER_BOX)
    if existing and existing:IsA("TextBox") then
        -- file ini sudah membawa struktur editor Studio Lite (hasil simpan dari Studio Lite)
        if src == "" then return true, "editor bawaan sudah ada, tidak diubah" end
        box = existing
        local p = existing:FindFirstChild(HOLDER_PTR)
        if p and p:IsA("ObjectValue") then holder = p.Value end
    else
        local bb = installer.protoBox:Clone()
        if not bb then return false, "clone editor gagal" end
        bb.Parent = inst
        box = findMarked(bb, "box")
        holder = findMarked(bb, "target")
        local extra
        if not holder and installer.protoTarget then
            extra = installer.protoTarget:Clone()
            if extra then
                extra.Parent = inst
                holder = findMarked(extra, "target")
            end
        end
        clearMarks(bb)
        if extra then clearMarks(extra) end
        if not box then return false, "SL_CodeTextBox tidak ketemu di hasil clone" end
        local ptr = box:FindFirstChild(HOLDER_PTR)
        if ptr and ptr:IsA("ObjectValue") and holder then
            pcall(function() ptr.Value = holder end)
        end
    end

    -- teks polos ke SEMUA penampung (kalau SL_CodeTextBox sendiri penampungnya, itu sudah cukup)
    local okBox = writeText(box, src)
    local okHolder = true
    if holder and holder ~= box then okHolder = writeText(holder, src) end
    if not okBox then return false, "gagal menulis teks ke SL_CodeTextBox (terlalu panjang?)" end
    if not okHolder then return false, "gagal menulis teks ke penampung SaveChangesTo" end
    return true, "ok"
end

-- return: { ok = n, fail = n, firstReason = str|nil, notes = { [i] = "..." } }
local function installScriptText(list)
    local stats = { ok = 0, fail = 0, notes = {} }
    if #list == 0 then return stats end

    local templates = findNativeTemplates()
    if #templates == 0 then
        stats.fail = #list
        stats.firstReason = "script bawaan Studio Lite (SL_CodeTextBox) tidak ditemukan, buka/insert satu script dulu lalu tekan Scan"
        for i = 1, #list do stats.notes[i] = stats.firstReason end
        return stats
    end

    local cache = {}
    for i, s in ipairs(list) do
        local t = pickTemplate(templates, s.class)
        local installer = cache[t]
        local ierr
        if installer == nil then
            installer, ierr = buildInstaller(t)
            cache[t] = installer or false
        elseif installer == false then
            ierr = "prototipe editor tidak bisa dibuat"
        end
        local ok, why
        if installer then
            local okc, a, b = pcall(installOne, installer, s)
            if okc then ok, why = a, b else ok, why = false, tostring(a) end
        else
            ok, why = false, ierr or "prototipe editor tidak bisa dibuat"
        end
        stats.notes[i] = why
        if ok then
            stats.ok = stats.ok + 1
        else
            stats.fail = stats.fail + 1
            stats.firstReason = stats.firstReason or why
        end
    end
    return stats
end

-- ===== Scan: catat struktur script bawaan Studio Lite (buat diagnosa) =====

local function oneLine(s, n)
    s = tostring(s):gsub("[\r\n]+", " / ")
    if #s > n then s = s:sub(1, n) .. "..." end
    return s
end

local function describe(inst)
    local info = inst.ClassName .. "  " .. inst.Name
    if inst:IsA("GuiObject") then
        info = info .. "  Visible=" .. tostring(inst.Visible)
    end
    if inst:IsA("TextBox") or inst:IsA("TextLabel") or inst:IsA("TextButton") then
        info = info .. string.format("  RichText=%s  Text(%d)=\"%s\"",
            tostring(inst.RichText), #inst.Text, oneLine(inst.Text, 70))
    elseif inst:IsA("ObjectValue") then
        info = info .. "  -> " .. (inst.Value and inst.Value:GetFullName() or "nil")
    elseif inst:IsA("StringValue") then
        info = info .. string.format("  Value(%d)=\"%s\"", #inst.Value, oneLine(inst.Value, 70))
    elseif inst:IsA("ValueBase") then
        info = info .. "  Value=" .. tostring(inst.Value)
    elseif inst:IsA("LuaSourceContainer") then
        local dis
        pcall(function() dis = inst.Disabled end)
        if dis ~= nil then info = info .. "  Disabled=" .. tostring(dis) end
    end
    local okA, attrs = pcall(function() return inst:GetAttributes() end)
    if okA and next(attrs) then
        local parts = {}
        for k, v in pairs(attrs) do parts[#parts + 1] = k .. "=" .. oneLine(v, 30) end
        table.sort(parts)
        info = info .. "  attrs{" .. table.concat(parts, ", ") .. "}"
    end
    return info
end

local function dumpTree(inst, depth, maxDepth, lines)
    for _, c in ipairs(inst:GetChildren()) do
        lines[#lines + 1] = string.rep("  ", depth) .. describe(c)
        if depth < maxDepth then dumpTree(c, depth + 1, maxDepth, lines) end
    end
end

local function scanNative()
    local templates = findNativeTemplates()
    local lines = {
        "# Scan script bawaan Studio Lite",
        "PlaceId: " .. tostring(game.PlaceId),
        "Template (SL_CodeTextBox): " .. #templates,
        "",
    }
    local seenOwner, shown = {}, 0
    for _, t in ipairs(templates) do
        if not seenOwner[t.owner] and shown < 25 then
            seenOwner[t.owner] = true
            shown = shown + 1
            lines[#lines + 1] = "== " .. t.owner:GetFullName() .. "  [" .. t.owner.ClassName .. "]"
            dumpTree(t.owner, 1, 5, lines)
            lines[#lines + 1] = ""
        end
    end

    -- script di Workspace yang TIDAK punya SL_CodeTextBox (buat lihat bentuk lain)
    local others = 0
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("LuaSourceContainer") and not d:FindFirstChild(HOLDER_BOX) and others < 10 then
            others = others + 1
            if others == 1 then lines[#lines + 1] = "== Script di Workspace tanpa SL_CodeTextBox" end
            lines[#lines + 1] = d:GetFullName() .. "  [" .. d.ClassName .. "]"
            dumpTree(d, 1, 2, lines)
        end
    end

    local report = table.concat(lines, "\n")
    local saved
    if writefile then
        ensureFolder()
        local p = CONFIG.Folder .. "/scan_studio_lite.txt"
        if pcall(writefile, p, report) then saved = p end
    end
    local clip = setclipboard or toclipboard
    local copied = clip and pcall(clip, report)

    local msg = string.format("Scan: %d template ditemukan.", #templates)
    if saved then msg = msg .. " Disimpan: " .. saved .. "." end
    if copied then msg = msg .. " Hasil juga disalin ke clipboard." end
    return msg
end


