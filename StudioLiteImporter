    local function dropdown(anchor, options, current, onPick)
        closeDropdown()
        local rel = anchor.AbsolutePosition - Main.AbsolutePosition
        local itemH = 28
        local h = #options * itemH + 8
        local w = math.max(anchor.AbsoluteSize.X, 150)
        local y = rel.Y - h - 4
        if y < TITLE_H + 4 then y = rel.Y + anchor.AbsoluteSize.Y + 4 end
        local x = math.max(4, math.min(rel.X, Main.AbsoluteSize.X - w - 6))
        local blocker = make("TextButton", {
