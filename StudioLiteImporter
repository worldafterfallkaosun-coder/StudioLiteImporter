    if not (writefile and alive()) or saveQueued then return end
    saveQueued = true
    task.delay(1, function()
        saveQueued = false
        local data = { target = S.target, sort = S.sort, filter = S.filter, ui = S.ui, studio = S.studio,
            pins = X.pins, recent = X.recent, toolbox = TB.persist(), plugins = PLG.enabled }
