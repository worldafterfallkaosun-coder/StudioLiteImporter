    "RemoteFunction", "BindableEvent", "BindableFunction", "ClickDetector", "ProximityPrompt", "ParticleEmitter", "Fire", "Smoke", "Humanoid" }

local function classMatches(query)
    local out = {}
    query = (query or ""):lower()
    if query == "" then
        local seen = {}
        SS.recentClasses = SS.recentClasses or {}
        for _, n in ipairs(SS.recentClasses) do
            if DB.raw[n] and not seen[n] then seen[n] = true out[#out + 1] = n end
        end
        for _, n in ipairs(COMMON_CLASSES) do
            if DB.raw[n] and not seen[n] and DB.raw[n].flags:find("c", 1, true) then seen[n] = true out[#out + 1] = n end
        end
        for _, n in ipairs(DB.insertable) do
            if not seen[n] then out[#out + 1] = n end
        end
    else
        local pre, mid = {}, {}
        for _, n in ipairs(DB.insertable) do
            local l = n:lower()
            local at = l:find(query, 1, true)
            if at == 1 then pre[#pre + 1] = n elseif at then mid[#mid + 1] = n end
        end
        for _, n in ipairs(pre) do out[#out + 1] = n end
        for _, n in ipairs(mid) do out[#out + 1] = n end
    end
    return out
end

