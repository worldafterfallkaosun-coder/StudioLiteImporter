    -- resize lewat grip
    do
        local resizing, startIn, startSize = false, nil, nil
        bind(grip.InputBegan, function(input)
            if (input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch) and not W.maxed and not W.minimized then
                resizing = true
                startIn, startSize = input.Position, Vector2.new(W.w, W.h)
                local c
                c = input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        resizing = false
                        c:Disconnect()
                        persistRect()
                    end
                end)
            end
        end)
        bind(UIS.InputChanged, function(input)
            if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                local d = input.Position - startIn
                local vp = viewport()
                W.w = math.clamp(startSize.X + d.X, MIN_W, math.max(MIN_W, vp.X - W.x))
                W.h = math.clamp(startSize.Y + d.Y, MIN_H, math.max(MIN_H, vp.Y - W.y))
                Main.Size = UDim2.fromOffset(W.w, W.h)
            end
        end)
    end

