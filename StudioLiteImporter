TB.SORTS = { { label = "Relevansi", v = 0 }, { label = "Terlaris", v = 1 }, { label = "Terbaru", v = 3 }, { label = "Rating", v = 4 } }
TB.favs, TB.recent, TB.busy = {}, {}, false

function TB.persist() return { favs = TB.favs, recent = TB.recent } end

function TB.restore(t)
    if type(t) ~= "table" then return end
    local function clean(list, max)
        local out = {}
        if type(list) == "table" then
            for _, it in ipairs(list) do
                if type(it) == "table" and tonumber(it.id) and #out < max then
                    out[#out + 1] = { id = tonumber(it.id), kind = tostring(it.kind or "model"),
                        name = tostring(it.name or ("Asset " .. it.id)), creator = it.creator and tostring(it.creator) or nil }
                end
            end
        end
        return out
    end
    TB.favs, TB.recent = clean(t.favs, 60), clean(t.recent, 24)
end

local function urlenc(s)
    return (tostring(s):gsub("[^%w%-_%.~]", function(c) return string.format("%%%02X", c:byte()) end))
end

local function httpGet(url)
    local req = (syn and syn.request) or request or http_request or (http and http.request)
    if req then
        local ok, res = pcall(req, { Url = url, Method = "GET", Headers = { Accept = "application/json" } })
        if ok and type(res) == "table" then
            local code = res.StatusCode or res.status_code
            if (type(code) == "number" and code >= 200 and code < 300) or res.Success == true then
                return res.Body
            end
            return nil, "HTTP " .. tostring(code or "?")
        end
        return nil, tostring(res)
    end
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if ok and type(body) == "string" then return body end
    return nil, tostring(body)
end

local function jsonDecode(body)
    local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
    if ok and type(data) == "table" then return data end
    return nil
end

-- ID dari angka / link (rbxassetid://123, create.roblox.com/store/asset/123/nama, dst.)
function TB.parseId(text)
    local n = tostring(text or ""):match("(%d%d%d+)")
    return n and tonumber(n) or nil
end

-- return: items, nextCursor, err   (yield)
function TB.search(cat, query, sortV, cursor, page)
    local url = string.format("https://apis.roblox.com/toolbox-service/v1/marketplace/%d?limit=%d&sortType=%d&keyword=%s",
        cat.typeId, CONFIG.ToolboxPageSize, sortV or 0, urlenc(query or ""))
    if cursor then
        url = url .. "&cursor=" .. urlenc(cursor)
    elseif page and page > 0 then
        url = url .. "&pageNumber=" .. page
    end
    local body, err = httpGet(url)
    if not body then return nil, nil, err end
    local data = jsonDecode(body)
    if not data then return nil, nil, "respons Toolbox tidak valid" end
    local rows = data.data or data.items or data.results or {}
    local ids = {}
    for _, r in ipairs(rows) do
        local id = type(r) == "table" and (r.id or r.assetId or r.Id) or r
        if tonumber(id) then ids[#ids + 1] = tonumber(id) end
    end
    local details = {}
    if #ids > 0 then
        local dbody = httpGet("https://apis.roblox.com/toolbox-service/v1/items/details?assetIds=" .. table.concat(ids, ","))
        local dd = dbody and jsonDecode(dbody)
        if dd then
            for _, it in ipairs(dd.data or {}) do
                local a = it.asset or it
                local id = tonumber(a.id or a.assetId)
                if id then
                    details[id] = {
                        name = a.name, desc = a.description,
                        creator = it.creator and (it.creator.name or it.creator.Name) or nil,
                    }
                end
            end
        end
    end
    local items = {}
    for _, id in ipairs(ids) do
        local d = details[id] or {}
        items[#items + 1] = { id = id, kind = cat.id, name = d.name or ("Asset " .. id), creator = d.creator, desc = d.desc }
    end
    return items, data.nextPageCursor, nil
end

-- file mentah aset (untuk membaca teks script di dalam model Toolbox)
function TB.fetchRaw(id)
    local function isRbx(b) return type(b) == "string" and (b:sub(1, 8) == "<roblox!" or b:sub(1, 7) == "<roblox") end
    local body = httpGet("https://assetdelivery.roblox.com/v1/asset/?id=" .. id)
    if isRbx(body) then return body end
    local meta = httpGet("https://assetdelivery.roblox.com/v2/assetId/" .. id)
    local j = meta and jsonDecode(meta)
    local loc = j and j.locations and j.locations[1] and j.locations[1].location
    if loc then
        local b2 = httpGet(loc)
        if isRbx(b2) then return b2 end
    end
    return nil
end

local function hasScriptInside(objs)
    for _, o in ipairs(objs) do
        if o:IsA("LuaSourceContainer") then return true end
        for _, d in ipairs(o:GetDescendants()) do
            if d:IsA("LuaSourceContainer") then return true end
        end
    end
    return false
end

-- return: ok, pesan, added, scripts, stats   (yield)
function TB.insert(item, target, placeState)
    if item.kind == "audio" then
        local host = target
        local s = makeSound(item.name, "rbxassetid://" .. item.id, host)
        return true, string.format("%s -> %s: Sound (id %d)", item.name, X.pathOf(host), item.id), { s }, {}, EMPTY_STATS()
    end

    local okg, objs = pcall(function() return game:GetObjects("rbxassetid://" .. item.id) end)
    local have = okg and type(objs) == "table" and #objs > 0

    if item.kind == "decal" then
        local texture = "rbxassetid://" .. item.id
        if have and objs[1]:IsA("Decal") then
            local okt, t = pcall(function() return objs[1].Texture end)
            if okt and type(t) == "string" and t ~= "" then texture = t end
        end
        local added, how = applyTexture(item.name, texture, 256, 256, target, placeState)
        return true, string.format("%s -> %s: %s (id %d)", item.name, X.pathOf(target), how, item.id), added, {}, EMPTY_STATS()
    end

    if not have then
        return false, string.format("GetObjects gagal untuk id %d (aset privat / bukan model?): %s", item.id, tostring(objs))
    end
    local roots, perr
    if hasScriptInside(objs) then
        local raw = TB.fetchRaw(item.id)
        if raw then roots, perr = parseOrNil(raw) end
        if not roots then perr = perr or "teks script aset tidak bisa diambil (aset terproteksi)" end
    end
    return finishImport(objs, roots, item.name, "toolbox", target, { placeState = placeState, parseErr = perr })
end

function TB.pushRecent(item)
    for i, it in ipairs(TB.recent) do
        if it.id == item.id then table.remove(TB.recent, i) break end
    end
    table.insert(TB.recent, 1, { id = item.id, kind = item.kind, name = item.name, creator = item.creator })
    while #TB.recent > 24 do table.remove(TB.recent) end
    E.saveSettings()
end

function TB.isFav(id)
    for _, it in ipairs(TB.favs) do
        if it.id == id then return true end
    end
    return false
end

function TB.toggleFav(item)
    for i, it in ipairs(TB.favs) do
        if it.id == item.id then
            table.remove(TB.favs, i)
            E.saveSettings()
            return false
        end
    end
    table.insert(TB.favs, 1, { id = item.id, kind = item.kind, name = item.name, creator = item.creator })
    while #TB.favs > 60 do table.remove(TB.favs) end
    E.saveSettings()
    return true
end

