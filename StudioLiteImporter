            TextYAlignment = Enum.TextYAlignment.Top, Font = MONO, TextSize = ed.size, TextColor3 = T.text,
            TextWrapped = false, BorderSizePixel = 0, ZIndex = 1 }, sf)
        -- lapisan warna: TextLabel RichText tepat di atas TextBox (teks TextBox disembunyikan saat warna aktif)
        local hl = new("TextLabel", { Name = "Colors", Position = UDim2.fromOffset(6, 0), Size = UDim2.fromOffset(200, 200),
            BackgroundTransparency = 1, RichText = true, Text = "", Font = MONO, TextSize = ed.size, TextColor3 = T.text,
            TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = false,
            BorderSizePixel = 0, ZIndex = 2, Active = false, Visible = false }, sf)
        pcall(function() hl.Interactable = false end)
        -- caret buatan: saat TextTransparency = 1 caret asli bisa ikut hilang
        local caret = new("Frame", { Name = "Caret", Size = UDim2.fromOffset(2, 16), BackgroundColor3 = T.text,
            BorderSizePixel = 0, ZIndex = 3, Active = false, Visible = false }, sf)
        ed.tb, ed.sf, ed.hl, ed.gut, ed.gl = tb, sf, hl, gut, gl

        -- ---------- util ----------
        function ed.measure()
            local ok, sz = pcall(function() return TextService:GetTextSize("Ag", ed.size, MONO, V2(1e6, 1e6)) end)
            ed.lineH = (ok and sz and sz.Y > 0) and sz.Y or math.floor(ed.size * 1.25)
        end

        function ed.placeCode()
            local gw = ed.wrap and 0 or ed.gutW
            gut.Visible = not ed.wrap
            gut.Size = U2(0, ed.gutW, 1, -(HEAD_H + FOOT_H))
            sf.Position = UDim2.fromOffset(gw > 0 and (gw + 1) or 0, HEAD_H)
            sf.Size = U2(1, -(gw > 0 and (gw + 1) or 0), 1, -(HEAD_H + FOOT_H))
        end

        function ed.syncHl()
            local ab = tb.AbsoluteSize
            hl.Size = UDim2.fromOffset(ab.X / UI.sc, ab.Y / UI.sc)
        end

        function ed.fit()
            local ab = sf.AbsoluteSize
            local vw = math.max(40, ab.X / UI.sc - 14)
            local vh = math.max(40, ab.Y / UI.sc - 4)
            tb.AutomaticSize = ed.wrap and Enum.AutomaticSize.Y or Enum.AutomaticSize.XY
            tb.Size = UDim2.fromOffset(vw - 6, vh)
            ed.syncHl()
        end

        function ed.setInfo()
            local t = ed.tabs[ed.active]
            if not t then return end
            local bad = ed.statusOk == false
            infoL.Text = (ed.status and (ed.status .. "  |  ") or "") .. t.inst:GetFullName()
            infoL.TextColor3 = bad and T.err or (ed.statusOk and T.ok or T.textDim)
        end

        function ed.updatePos()
            local cp = tb.CursorPosition
            if cp < 1 then posL.Text = "" return end
            local before = tb.Text:sub(1, cp - 1)
            local ls = before:match(".*\n()") or 1
            local line = select(2, before:gsub("\n", "\n")) + 1
            posL.Text = string.format("Ln %d, Col %d", line, #before - ls + 2)
        end

        -- caret buatan + auto-scroll ke caret (hanya mode tanpa wrap; di mode wrap TextBox asli yang dipakai)
        function ed.updateCaret(scroll)
            if ed.wrap then caret.Visible = false return end
            local cp = tb.CursorPosition
            if cp < 1 then caret.Visible = false return end
            local before = tb.Text:sub(1, cp - 1)
            local ls = before:match(".*\n()") or 1
            local lineText = before:sub(ls)
            local line = select(2, before:gsub("\n", "\n"))
            local x = 0
            if lineText ~= "" then
                local ok, sz = pcall(function() return TextService:GetTextSize(lineText, ed.size, MONO, V2(1e6, 1e6)) end)
                if ok and sz then x = sz.X else x = #lineText * ed.size * 0.6 end
            end
            local y = line * ed.lineH
            local cx = 6 + x
            caret.Position = UDim2.fromOffset(cx, y)
            caret.Size = UDim2.fromOffset(2, ed.lineH)
            caret.Visible = ed.hlActive and tb:IsFocused()
            if scroll and tb:IsFocused() then
                local cpos = sf.CanvasPosition
                local ab = sf.AbsoluteSize
                local vw, vh = ab.X / UI.sc - 14, ab.Y / UI.sc
                local nx, ny = cpos.X, cpos.Y
                if y < ny then ny = y
                elseif y + ed.lineH > ny + vh - 10 then ny = y + ed.lineH - vh + 10 end
                if cx < nx then nx = math.max(0, cx - 40)
                elseif cx + 4 > nx + vw then nx = cx + 4 - vw + 40 end
                if nx ~= cpos.X or ny ~= cpos.Y then sf.CanvasPosition = V2(math.max(0, nx), math.max(0, ny)) end
            end
        end

        function ed.refreshGutter()
            local n = select(2, tb.Text:gsub("\n", "\n")) + 1
            if n == ed.lines then return end
            ed.lines = n
            gl.Text = lineNums(n)
            local gw = math.max(32, #tostring(n) * math.floor(ed.size * 0.62) + 16)
            if gw ~= ed.gutW then ed.gutW = gw ed.placeCode() ed.fit() end
        end

        function ed.render()
            local text = tb.Text
            local want = SS.edHi ~= false and not ed.wrap and #text <= 40000
            if want then
                local ok, rt = pcall(ACT.highlight, text)
                if ok and type(rt) == "string" and #rt < 190000 then
                    hl.Text = rt
                    hl.Visible = true
                    tb.TextTransparency = 1
                    ed.hlActive = true
                    ed.syncHl()
                    ed.updateCaret(false)
                    return
                end
            end
            hl.Visible = false
            tb.TextTransparency = 0
            ed.hlActive = false
            caret.Visible = false
        end

        function ed.scheduleRender()
            if #tb.Text <= 6000 then ed.render() return end
            if hl.Visible then hl.Text = escRT(tb.Text) end -- sementara polos agar tidak tertinggal saat mengetik
            ed.hlTok = ed.hlTok + 1
            local tok = ed.hlTok
            task.delay(0.18, function()
                if ed.hlTok == tok and f.Parent then ed.render() end
            end)
        end

        function ed.paintTabs()
            for i, t in ipairs(ed.tabs) do
                if t.ui then
                    local act = i == ed.active
                    t.ui.b.BackgroundColor3 = act and T.input or T.panel
                    t.ui.l.Text = (t.dirty and "* " or "") .. t.inst.Name
                    t.ui.l.TextColor3 = act and T.text or T.textDim
                end
            end
        end

        function ed.drawTabs()
            for _, c in ipairs(tabsF:GetChildren()) do
                if c:IsA("GuiObject") then c:Destroy() end
            end
            local x = 4
            for i, t in ipairs(ed.tabs) do
                local name = t.inst.Name
                local w = math.clamp(textWidth(name, 13) + 44, 84, 220)
                local b = btn(tabsF, { Name = "Tab" .. i, Position = UDim2.fromOffset(x, 3), Size = UDim2.fromOffset(w, 25),
                    BackgroundTransparency = 0, BackgroundColor3 = T.panel })
                corner(b, 4)
                local l = lbl(b, { Position = UDim2.fromOffset(8, 0), Size = U2(1, -32, 1, 0), Text = name, TextSize = 13,
                    TextTruncate = Enum.TextTruncate.AtEnd })
                local xb = btn(b, { Position = U2(1, -24, 0, 2), Size = UDim2.fromOffset(20, 21) })
                lbl(xb, { Size = U2(1, 0, 1, 0), Text = "x", TextXAlignment = Enum.TextXAlignment.Center, TextSize = 14, TextColor3 = T.textDim })
                t.ui = { b = b, l = l }
                on(b.MouseButton1Click, function()
                    for j, tt in ipairs(ed.tabs) do if tt == t then ed.select(j) break end end
                end)
                on(xb.MouseButton1Click, function()
                    for j, tt in ipairs(ed.tabs) do if tt == t then ed.closeTab(j) break end end
                end)
                x = x + w + 3
            end
            ed.paintTabs()
        end

        function ed.saveNow()
            local t = ed.tabs[ed.active]
            if not t or t.dead then return end
            if not t.dirty and not ed.force then return end
            t.dirty = false
            local ok, why = ACT.writeSource(t.inst, t.text)
            if ok then ed.status, ed.statusOk = "Tersimpan", true
            else ed.status, ed.statusOk, t.dirty = "Gagal menyimpan: " .. tostring(why), false, true end
            ed.setInfo()
            ed.paintTabs()
        end

        function ed.scheduleSave()
            ed.saveTok = ed.saveTok + 1
            local tok = ed.saveTok
            task.delay(0.6, function()
                if ed.saveTok == tok and f.Parent then ed.saveNow() end
            end)
        end

        function ed.select(i)
            if i < 1 or i > #ed.tabs then return end
            ed.saveNow()
            ed.active = i
            local t = ed.tabs[i]
            ed.loading = true
            tb.Text = t.text
            ed.loading = false
            sf.CanvasPosition = V2(0, 0)
            ed.status, ed.statusOk = nil, nil
            ed.lines = 0
            ed.refreshGutter()
            ed.render()
            ed.paintTabs()
            ed.setInfo()
            ed.updatePos()
        end

        function ed.hide()
            ed.open = false
            f.Visible = false
            if ACT.relayout then ACT.relayout() end
        end

        function ed.show()
            ed.open = true
            f.Visible = true
            if ACT.relayout then ACT.relayout() end
        end

        function ed.closeTab(i)
            local t = ed.tabs[i]
            if not t then return end
            if i == ed.active then ed.saveNow() end
            if t.conn then pcall(function() t.conn:Disconnect() end) end
            if t.nameConn then pcall(function() t.nameConn:Disconnect() end) end
            table.remove(ed.tabs, i)
            if #ed.tabs == 0 then
                ed.active = 0
                ed.loading = true
                tb.Text = ""
                ed.loading = false
                ed.drawTabs()
                ed.hide()
                return
            end
            local ni = ed.active
            if i < ed.active then ni = ed.active - 1 end
            ni = math.min(math.max(ni, 1), #ed.tabs)
            ed.active = 0
            ed.drawTabs()
            ed.select(ni)
        end

        function ed.closeAll()
            ed.saveNow()
            for i = #ed.tabs, 1, -1 do
                local t = ed.tabs[i]
                if t.conn then pcall(function() t.conn:Disconnect() end) end
                if t.nameConn then pcall(function() t.nameConn:Disconnect() end) end
                ed.tabs[i] = nil
            end
            ed.active = 0
            ed.drawTabs()
            ed.hide()
        end

        function ed.setSize(n)
            ed.size = math.clamp(n, 10, 32)
            SS.edFont = ed.size
            saveSS()
            tb.TextSize, hl.TextSize, gl.TextSize = ed.size, ed.size, ed.size
            ed.measure()
            ed.lines = 0
            ed.refreshGutter()
            ed.fit()
            ed.render()
        end

        function ed.applyWrap()
            tb.TextWrapped = ed.wrap
            sf.AutomaticCanvasSize = ed.wrap and Enum.AutomaticSize.Y or Enum.AutomaticSize.XY
            sf.ScrollingDirection = ed.wrap and Enum.ScrollingDirection.Y or Enum.ScrollingDirection.XY
            sf.CanvasPosition = V2(0, sf.CanvasPosition.Y)
            setPill(pills.Wrap, ed.wrap)
            ed.placeCode()
            ed.fit()
            ed.render()
        end

        -- ---------- event ----------
        on(tb:GetPropertyChangedSignal("Text"), function()
            if ed.loading then return end
            local t = ed.tabs[ed.active]
            if not t then return end
            t.text = tb.Text
            t.dirty = true
            ed.status, ed.statusOk = nil, nil
            ed.refreshGutter()
            ed.scheduleRender()
            ed.scheduleSave()
            ed.paintTabs()
            ed.updatePos()
            ed.updateCaret(true)
        end)
        on(tb:GetPropertyChangedSignal("CursorPosition"), function()
            ed.updatePos()
            ed.updateCaret(true)
        end)
        on(tb:GetPropertyChangedSignal("AbsoluteSize"), ed.syncHl)
        on(sf:GetPropertyChangedSignal("AbsoluteSize"), ed.fit)
        on(sf:GetPropertyChangedSignal("CanvasPosition"), function()
            gl.Position = UDim2.fromOffset(0, -sf.CanvasPosition.Y)
        end)
        on(tb.Focused, function() ed.updateCaret(false) end)
        on(tb.FocusLost, function()
            caret.Visible = false
            ed.saveNow()
        end)
        on(pills.Save.MouseButton1Click, function()
            ed.force = true
            ed.saveNow()
            ed.force = false
        end)
        on(pills["A-"].MouseButton1Click, function() ed.setSize(ed.size - 1) end)
        on(pills["A+"].MouseButton1Click, function() ed.setSize(ed.size + 1) end)
        on(pills.Wrap.MouseButton1Click, function()
            ed.wrap = not ed.wrap
            ed.applyWrap()
        end)
        on(pills.Color.MouseButton1Click, function()
            SS.edHi = not (SS.edHi ~= false)
            saveSS()
            setPill(pills.Color, SS.edHi ~= false)
            ed.render()
        end)
        on(pills.Size.MouseButton1Click, function()
            local cur = SS.edFrac or 0.6
            SS.edFrac = cur > 0.9 and 0.6 or (cur > 0.5 and 0.35 or 1)
            saveSS()
            if ACT.relayout then ACT.relayout() end
        end)
        on(pills.x.MouseButton1Click, function() ed.closeAll() end)
        -- Ctrl+S saat mengetik
        bind2(UIS.InputBegan, function(input)
            if input.KeyCode == Enum.KeyCode.S and tb:IsFocused()
                and (UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl)) then
                ed.force = true
                ed.saveNow()
                ed.force = false
            end
        end)

        setPill(pills.Color, SS.edHi ~= false)
        setPill(pills.Wrap, false)
        ed.measure()
        ed.placeCode()
        return ed
    end

    function ACT.openEditor(inst)
        if typeof(inst) ~= "Instance" or not inst:IsA("LuaSourceContainer") then
            notify("Pilih Script / LocalScript / ModuleScript dulu.", "warn")
            return
        end
        if not UI.frame then return end
        local okH, whyH = ACT.ensureScriptHolder(inst, ACT.TEMPLATES[inst.ClassName] or "")
        if not okH then notify("Editor script: " .. tostring(whyH), "warn") end
        local ed = ACT.edEnsure()
        for i, t in ipairs(ed.tabs) do
            if t.inst == inst then
                ed.show()
                ed.select(i)
                return ed
            end
        end
        local text = ACT.readSource(inst)
        text = text:gsub("\r\n", "\n"):gsub("\r", "\n")
        local t = { inst = inst, text = text, dirty = false }
        ed.tabs[#ed.tabs + 1] = t
        t.conn = inst.Destroying:Connect(function()
            t.dead = true
            task.defer(function()
                for j, tt in ipairs(ed.tabs) do
                    if tt == t then ed.closeTab(j) break end
                end
            end)
        end)
        t.nameConn = inst:GetPropertyChangedSignal("Name"):Connect(function()
            if ed.frame and ed.frame.Parent then ed.drawTabs() end
        end)
        ed.drawTabs()
        ed.show()
        ed.select(#ed.tabs)
        return ed
    end
end

