    local function dropdown(anchor, options, current, onPick)
        closeDropdown()
        local rel = anchor.AbsolutePosition - Main.AbsolutePosition
        local itemH = 28
        local h = #options * itemH + 8
        local w = math.max(anchor.AbsoluteSize.X, 150)
        local y = rel.Y - h - 4
        if y < TITLE_H + 4 then y = rel.Y + anchor.AbsoluteSize.Y + 4 end
        local x = math.max(4, math.min(rel.X, Main.AbsoluteSize.X - w - 6))
        local blocker = make("TextButton", {
            Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 50, AutoButtonColor = false,
        }, Main)
        local menu = make("Frame", {
            Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h),
            BackgroundColor3 = T.panel, BorderSizePixel = 0, ZIndex = 51,
        }, Main)
        corner(menu, 8)
        stroke(menu, T.line, 1)
        dd = { blocker = blocker, menu = menu }
        bind(blocker.MouseButton1Click, closeDropdown)
        for i, opt in ipairs(options) do
            local b = button(menu, opt.text, (opt.value == current) and T.accent or T.panel2, {
                Position = UDim2.fromOffset(4, 4 + (i - 1) * itemH), Size = UDim2.new(1, -8, 0, itemH - 2),
                TextSize = 12,
            })
            bind(b.MouseButton1Click, function()
                closeDropdown()
                onPick(opt.value)
            end)
        end
    end

