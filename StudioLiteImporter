-- ---- Seleksi: baca / tulis lewat hook bawaan Studio Lite, fallback seleksi internal ----
-- Hook (dari dump): PlayerGui.StudioGui.ExplorerPanel.GetSelection / SetSelection (BindableFunction)
-- dan Workspace.ExplorerSelectionChanged (BindableEvent).
SEL.list, SEL.internal, SEL.mode, SEL.fails, SEL.hookDead = {}, {}, "internal", 0, false

local function liveInst(i)
    return typeof(i) == "Instance" and i:IsDescendantOf(game)
end

local function collectInstances(res)
    local out, seen = {}, {}
    local function add(i)
        if liveInst(i) and not seen[i] then
            seen[i] = true
            out[#out + 1] = i
        end
    end
    if typeof(res) == "Instance" then
        add(res)
    elseif type(res) == "table" then
        for _, v in ipairs(res) do add(v) end
        for k, v in pairs(res) do
            if typeof(k) == "Instance" and v then add(k) elseif typeof(v) == "Instance" then add(v) end
        end
    end
    return out
end

local function studioHook(name)
    local pg = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
    local sg = pg and pg:FindFirstChild("StudioGui")
    local ep = sg and sg:FindFirstChild("ExplorerPanel")
    local h = ep and ep:FindFirstChild(name)
    if h and h:IsA("BindableFunction") then return h end
    return nil
end

-- BindableFunction:Invoke tanpa OnInvoke akan menggantung selamanya, jadi selalu pakai batas waktu
local function invokeTimeout(bf, timeout, ...)
    local done, ok, res = false, false, nil
    local args = table.pack(...)
    local th = task.spawn(function()
        local okc, r = pcall(function() return bf:Invoke(table.unpack(args, 1, args.n)) end)
        ok, res, done = okc, r, true
    end)
    local t0 = os.clock()
    while not done and os.clock() - t0 < timeout do task.wait() end
    if not done then
        pcall(task.cancel, th)
        return false, "timeout"
    end
    return ok, res
end

function SEL.read()
    local h = (not SEL.hookDead) and studioHook("GetSelection") or nil
    if h then
        local ok, res = invokeTimeout(h, 0.6)
        if ok then
            SEL.mode, SEL.fails = "studio", 0
            local got = collectInstances(res)
            -- v7: saat Play, hook bawaan tidak mengikuti seleksi kita (selalu kosong / basi), sehingga
            -- Anchor / CanCollide dll melihat seleksi kosong. Selama hook tidak mengikuti, pakai seleksi internal.
            if SEL.pinned then
                local internal = collectInstances(SEL.internal)
                local function same(a, b)
                    if #a ~= #b then return false end
                    for i = 1, #a do
                        if a[i] ~= b[i] then return false end
                    end
                    return true
                end
                local last = SEL.lastHook
                SEL.lastHook = got
                if same(got, internal) then
                    SEL.pinned = false
                elseif last and not same(got, last) then
                    SEL.pinned = false -- seleksi asli berubah sendiri: hormati
                else
                    return internal
                end
            end
            return got
        end
        SEL.fails = SEL.fails + 1
        if SEL.fails >= 3 then
            SEL.hookDead = true
            logLine("Hook GetSelection Studio Lite tidak merespons; memakai seleksi internal (tombol di tab Studio untuk mencoba lagi).", "warn")
        end
    end
    SEL.mode = "internal"
    return collectInstances(SEL.internal)
end

local function sameList(a, b)
    if #a ~= #b then return false end
    for i = 1, #a do
        if a[i] ~= b[i] then return false end
    end
    return true
end

function SEL.refresh()
    local new = SEL.read()
    if sameList(new, SEL.list) then return false end
    SEL.list = new
    fire("selection2")
    PLG.emit("selection", new)
    TOOL.update()
    return true
end

function SEL.set(list)
    list = collectInstances(list)
    SEL.internal = list
    SEL.pinned, SEL.lastHook = true, nil
    local h = (not SEL.hookDead) and studioHook("SetSelection") or nil
    if h then
        local ok = invokeTimeout(h, 0.6, list)
        if not ok then SEL.fails = SEL.fails + 1 end
    end
    SEL.list = list
    fire("selection2")
    PLG.emit("selection", list)
    TOOL.update()
end

function SEL.retryHook()
    SEL.hookDead, SEL.fails = false, 0
    SEL.refresh()
end

function SEL.connectEvents()
    if SEL.evConn then return end
    local ev = workspace:FindFirstChild("ExplorerSelectionChanged")
    if ev and ev:IsA("BindableEvent") then
        SEL.evConn = bind(ev.Event, function()
            if SEL.pending then return end
            SEL.pending = true
            task.defer(function()
                SEL.pending = false
                if alive() then pcall(SEL.refresh) end
            end)
        end)
    end
end

function SEL.start()
    if SEL.running then return end
    SEL.running = true
    task.spawn(function()
        local tick = 0
        while alive() do
            task.wait(0.6)
            tick = tick + 1
            if tick % 8 == 1 then SEL.connectEvents() end
            local ok, err = pcall(SEL.refresh)
            if not ok and tick % 20 == 1 then logLine("SEL.refresh: " .. tostring(err), "warn") end
        end
    end)
end

-- ---- Geometri bersama (dipakai OPS & TOOL) ----
local function pivotOf(inst)
    if inst:IsA("Model") then
        local ok, cf = pcall(function() return inst:GetPivot() end)
        return ok and cf or nil
    elseif inst:IsA("BasePart") then
        return inst.CFrame
    end
    return nil
end

local function setPivotOf(inst, cf)
    if inst:IsA("Model") then
        pcall(function() inst:PivotTo(cf) end)
    elseif inst:IsA("BasePart") then
        pcall(function() inst.CFrame = cf end)
    end
end

local function itemBox(inst)
    if inst:IsA("BasePart") then return inst.CFrame, inst.Size end
    if inst:IsA("Model") then
        local ok, cf, size = pcall(function() return inst:GetBoundingBox() end)
        if ok and cf then return cf, size end
    end
    return nil
end

-- pusat & ukuran AABB dunia dari banyak item
local function aabbOf(items)
    local minV, maxV
    local function take(p)
        if not minV then
            minV, maxV = p, p
        else
            minV = Vector3.new(math.min(minV.X, p.X), math.min(minV.Y, p.Y), math.min(minV.Z, p.Z))
            maxV = Vector3.new(math.max(maxV.X, p.X), math.max(maxV.Y, p.Y), math.max(maxV.Z, p.Z))
        end
    end
    for _, it in ipairs(items) do
        local cf, size = itemBox(it)
        if cf then
            local hx, hy, hz = size.X / 2, size.Y / 2, size.Z / 2
            for sx = -1, 1, 2 do
                for sy = -1, 1, 2 do
                    for sz = -1, 1, 2 do
                        take((cf * CFrame.new(sx * hx, sy * hy, sz * hz)).Position)
                    end
                end
            end
        end
    end
    if not minV then return nil end
    return (minV + maxV) / 2, maxV - minV
end

-- item yang bisa ditransform: Model / BasePart tingkat atas yang tidak diproteksi
local function xformItems(list)
    local pool = {}
    for _, i in ipairs(list) do
        if (i:IsA("Model") or i:IsA("BasePart")) and not isProtected(i) then pool[#pool + 1] = i end
    end
    return topLevel(pool)
end

-- bingkai gizmo: CFrame pusat + ukuran. local+single = kotak berorientasi objek, selain itu AABB dunia
local function gizmoFrame(items, space)
    if #items == 0 then return nil end
    if #items == 1 and space == "local" then
        local cf, size = itemBox(items[1])
        if cf then return cf, size end
    end
    local center, size = aabbOf(items)
    if not center then return nil end
    local rot = CFrame.new()
    if space == "local" then
        local pv = pivotOf(items[#items])
        if pv then rot = pv - pv.Position end
    end
    return CFrame.new(center) * rot, size
end

local function captureState(items)
    local out = {}
    for _, it in ipairs(items) do
        local st = { inst = it, pivot = pivotOf(it) }
        if it:IsA("BasePart") then st.size = it.Size end
        if it:IsA("Model") then
            local ok, sc = pcall(function() return it:GetScale() end)
            if ok then st.scale = sc end
        end
        if st.pivot then out[#out + 1] = st end
    end
    return out
end

local function applyState(st)
    local inst = st.inst
    if not inst or not inst:IsDescendantOf(game) then return end
    if st.scale and inst:IsA("Model") then pcall(function() inst:ScaleTo(st.scale) end) end
    if st.size and inst:IsA("BasePart") then pcall(function() inst.Size = st.size end) end
    setPivotOf(inst, st.pivot)
end

local function applyStates(states)
    for _, st in ipairs(states) do applyState(st) end
end

-- ---- Operasi atas seleksi ----
local function needSel(silent)
    pcall(SEL.refresh)
    local list = {}
    for _, i in ipairs(SEL.list) do
        if not isProtected(i) then list[#list + 1] = i end
    end
    if #list == 0 then
        if not silent then notify("Pilih objek dulu (di Studio Lite atau lewat tab Studio).", "warn") end
        return nil
    end
    return list
end

local function partsOf(list, desc)
    local out, seen = {}, {}
    local function add(p)
        if not seen[p] and p:IsA("BasePart") and not p:IsA("Terrain") then
            seen[p] = true
            out[#out + 1] = p
        end
    end
    for _, i in ipairs(list) do
        add(i)
        if desc then
            for _, d in ipairs(i:GetDescendants()) do add(d) end
        end
    end
    return out
end

-- keadaan properti boolean pada seleksi: "on" / "off" / "mixed" / nil (tidak ada part)
function OPS.stateOf(prop)
    local parts = partsOf(SEL.list, CONFIG.OpDescendants)
    if #parts == 0 then return nil, 0 end
    local on, off = false, false
    for i, p in ipairs(parts) do
        if i > 3000 then break end
        local ok, v = pcall(function() return p[prop] end)
        if ok then
            if v then on = true else off = true end
        end
        if on and off then return "mixed", #parts end
    end
    return (on and "on" or "off"), #parts
end

local BOOL_LABEL = { Anchored = "Anchor", CanCollide = "CanCollide", CanTouch = "CanTouch", CanQuery = "CanQuery" }

-- mode: "on" | "off" | "toggle"
function OPS.setBool(prop, mode)
    local list = needSel()
    if not list then return false end
    local parts = partsOf(list, CONFIG.OpDescendants)
    if #parts == 0 then notify("Seleksi tidak berisi part.", "warn") return false end
    local anyFalse = false
    for _, p in ipairs(parts) do
        local ok, v = pcall(function() return p[prop] end)
        if ok and v == false then anyFalse = true break end
    end
    local value
    if mode == "on" then value = true elseif mode == "off" then value = false else value = anyFalse end
    local old = {}
    for i, p in ipairs(parts) do
        local ok, v = pcall(function() return p[prop] end)
        if ok then old[i] = v end -- false harus tetap tersimpan
    end
    local function setAll(vals)
        for i, p in ipairs(parts) do
            local v
            if vals then v = vals[i] else v = value end
            if v ~= nil and p:IsDescendantOf(game) then pcall(function() p[prop] = v end) end
        end
    end
    setAll(nil)
    local label = (BOOL_LABEL[prop] or prop) .. " " .. (value and "ON" or "OFF") .. " (" .. #parts .. ")"
    HIST.push(label, function() setAll(old) end, function() setAll(nil) end)
    notify(label, "ok")
    fire("selection2")
    return true
end

function OPS.group()
    local list = needSel()
    if not list then return false end
    local items = topLevel(list)
    if #items == 0 then return false end
    local parent = items[1].Parent
    local old = {}
    local model = Instance.new("Model")
    model.Name = "Model"
    model.Parent = parent
    for i, it in ipairs(items) do
        old[i] = it.Parent
        pcall(function() it.Parent = model end)
    end
    if #model:GetChildren() == 0 then
        model:Destroy()
        notify("Group gagal: objek tidak bisa dipindah.", "err")
        return false
    end
    SEL.set({ model })
    HIST.push("Group (" .. #items .. ")", function()
        for i, it in ipairs(items) do pcall(function() it.Parent = old[i] end) end
        model.Parent = nil
        SEL.set(items)
    end, function()
        model.Parent = parent
        for _, it in ipairs(items) do pcall(function() it.Parent = model end) end
        SEL.set({ model })
    end)
    notify("Group: " .. #items .. " objek -> Model", "ok")
    return true
end

local UNGROUPABLE = { Model = true, Folder = true, Actor = true }

function OPS.ungroup()
    local list = needSel()
    if not list then return false end
    local conts = {}
    for _, i in ipairs(topLevel(list)) do
        if UNGROUPABLE[i.ClassName] then conts[#conts + 1] = i end
    end
    if #conts == 0 then notify("Ungroup butuh Model / Folder yang terpilih.", "warn") return false end
    local rec, all = {}, {}
    for _, c in ipairs(conts) do
        local parent = c.Parent
        local kids = c:GetChildren()
        rec[#rec + 1] = { c = c, parent = parent, kids = kids }
        for _, k in ipairs(kids) do
            if pcall(function() k.Parent = parent end) then all[#all + 1] = k end
        end
        c.Parent = nil
    end
    SEL.set(all)
    HIST.push("Ungroup (" .. #conts .. ")", function()
        for _, r in ipairs(rec) do
            r.c.Parent = r.parent
            for _, k in ipairs(r.kids) do pcall(function() k.Parent = r.c end) end
        end
        SEL.set(conts)
    end, function()
        for _, r in ipairs(rec) do
            for _, k in ipairs(r.kids) do pcall(function() k.Parent = r.parent end) end
            r.c.Parent = nil
        end
        SEL.set(all)
    end)
    notify(string.format("Ungroup: %d container, %d objek dilepas", #conts, #all), "ok")
    return true
end

function OPS.delete()
    local list = needSel()
    if not list then return false end
    local items = topLevel(list)
    local old = {}
    for i, it in ipairs(items) do
        old[i] = it.Parent
        it.Parent = nil
    end
    SEL.set({})
    HIST.push("Hapus (" .. #items .. ")", function()
        for i, it in ipairs(items) do pcall(function() it.Parent = old[i] end) end
        SEL.set(items)
    end, function()
        for _, it in ipairs(items) do pcall(function() it.Parent = nil end) end
        SEL.set({})
    end)
    notify("Dihapus: " .. #items .. " objek (bisa di-undo)", "ok")
    return true
end

function OPS.duplicate()
    local list = needSel()
    if not list then return false end
    local items = topLevel(list)
    local clones, parents = {}, {}
    for _, it in ipairs(items) do
        local okc, c = pcall(function() return it:Clone() end)
        if okc and c then
            c.Parent = it.Parent
            clones[#clones + 1] = c
            parents[#parents + 1] = it.Parent
        end
    end
    if #clones == 0 then notify("Duplikat gagal (objek tidak Archivable?).", "err") return false end
    SEL.set(clones)
    HIST.push("Duplikat (" .. #clones .. ")", function()
        for _, c in ipairs(clones) do pcall(function() c.Parent = nil end) end
        SEL.set(items)
    end, function()
        for i, c in ipairs(clones) do pcall(function() c.Parent = parents[i] end) end
        SEL.set(clones)
    end)
    notify("Duplikat: " .. #clones .. " objek (di tempat yang sama)", "ok")
    return true
end

-- Anchor semua part seleksi dan simpan nilai asli di atribut SL_OrigAnchored
function OPS.freezeSel()
    local list = needSel()
    if not list then return false end
    local parts = partsOf(list, true)
    local changed = {}
    for _, p in ipairs(parts) do
        local ok, a = pcall(function() return p.Anchored end)
        if ok and a == false then
            pcall(function() p:SetAttribute("SL_OrigAnchored", false) end)
            pcall(function() p.Anchored = true end)
            changed[#changed + 1] = p
        end
    end
    if #changed == 0 then notify("Semua part sudah ter-anchor.", "info") return false end
    HIST.push("Freeze (" .. #changed .. ")", function()
        for _, p in ipairs(changed) do
            pcall(function() p.Anchored = false end)
            pcall(function() p:SetAttribute("SL_OrigAnchored", nil) end)
        end
    end, function()
        for _, p in ipairs(changed) do
            pcall(function() p:SetAttribute("SL_OrigAnchored", false) end)
            pcall(function() p.Anchored = true end)
        end
    end)
    notify("Freeze: " .. #changed .. " part di-anchor", "ok")
    return true
end

-- Kembalikan Anchored = false untuk part yang di-anchor otomatis (atribut SL_OrigAnchored)
function OPS.restoreAnchors()
    local list = needSel(true)
    if not list then
        local last = S.history[#S.history]
        list = last and last.objs or nil
        if not list then notify("Pilih objek (atau import dulu) lalu coba lagi.", "warn") return false end
    end
    local parts = partsOf(list, true)
    local changed = {}
    for _, p in ipairs(parts) do
        local ok, orig = pcall(function() return p:GetAttribute("SL_OrigAnchored") end)
        if ok and orig == false then changed[#changed + 1] = p end
    end
    if #changed == 0 then notify("Tidak ada part ber-anchor otomatis di seleksi.", "info") return false end
    for _, p in ipairs(changed) do
        pcall(function() p.Anchored = false end)
        pcall(function() p:SetAttribute("SL_OrigAnchored", nil) end)
    end
    HIST.push("Lepas anchor asli (" .. #changed .. ")", function()
        for _, p in ipairs(changed) do
            pcall(function() p:SetAttribute("SL_OrigAnchored", false) end)
            pcall(function() p.Anchored = true end)
        end
    end, function()
        for _, p in ipairs(changed) do
            pcall(function() p.Anchored = false end)
            pcall(function() p:SetAttribute("SL_OrigAnchored", nil) end)
        end
    end)
    notify("Anchor asli dikembalikan: " .. #changed .. " part", "ok")
    return true
end

-- ---- Transform numerik / perintah transform (dipakai gizmo juga) ----
function OPS.commitTransform(name, before, after)
    HIST.push(name, function() applyStates(before) end, function() applyStates(after) end)
end

function OPS.setPosition(pos)
    local list = needSel()
    if not list then return false end
    local items = xformItems(list)
    if #items == 0 then return false end
    local center = aabbOf(items)
    if not center then return false end
    local before = captureState(items)
    local delta = pos - center
    for _, st in ipairs(before) do setPivotOf(st.inst, st.pivot + delta) end
    OPS.commitTransform("Posisi", before, captureState(items))
    TOOL.update()
    return true
end

-- derajat Euler (X, Y, Z), hanya untuk satu objek
function OPS.setRotation(deg)
    local list = needSel()
    if not list then return false end
    local items = xformItems(list)
    if #items ~= 1 then notify("Rotasi numerik butuh tepat satu objek terpilih.", "warn") return false end
    local before = captureState(items)
    local pv = before[1] and before[1].pivot
    if not pv then return false end
    setPivotOf(items[1], CFrame.new(pv.Position) * CFrame.fromOrientation(math.rad(deg.X), math.rad(deg.Y), math.rad(deg.Z)))
    OPS.commitTransform("Rotasi", before, captureState(items))
    TOOL.update()
    return true
end

-- Part: ukuran (Vector3). Model: skala seragam (angka)
function OPS.setSize(value)
    local list = needSel()
    if not list then return false end
    local items = xformItems(list)
    if #items ~= 1 then notify("Ukuran numerik butuh tepat satu objek terpilih.", "warn") return false end
    local it = items[1]
    local before = captureState(items)
    if it:IsA("BasePart") and typeof(value) == "Vector3" then
        pcall(function()
            it.Size = Vector3.new(math.clamp(value.X, 0.05, 2048), math.clamp(value.Y, 0.05, 2048), math.clamp(value.Z, 0.05, 2048))
        end)
    elseif it:IsA("Model") and type(value) == "number" then
        pcall(function() it:ScaleTo(math.clamp(value, 0.01, 100)) end)
        if before[1] then setPivotOf(it, before[1].pivot) end
    else
        return false
    end
    OPS.commitTransform("Ukuran", before, captureState(items))
    TOOL.update()
    return true
end

-- ---- Pilih cepat ----
function OPS.selectChildren()
    local list = needSel()
    if not list then return false end
    local out = {}
    for _, i in ipairs(list) do
        for _, c in ipairs(i:GetChildren()) do out[#out + 1] = c end
    end
    if #out == 0 then notify("Seleksi tidak punya anak.", "info") return false end
    SEL.set(out)
    return true
end

function OPS.selectTarget()
    local t = E.getTarget()
    if not t then notify("Target import tidak ditemukan.", "warn") return false end
    SEL.set({ t })
    return true
end

function OPS.selectLastImport()
    local last = S.history[#S.history]
    if not last or #last.objs == 0 then notify("Belum ada hasil import di sesi ini.", "warn") return false end
    SEL.set(last.objs)
    return true
end

function OPS.clearSelection()
    SEL.set({})
end

