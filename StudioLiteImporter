    local function paintPluginCard(p)
        local c = pCards[p.key]
        if not c then return end
        c.name.Text = (p.meta and p.meta.name or p.key) .. ((p.meta and p.meta.version ~= "") and ("  v" .. p.meta.version) or "")
        local info = {}
        if p.meta and p.meta.author ~= "" then info[#info + 1] = "oleh " .. p.meta.author end
        if p.meta and p.meta.desc ~= "" then info[#info + 1] = p.meta.desc end
        info[#info + 1] = p.key
        c.meta.Text = table.concat(info, "  |  ")
        local on = p.loaded
        c.toggle.Text = on and "Matikan" or "Aktifkan"
        c.toggle.BackgroundColor3 = on and Color3.fromRGB(150, 70, 60) or T.ok
        c.reload.Visible = on
        if p.err then
            c.err.Text = "Error: " .. tostring(p.err):sub(1, 140)
            c.err.Visible = true
        else
            c.err.Visible = false
        end
    end

    local function buildPluginCard(p, order)
        local card = make("Frame", {
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.row,
            BorderSizePixel = 0, LayoutOrder = order,
        }, pgList)
        corner(card, 8)
        make("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, card)
        make("UIPadding", { PaddingBottom = UDim.new(0, 8) }, card)
        local head = make("Frame", { Size = UDim2.new(1, 0, 0, 46), BackgroundTransparency = 1, LayoutOrder = 1 }, card)
        local c = { card = card }
        c.name = label(head, { Position = UDim2.fromOffset(10, 5), Size = UDim2.new(1, -150, 0, 16), Font = Enum.Font.GothamBold, TextSize = 12, TextTruncate = Enum.TextTruncate.AtEnd })
        c.meta = label(head, { Position = UDim2.fromOffset(10, 22), Size = UDim2.new(1, -150, 0, 20), TextSize = 10, TextColor3 = T.sub, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top })
        c.toggle = button(head, "Aktifkan", T.ok, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(76, 28), TextSize = 11 })
        c.reload = button(head, "Reload", T.panel2, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -90, 0.5, 0), Size = UDim2.fromOffset(52, 28), TextSize = 11, Visible = false })
        c.err = label(card, { Size = UDim2.new(1, -20, 0, 28), Position = UDim2.fromOffset(10, 0), TextSize = 10, TextColor3 = T.err, TextWrapped = true,
            TextYAlignment = Enum.TextYAlignment.Top, Visible = false, LayoutOrder = 2 })
        c.body = make("Frame", { Size = UDim2.new(1, -16, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 3 }, card)
        make("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, c.body)
        local pad = make("UIPadding", { PaddingLeft = UDim.new(0, 8) }, c.body)
        pCards[p.key] = c
        bind(c.toggle.MouseButton1Click, function()
            if p.loaded then
                PLG.disable(p)
                return
            end
            if not PLG.enabled[p.key] and not (confirmKey == p.key and os.clock() - confirmAt < 4) then
                confirmKey, confirmAt = p.key, os.clock()
                c.toggle.Text = "Yakin?"
                task.delay(4, function()
                    if alive() and confirmKey == p.key then
                        confirmKey = nil
                        paintPluginCard(p)
                    end
                end)
                setStatus("Plugin berjalan dengan hak executor penuh. Tap \"Yakin?\" sekali lagi jika kamu mempercayainya.", "warn")
                return
            end
            confirmKey = nil
            PLG.enable(p)
        end)
        bind(c.reload.MouseButton1Click, function() PLG.load(p) end)
        return c
    end

    local function renderPlugins()
        local keep = {}
        for i, p in ipairs(PLG.list) do
            keep[p.key] = true
            local c = pCards[p.key] or buildPluginCard(p, i)
            c.card.LayoutOrder = i
            paintPluginCard(p)
        end
        for key, c in pairs(pCards) do
            if not keep[key] then
                c.card:Destroy()
                pCards[key] = nil
            end
        end
        pgEmpty.Visible = #PLG.list == 0
    end
