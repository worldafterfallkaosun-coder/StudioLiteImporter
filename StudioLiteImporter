        nameLbl.Text = e.name
        local info = S.infoCache[e.path]
        local lines = {}
        if not info then
            lines[1] = "Membaca file..."
        elseif info.err then
            lines[1] = info.err
        else
            lines[1] = info.format .. " | " .. fmtBytes(info.size)
            if info.w then lines[2] = info.w .. " x " .. info.h .. " px" end
            if info.objects then
                lines[2] = info.objects .. " objek | " .. info.scripts .. " script"
                lines[3] = "Root: " .. info.rootClass .. " \"" .. info.rootName .. "\""
                    .. ((info.roots or 1) > 1 and (" +" .. (info.roots - 1)) or "")
            elseif info.skipped then
                lines[2] = "File besar, isi tidak dianalisis"
            elseif info.parseErr then
                lines[2] = "Isi tidak terbaca: " .. info.parseErr:sub(1, 60)
            end
        end
        if layout.wide then
            lines[#lines + 1] = "Folder: " .. ((e.dir == "") and "(root)" or e.dir)
            local st = S.status[e.path]
            if st == "ok" then lines[#lines + 1] = "Status: berhasil diimport"
