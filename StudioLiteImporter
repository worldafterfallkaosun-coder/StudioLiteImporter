-- ---- Scan ----
local function rescan(silent)
    if S.scanning or not alive() then return end
    S.scanning = true
    fire("scanning", true)
    local okS, entries, info = pcall(scanFiles, CONFIG.ScanScope, function() task.wait() end)
    if not okS then
        S.scanning = false
        fire("scanning", false)
        notify("Scan error: " .. tostring(entries), "err")
        return
    end

    sortList(entries, "name")
    local paths, alive_, fresh = {}, {}, {}
    for i, e in ipairs(entries) do
        paths[i] = e.path
        alive_[e.path] = true
        if S.firstScan and not S.known[e.path] then fresh[#fresh + 1] = e end
    end
    local sig = #entries .. ":" .. table.concat(paths, "|")
    local changed = sig ~= S.sig
    if changed then
        S.sig = sig
        S.entries = entries
        for p in pairs(S.selected) do if not alive_[p] then S.selected[p] = nil end end
        for p in pairs(S.status) do if not alive_[p] then S.status[p] = nil end end
        for _, e in ipairs(entries) do S.known[e.path] = true end
        if S.focus and not alive_[S.focus.path] then S.focus = nil end
        E.applyView()
        fire("selection")
        fire("focus")
    end
    S.scanning = false
    fire("scanning", false)

    if info.err then
        notify(info.err, "err")
    elseif not silent or (changed and S.firstScan) then
        local msg
        if #fresh > 0 and silent then
            msg = string.format("%d file baru terdeteksi (total %d)", #fresh, #entries)
        else
            msg = string.format("Scan selesai: %d file (model, place, gambar, audio)", #entries)
            if info.truncated then msg = msg .. " (dibatasi " .. CONFIG.MaxEntries .. " entri)" end
        end
        if not silent or #fresh > 0 then notify(msg, "ok") else setStatus(msg, "info") end
    end
    S.firstScan = true

    -- auto-import file baru dari folder import
    if CONFIG.AutoImportNew and #fresh > 0 and not S.busy then
        local pick = {}
        for _, e in ipairs(fresh) do
            if e.path:sub(1, #CONFIG.Folder + 1) == CONFIG.Folder .. "/" then pick[#pick + 1] = e end
        end
        if #pick > 0 then E.runBatch(pick) end
    end
end

function E.rescan(silent) task.spawn(rescan, silent) end

