    local function renderList()
        local n = #S.view
        local canvasH = n * ROW_H + 6
        if canvasH ~= lastCanvasH then
            lastCanvasH = canvasH
            list.CanvasSize = UDim2.new(0, 0, 0, canvasH)
        end
        local need = math.ceil(math.max(list.AbsoluteSize.Y, 60) / ROW_H) + 3
        while #pool < need do pool[#pool + 1] = makeRow() end
        local first = math.max(1, math.floor(list.CanvasPosition.Y / ROW_H) + 1)
        for i, row in ipairs(pool) do
            local e = S.view[first + i - 1]
            if e then
                row.entry = e
                row.frame.Position = UDim2.fromOffset(4, (first + i - 2) * ROW_H + 3)
                row.frame.Visible = true
                paintRow(row)
            else
                row.entry = nil
                row.frame.Visible = false
            end
        end
        if n == 0 then
            if S.scanning then
                emptyLbl.Text = "Memindai file..."
            elseif #S.entries == 0 then
                emptyLbl.Text = "Belum ada file .rbxm .rbxmx .rbxl .png .jpg .mp3 .ogg.\nTaruh di folder " .. CONFIG.Folder
                    .. " lalu tekan Scan, atau ketik path file di kolom cari lalu Enter."
            else
