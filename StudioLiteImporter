        row.frame.BackgroundColor3 = sel and T.rowSel or (focus and T.rowFocus or T.row)
        row.stroke.Transparency = focus and 0 or 1
        row.fill.Visible = sel and true or false
        row.name.Text = e.name
        row.dir.Text = (e.dir == "") and "(root)" or e.dir
        row.badge.Text = e.ext:upper()
        row.badge.TextColor3 = KIND_COLOR[e.kind] or T.accent
        local st = S.status[e.path]
        if st == "ok" then
            row.state.Text, row.state.TextColor3 = "OK", T.okText
        elseif st == "fail" then
            row.state.Text, row.state.TextColor3 = "GAGAL", T.err
        elseif st == "busy" then
            row.state.Text, row.state.TextColor3 = "...", T.warn
        else
