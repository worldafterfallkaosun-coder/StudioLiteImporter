local VT = {}

local NUMT = { int = true, int64 = true, float = true, double = true }
local INTT = { int = true, int64 = true }

function VT.kind(ty)
    if ty == "bool" then return "bool" end
    if NUMT[ty] then return "num" end
    if ty == "string" then return "str" end
    if ty == "Content" then return "content" end
    if ty == "Vector3" then return "vec3" end
    if ty == "Vector2" then return "vec2" end
    if ty == "Vector3int16" then return "vec3i" end
    if ty == "Color3" then return "color3" end
    if ty == "BrickColor" then return "brick" end
    if ty == "CFrame" then return "cframe" end
    if ty == "UDim" then return "udim" end
    if ty == "UDim2" then return "udim2" end
    if ty == "Rect" then return "rect" end
    if ty == "NumberRange" then return "range" end
    if ty == "Font" then return "font" end
    if ty:sub(1, 2) == "E:" then return "enum" end
    if ty:sub(1, 2) == "I:" then return "inst" end
    return "ro"
end

-- tipe Lua -> tipe DB (untuk attribute)
local function typeOfValue(v)
    local t = typeof(v)
    if t == "string" then return "string" end
    if t == "boolean" then return "bool" end
    if t == "number" then return "double" end
    if t == "Instance" then return "I:Instance" end
    if t == "EnumItem" then return "E:" .. tostring(v.EnumType):gsub("^Enum%.", "") end
    return t
end

function VT.fmt(v, ty)
    local k = VT.kind(ty)
    if v == nil then return k == "inst" and "nil" or "" end
    if k == "num" then
        if INTT[ty] then return tostring(math.floor(v + 0.5)) end
        return fnum(v)
    elseif k == "str" then return tostring(v)
    elseif k == "content" then
        local ok, s = pcall(function()
            if typeof(v) == "Content" then return v.Uri or tostring(v) end
            return tostring(v)
        end)
        return ok and (s or "") or tostring(v)
    elseif k == "vec3" then return fnum(v.X) .. ", " .. fnum(v.Y) .. ", " .. fnum(v.Z)
    elseif k == "vec2" then return fnum(v.X) .. ", " .. fnum(v.Y)
    elseif k == "vec3i" then return v.X .. ", " .. v.Y .. ", " .. v.Z
    elseif k == "color3" then
        return math.floor(v.R * 255 + 0.5) .. ", " .. math.floor(v.G * 255 + 0.5) .. ", " .. math.floor(v.B * 255 + 0.5)
    elseif k == "brick" then return v.Name
    elseif k == "cframe" then
        local c = { v:GetComponents() }
        for i = 1, #c do c[i] = fnum(c[i]) end
        return table.concat(c, ", ")
    elseif k == "udim" then return fnum(v.Scale) .. ", " .. fnum(v.Offset)
    elseif k == "udim2" then
        return "{" .. fnum(v.X.Scale) .. ", " .. fnum(v.X.Offset) .. "}, {" .. fnum(v.Y.Scale) .. ", " .. fnum(v.Y.Offset) .. "}"
    elseif k == "rect" then return fnum(v.Min.X) .. ", " .. fnum(v.Min.Y) .. ", " .. fnum(v.Max.X) .. ", " .. fnum(v.Max.Y)
    elseif k == "range" then return fnum(v.Min) .. ", " .. fnum(v.Max)
    elseif k == "font" then
        local ok, s = pcall(function() return tostring(v.Family):match("([^/]+)%.json$") or tostring(v.Family) end)
        return ok and s or tostring(v)
    elseif k == "enum" then return v.Name
    elseif k == "inst" then return (typeof(v) == "Instance") and v.Name or tostring(v)
    end
    local t = typeof(v)
    if t == "NumberSequence" or t == "ColorSequence" then
        return t .. " (" .. #v.Keypoints .. ")"
    end
    local ok, s = pcall(tostring, v)
    return ok and s or t
end

-- return nilai baru atau nil bila teks tidak valid
function VT.parse(text, ty, cur)
    local k = VT.kind(ty)
    text = tostring(text)
    if k == "num" then
        local n = tonumber(text)
        if not n then
            local t = nums(text)
            n = (#t == 1) and t[1] or nil
        end
        if not n then return nil end
        if INTT[ty] then n = math.floor(n + 0.5) end
        return n
    elseif k == "str" then return text
    elseif k == "content" then
        if text == "" then return Content and Content.none or nil end
        local id = text:match("^%d+$")
        if id then text = "rbxassetid://" .. id end
        if Content and Content.fromUri then
            local ok, c = pcall(Content.fromUri, text)
            if ok then return c end
        end
        return nil
    elseif k == "vec3" or k == "vec3i" then
        local t = nums(text)
        if #t == 1 then t = { t[1], t[1], t[1] } end
        if #t ~= 3 then return nil end
        if k == "vec3i" then return Vector3int16.new(t[1], t[2], t[3]) end
        return Vector3.new(t[1], t[2], t[3])
    elseif k == "vec2" then
        local t = nums(text)
        if #t == 1 then t = { t[1], t[1] } end
        if #t ~= 2 then return nil end
        return Vector2.new(t[1], t[2])
    elseif k == "color3" then
        local hex = text:match("#?(%x%x%x%x%x%x)$")
        if hex and not text:find(",") and #text <= 7 then
            return rgb(tonumber(hex:sub(1, 2), 16), tonumber(hex:sub(3, 4), 16), tonumber(hex:sub(5, 6), 16))
        end
        local t = nums(text)
        if #t ~= 3 then return nil end
        local mx = math.max(t[1], t[2], t[3])
        if mx <= 1 and text:find("%.") then return Color3.new(t[1], t[2], t[3]) end
        return rgb(math.clamp(t[1], 0, 255), math.clamp(t[2], 0, 255), math.clamp(t[3], 0, 255))
    elseif k == "brick" then
        local n = tonumber(text)
        if n then
            local ok, b = pcall(BrickColor.new, n)
            return ok and b or nil
        end
        local ok, b = pcall(BrickColor.new, text)
        if ok and b and b.Name:lower() == text:lower() then return b end
        return nil
    elseif k == "cframe" then
        local t = nums(text)
        if #t == 12 then return CFrame.new(unpack(t)) end
        if #t == 3 and cur then return CFrame.new(t[1], t[2], t[3]) * (cur - cur.Position) end
        if #t == 3 then return CFrame.new(t[1], t[2], t[3]) end
        return nil
    elseif k == "udim" then
        local t = nums(text)
        if #t ~= 2 then return nil end
        return UDim.new(t[1], t[2])
    elseif k == "udim2" then
        local t = nums(text)
        if #t ~= 4 then return nil end
        return UDim2.new(t[1], t[2], t[3], t[4])
    elseif k == "rect" then
        local t = nums(text)
        if #t ~= 4 then return nil end
        return Rect.new(t[1], t[2], t[3], t[4])
    elseif k == "range" then
        local t = nums(text)
        if #t == 1 then t = { t[1], t[1] } end
        if #t ~= 2 then return nil end
        return NumberRange.new(math.min(t[1], t[2]), math.max(t[1], t[2]))
    end
    return nil
end

local function comp(label, get, set, int)
    return { label = label, get = get, set = set, int = int }
end

-- komponen yang bisa dibuka (X / Y / Z, R / G / B, ...)
function VT.comps(ty)
    local k = VT.kind(ty)
    if k == "vec3" then
        return { comp("X", function(v) return v.X end, function(v, n) return Vector3.new(n, v.Y, v.Z) end),
            comp("Y", function(v) return v.Y end, function(v, n) return Vector3.new(v.X, n, v.Z) end),
            comp("Z", function(v) return v.Z end, function(v, n) return Vector3.new(v.X, v.Y, n) end) }
    elseif k == "vec2" then
        return { comp("X", function(v) return v.X end, function(v, n) return Vector2.new(n, v.Y) end),
            comp("Y", function(v) return v.Y end, function(v, n) return Vector2.new(v.X, n) end) }
    elseif k == "color3" then
        local function ch(i)
            return function(v) return ({ v.R, v.G, v.B })[i] * 255 end,
                function(v, n)
                    local c = { v.R * 255, v.G * 255, v.B * 255 }
                    c[i] = math.clamp(n, 0, 255)
                    return rgb(c[1], c[2], c[3])
                end
        end
        local gr, sr = ch(1)
        local gg, sg = ch(2)
        local gb, sb = ch(3)
        return { comp("R", gr, sr, true), comp("G", gg, sg, true), comp("B", gb, sb, true) }
    elseif k == "udim" then
        return { comp("Scale", function(v) return v.Scale end, function(v, n) return UDim.new(n, v.Offset) end),
            comp("Offset", function(v) return v.Offset end, function(v, n) return UDim.new(v.Scale, math.floor(n + 0.5)) end, true) }
    elseif k == "udim2" then
        return { comp("X Scale", function(v) return v.X.Scale end, function(v, n) return UDim2.new(n, v.X.Offset, v.Y.Scale, v.Y.Offset) end),
            comp("X Offset", function(v) return v.X.Offset end, function(v, n) return UDim2.new(v.X.Scale, math.floor(n + 0.5), v.Y.Scale, v.Y.Offset) end, true),
            comp("Y Scale", function(v) return v.Y.Scale end, function(v, n) return UDim2.new(v.X.Scale, v.X.Offset, n, v.Y.Offset) end),
            comp("Y Offset", function(v) return v.Y.Offset end, function(v, n) return UDim2.new(v.X.Scale, v.X.Offset, v.Y.Scale, math.floor(n + 0.5)) end, true) }
    elseif k == "range" then
        return { comp("Min", function(v) return v.Min end, function(v, n) return NumberRange.new(n, math.max(n, v.Max)) end),
            comp("Max", function(v) return v.Max end, function(v, n) return NumberRange.new(math.min(v.Min, n), n) end) }
    end
    return nil
end

-- CFrame: Position + Orientation (derajat) sebagai dua sub-baris bertipe Vector3
function VT.cframeParts()
    return {
        { label = "Position", ty = "Vector3",
            get = function(v) return v.Position end,
            set = function(v, nv) return CFrame.new(nv) * (v - v.Position) end },
        { label = "Orientation", ty = "Vector3",
            get = function(v)
                local rx, ry, rz = v:ToOrientation()
                return Vector3.new(math.deg(rx), math.deg(ry), math.deg(rz))
            end,
            set = function(v, nv)
                return CFrame.new(v.Position) * CFrame.fromOrientation(math.rad(nv.X), math.rad(nv.Y), math.rad(nv.Z))
            end },
    }
end

function VT.equal(a, b)
    if a == b then return true end
    if type(a) == "number" and type(b) == "number" then return math.abs(a - b) < 1e-4 end
    if typeof(a) == "CFrame" and typeof(b) == "CFrame" then
        local ca, cb = { a:GetComponents() }, { b:GetComponents() }
        for i = 1, 12 do
            if math.abs(ca[i] - cb[i]) > 1e-4 then return false end
        end
        return true
    end
    if typeof(a) == "Vector3" and typeof(b) == "Vector3" then return (a - b).Magnitude < 1e-4 end
    return false
end

-- daftar item enum (urut sesuai Value)
local enumCache = {}
function VT.enumItems(ty)
    local name = ty:sub(3)
    if enumCache[name] then return enumCache[name] end
    local list = {}
    local ok, en = pcall(function() return Enum[name] end)
    if ok and en then
        local ok2, items = pcall(function() return en:GetEnumItems() end)
        if ok2 then
            for _, it in ipairs(items) do list[#list + 1] = it end
            table.sort(list, function(a, b) return a.Value < b.Value end)
        end
    end
    enumCache[name] = list
    return list
end


