function TP.load(reset)
    if TP.loading then return end
    local cat = TB.CATS[TP.cat]
    if not cat then return end
    if reset then
        TP.items, TP.cursor = {}, nil
    end
    local q = TP.query
    -- ID / link langsung
    local direct = (q ~= "") and (q:match("^%s*%d%d%d+%s*$") or q:find("roblox.com", 1, true) or q:find("rbxassetid", 1, true)) and TB.parseId(q)
    if direct then
        TP.items = { { id = direct, kind = cat.id, name = "Asset " .. direct } }
        TP.cursor = nil
        TP.render()
        return
    end
    TP.loading = true
    TP.token = TP.token + 1
    local mine = TP.token
    TP.status.Text = "Loading..."
    TP.render()
    task.spawn(function()
        local okc, items, nextCursor, err = pcall(TB.search, cat, q, TB.SORTS[TP.sort].v, TP.cursor)
        if mine ~= TP.token then return end
        TP.loading = false
        if not okc then
            err = tostring(items)
            items = nil
        end
        if items then
            for _, it in ipairs(items) do TP.items[#TP.items + 1] = it end
            TP.cursor = nextCursor
            TP.status.Text = ""
        else
            TP.status.Text = "Failed: " .. tostring(err)
            notify("Toolbox gagal: " .. tostring(err), "err")
        end
        TP.render()
    end)
end

