        detail.Visible = not compact
        if wide then
            local sideW = 200
            list.Position = UDim2.fromOffset(8, 66)
            list.Size = UDim2.new(1, -(16 + sideW + 8), 1, -(66 + 42))
            detail.AnchorPoint = Vector2.new(1, 0)
            detail.Position = UDim2.new(1, -8, 0, 66)
            detail.Size = UDim2.new(0, sideW, 1, -(66 + 42))
            metaLbl.Size = UDim2.new(1, -20, 1, -64)
            metaLbl.TextWrapped = true
            metaLbl.TextTruncate = Enum.TextTruncate.None
        elseif compact then
            -- layar pendek (HP landscape): strip detail disembunyikan, ringkasan tampil di status bar
            list.Position = UDim2.fromOffset(8, 66)
            list.Size = UDim2.new(1, -16, 1, -(66 + 42))
        else
            list.Position = UDim2.fromOffset(8, 66)
            list.Size = UDim2.new(1, -16, 1, -(66 + 42 + 42))
            detail.AnchorPoint = Vector2.new(0, 0)
            detail.Position = UDim2.new(0, 8, 1, -(42 + 38))
            detail.Size = UDim2.new(1, -16, 0, 38)
            metaLbl.Size = UDim2.new(1, -20, 0, 12)
            metaLbl.TextWrapped = false
            metaLbl.TextTruncate = Enum.TextTruncate.AtEnd
        end
        paintDetail()
        renderList()
    end
    bind(PF:GetPropertyChangedSignal("AbsoluteSize"), relayoutFiles)

    -- ---- event Files ----
    bind(searchBox:GetPropertyChangedSignal("Text"), function()
        S.query = searchBox.Text
        clearBtn.Visible = S.query ~= ""
        E.applyView()
    end)
    bind(searchBox.Focused, function() tween(sstroke, 0.12, { Color = T.accent }) end)
    bind(searchBox.FocusLost, function(enter)
        tween(sstroke, 0.12, { Color = T.line })
        if enter and #S.view == 0 and S.query ~= "" then
            if E.addManual(S.query) then
                searchBox.Text = ""
            else
                setStatus("Tidak ada file yang cocok dengan '" .. S.query .. "'.", "warn")
            end
        end
    end)
    bind(clearBtn.MouseButton1Click, function() searchBox.Text = "" end)

    bind(sortBtn.MouseButton1Click, function()
        local opts = {}
        for _, s in ipairs(SORTS) do opts[#opts + 1] = { text = SORT_LABEL[s], value = s } end
        dropdown(sortBtn, opts, S.sort, function(v)
            S.sort = v
            E.applyView()
            E.saveSettings()
        end)
    end)
    bind(scanBtn.MouseButton1Click, function() E.rescan(false) end)
    bind(selAllBtn.MouseButton1Click, E.selectView)
    bind(selNoneBtn.MouseButton1Click, E.clearSel)

    bind(targetBtn.MouseButton1Click, function()
        if S.busy then return end
        local opts = {}
        for _, t in ipairs(TARGETS) do opts[#opts + 1] = { text = t, value = t } end
        dropdown(targetBtn, opts, S.target, function(v)
            S.target = v
            paintAction()
            E.saveSettings()
        end)
    end)
    bind(scriptsBtn.MouseButton1Click, function()
        CONFIG.DisableScripts = not CONFIG.DisableScripts
        paintAction()
        E.saveSettings()
        if H.settingsRefresh then H.settingsRefresh() end
    end)
    bind(undoBtn.MouseButton1Click, function() E.undo(false) end)
    bind(importBtn.MouseButton1Click, function()
        if S.busy then
            E.cancel()
            paintAction()
            return
        end
        local l = E.selectedList()
        if #l == 0 then
            setStatus("Belum ada file dicentang. Tap baris untuk memilih.", "warn")
            return
        end
        E.runBatch(l)
    end)
    bind(detailBtn.MouseButton1Click, function()
        if S.focus and not S.busy then E.runBatch({ S.focus }) end
    end)

    -- ===============================================================
    -- Halaman LOG
    -- ===============================================================
    local logTool = make("Frame", {
        Position = UDim2.fromOffset(8, 6), Size = UDim2.new(1, -16, 0, 28), BackgroundTransparency = 1,
    }, PL)
    local logClear = button(logTool, "Bersihkan", T.panel2, { Size = UDim2.fromOffset(90, 28), TextSize = 11 })
    local logCopy = button(logTool, "Salin log", T.panel2, {
        Position = UDim2.fromOffset(96, 0), Size = UDim2.fromOffset(90, 28), TextSize = 11,
    })
    local logList = make("ScrollingFrame", {
        Position = UDim2.fromOffset(8, 40), Size = UDim2.new(1, -16, 1, -48), BackgroundColor3 = T.panel,
        BorderSizePixel = 0, ScrollBarThickness = 4, ScrollBarImageColor3 = T.line,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
    }, PL)
    corner(logList, 8)
    make("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, logList)
    make("UIPadding", {
        PaddingTop = UDim.new(0, 5), PaddingBottom = UDim.new(0, 5),
        PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
    }, logList)

    local logRows, logOrder = {}, 0
    local function addLogRow(line)
        local atBottom = logList.CanvasPosition.Y >= logList.AbsoluteCanvasSize.Y - logList.AbsoluteSize.Y - 24
        logOrder = logOrder + 1
        local l = label(logList, {
            Text = "[" .. line.t .. "] " .. line.text, TextColor3 = KIND[line.kind] or T.text, TextSize = 11,
            TextWrapped = true, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0),
            LayoutOrder = logOrder,
        })
        logRows[#logRows + 1] = l
        if #logRows > 150 then table.remove(logRows, 1):Destroy() end
        if atBottom then
            task.defer(function()
                if alive() then logList.CanvasPosition = Vector2.new(0, 1e6) end
            end)
        end
    end
    bind(logClear.MouseButton1Click, function()
        for _, l in ipairs(logRows) do l:Destroy() end
        logRows = {}
        S.log = {}
    end)
    bind(logCopy.MouseButton1Click, function()
        local parts = {}
        for _, l in ipairs(S.log) do parts[#parts + 1] = "[" .. l.t .. "] " .. l.text end
        local clip = setclipboard or toclipboard
        if clip and pcall(clip, table.concat(parts, "\n")) then
            setStatus("Log disalin ke clipboard.", "ok")
        else
            setStatus("Executor tidak punya setclipboard.", "err")
        end
    end)

    -- ===============================================================
    -- Halaman PENGATURAN
    -- ===============================================================
    local setList = make("ScrollingFrame", {
        Position = UDim2.fromOffset(8, 6), Size = UDim2.new(1, -16, 1, -12), BackgroundTransparency = 1,
        BorderSizePixel = 0, ScrollBarThickness = 4, ScrollBarImageColor3 = T.line,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
    }, PS)
    make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, setList)
    make("UIPadding", { PaddingRight = UDim.new(0, 6), PaddingBottom = UDim.new(0, 8) }, setList)

    local order = 0
    local function nextOrder()
        order = order + 1
        return order
    end
    local refreshers = {}

    local function section(text)
        label(setList, {
            Text = string.upper(text), TextColor3 = T.sub, Font = Enum.Font.GothamBold, TextSize = 10,
            Size = UDim2.new(1, 0, 0, 18), LayoutOrder = nextOrder(),
        })
    end

    local function switchRow(title, desc, key, onChange)
        local row = make("Frame", {
            Size = UDim2.new(1, 0, 0, 54), BackgroundColor3 = T.panel, BorderSizePixel = 0, LayoutOrder = nextOrder(),
        }, setList)
        corner(row, 8)
        label(row, {
            Text = title, Position = UDim2.fromOffset(10, 6), Size = UDim2.new(1, -68, 0, 16), Font = Enum.Font.GothamMedium,
        })
        label(row, {
            Text = desc, Position = UDim2.fromOffset(10, 24), Size = UDim2.new(1, -68, 0, 26), TextSize = 10,
            TextColor3 = T.sub, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top,
        })
        local track = make("TextButton", {
            Text = "", AutoButtonColor = false, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
            Size = UDim2.fromOffset(40, 22), BorderSizePixel = 0, BackgroundColor3 = T.line,
        }, row)
        corner(track, 11)
        local knob = make("Frame", {
            Size = UDim2.fromOffset(16, 16), Position = UDim2.fromOffset(3, 3), BackgroundColor3 = T.white, BorderSizePixel = 0,
        }, track)
        corner(knob, 8)
        local function paint()
            local on = CONFIG[key] == true
            tween(track, 0.12, { BackgroundColor3 = on and T.accent or T.line })
            tween(knob, 0.12, { Position = UDim2.fromOffset(on and 21 or 3, 3) })
        end
        paint()
        refreshers[#refreshers + 1] = paint
        bind(track.MouseButton1Click, function()
            CONFIG[key] = not CONFIG[key]
            paint()
            paintAction()
            E.saveSettings()
            if onChange then onChange() end
        end)
    end

    local function actionRow(text, color, fn)
        local b = button(setList, text, color, { Size = UDim2.new(1, 0, 0, 32), LayoutOrder = nextOrder() })
        bind(b.MouseButton1Click, fn)
    end

    section("Scanner")
    do
        local row = make("Frame", {
            Size = UDim2.new(1, 0, 0, 54), BackgroundColor3 = T.panel, BorderSizePixel = 0, LayoutOrder = nextOrder(),
        }, setList)
        corner(row, 8)
        label(row, {
            Text = "Lingkup scan", Position = UDim2.fromOffset(10, 6), Size = UDim2.new(1, -150, 0, 16),
            Font = Enum.Font.GothamMedium,
        })
        label(row, {
            Text = "Semua = seluruh workspace executor (rekursif). Folder = hanya " .. CONFIG.Folder .. ".",
            Position = UDim2.fromOffset(10, 24), Size = UDim2.new(1, -150, 0, 26), TextSize = 10,
            TextColor3 = T.sub, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top,
        })
        local segAll = button(row, "Semua", T.panel2, {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -72, 0.5, 0), Size = UDim2.fromOffset(58, 26), TextSize = 11,
        })
        local segFolder = button(row, "Folder", T.panel2, {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(58, 26), TextSize = 11,
        })
        local function paint()
            local all = CONFIG.ScanScope == "all"
            segAll.BackgroundColor3 = all and T.accent or T.panel2
            segFolder.BackgroundColor3 = all and T.panel2 or T.accent
        end
        paint()
        refreshers[#refreshers + 1] = paint
        local function pick(v)
            CONFIG.ScanScope = v
            paint()
            E.saveSettings()
            E.rescan(false)
        end
        bind(segAll.MouseButton1Click, function() pick("all") end)
        bind(segFolder.MouseButton1Click, function() pick("folder") end)
    end
    switchRow("Auto-rescan", "Pindai ulang tiap " .. CONFIG.AutoScanInterval .. " detik di latar belakang, juga saat UI disembunyikan.", "AutoScan")
    switchRow("Auto-import file baru", "File baru di folder " .. CONFIG.Folder .. " langsung diimport ke target (hati-hati).", "AutoImportNew")

    section("Import")
    switchRow("Matikan script", "Script di dalam file di-set Disabled saat diimport.", "DisableScripts")
    switchRow("Pasang teks script", "Isi script ditulis ke editor bawaan Studio Lite (SL_CodeTextBox).", "InstallScriptText")
    switchRow("Taruh di depan kamera", "Hanya untuk target Workspace. Batch otomatis diberi jarak.", "SpawnInFrontOfCamera")
    switchRow("Sembunyikan UI setelah import", "UI menutup ke tombol SL kecil, hasilnya muncul sebagai notifikasi.", "AutoHideAfterImport")

    section("Alat")
    actionRow("Scan ulang sekarang", T.purple, function() E.rescan(false) end)
    actionRow("Scan struktur script Studio Lite (diagnosa)", T.panel2, E.scanStudioLite)
    actionRow("Salin script berikutnya dari import terakhir", T.panel2, E.copyNextScript)
    actionRow("Undo semua batch", Color3.fromRGB(150, 90, 50), function() E.undo(true) end)
    actionRow("Reset centang & status", T.panel2, function()
        if S.busy then return end
        S.selected, S.status, S.reason = {}, {}, {}
        fire("selection")
        setStatus("Centang dan status direset.", "info")
    end)
    actionRow("Unload script (tutup total)", Color3.fromRGB(170, 65, 65), function()
        if env.__SLImporterCleanup then env.__SLImporterCleanup() end
    end)

    section("Info")
    do
        local function yn(f) return f and "ya" or "tidak" end
        local exName = "?"
        if identifyexecutor then
            local ok, n, v = pcall(identifyexecutor)
            if ok then exName = tostring(n) .. (v and (" " .. tostring(v)) or "") end
        end
        local info = string.format(
            "Executor: %s\nlistfiles: %s | readfile: %s | writefile: %s\ngetcustomasset: %s | clipboard: %s\nFolder: %s | PlaceId: %s\nToggle UI (PC): %s",
            exName, yn(listfiles), yn(readfile), yn(writefile), yn(getcustomasset or getsynasset),
            yn(setclipboard or toclipboard), CONFIG.Folder, tostring(game.PlaceId), CONFIG.ToggleKey.Name)
        local box = make("Frame", {
            Size = UDim2.new(1, 0, 0, 78), BackgroundColor3 = T.panel, BorderSizePixel = 0, LayoutOrder = nextOrder(),
        }, setList)
        corner(box, 8)
        label(box, {
            Text = info, Position = UDim2.fromOffset(10, 6), Size = UDim2.new(1, -20, 1, -12), TextSize = 10,
            TextColor3 = T.sub, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top,
        })
    end

    -- ===============================================================
    -- Hook engine -> UI
    -- ===============================================================
    H.view = function()
        paintChips()
        renderList()
    end
    H.rows = refreshRows
    H.selection = function()
        refreshRows()
        paintAction()
        updateMini()
    end
    H.focus = function()
        refreshRows()
        paintDetail()
    end
    H.status = function(text, kind)
        statusLbl.Text = text
        statusLbl.TextColor3 = (kind == "info") and T.sub or (KIND[kind] or T.sub)
    end
    H.progress = function(frac, text)
        W.prog = frac
        tween(progFill, 0.15, { Size = UDim2.new(math.clamp(frac, 0, 1), 0, 1, 0) })
        if text ~= "" then
            statusLbl.Text = text
            statusLbl.TextColor3 = T.sub
        end
        updateMini()
    end
    H.busy = function()
        paintAction()
        paintDetail()
        updateMini()
    end
    H.history = paintAction
    H.scanning = function(on)
        scanBtn.Text = on and "..." or "Scan"
        renderList()
    end
    H.toast = toast
    H.log = addLogRow
    H.autohide = hideWindow
    H.settingsRefresh = function()
        for _, f in ipairs(refreshers) do f() end
    end

    -- ---- Mulai ----
    paintChips()
    paintAction()
    paintDetail()
    setTab("files")
    applyRect(false)
    relayoutFiles()
    task.defer(function()
        if alive() then relayoutFiles() end
    end)
    E.applyView()
    if not CONFIG.StudioLitePlaceIds[game.PlaceId] then
        logLine("PlaceId " .. tostring(game.PlaceId) .. " bukan Studio Lite resmi, tetap bisa dipakai.", "warn")
    end
    setStatus("Siap. Memindai file...", "info")
    E.rescan(false)
end

ensureFolder()
E.loadSettings()
local okGui, errGui = pcall(buildGui)
if not okGui then
    warn("[SLImporter] GUI gagal dibuat: " .. tostring(errGui))
end
