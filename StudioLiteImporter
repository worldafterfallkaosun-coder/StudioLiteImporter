    on(r.root.MouseButton1Click, function()
        local d = r.d
        if not d then return end
        ST.lastFocus = "pr"
        if d.k == "cat" then
            ST.propCollapsed[d.name] = (not ST.propCollapsed[d.name]) or nil
            PR.rebuild()
        elseif d.k == "add" then
            if d.what == "attr" then PR.addAttribute() else PR.addTag() end
        end
    end)
    on(r.arrow.MouseButton1Click, function()
        local d = r.d
        if not d then return end
        if d.k == "cat" then
            ST.propCollapsed[d.name] = (not ST.propCollapsed[d.name]) or nil
            PR.rebuild()
        elseif d.k == "prop" then
            ST.propExpanded[d.p.name] = (not ST.propExpanded[d.p.name]) or nil
            PR.rebuild()
        end
    end)
