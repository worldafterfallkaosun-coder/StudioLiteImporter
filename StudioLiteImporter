function E.loadSettings()
    if not (isfile and readfile) then return end
    local ok, raw = pcall(function()
        if isfile(CONFIG.SettingsFile) then return readfile(CONFIG.SettingsFile) end
    end)
    if not ok or type(raw) ~= "string" then return end
    local okj, t = pcall(function() return HttpService:JSONDecode(raw) end)
    if not okj or type(t) ~= "table" then return end
    for _, k in ipairs(PERSIST) do
        if t[k] ~= nil then CONFIG[k] = t[k] end
    end
    if CONFIG.ScanScope ~= "all" and CONFIG.ScanScope ~= "folder" then CONFIG.ScanScope = "all" end
    if CONFIG.PlaceMode ~= "folder" and CONFIG.PlaceMode ~= "merge" then CONFIG.PlaceMode = "folder" end
    if CONFIG.ImageMode ~= "decal" and CONFIG.ImageMode ~= "gui" then CONFIG.ImageMode = "decal" end
    local okFace = { Front = true, Back = true, Left = true, Right = true, Top = true, Bottom = true, All = true }
    if not okFace[CONFIG.DecalFace] then CONFIG.DecalFace = "Front" end
    if CONFIG.ToolSpace ~= "global" and CONFIG.ToolSpace ~= "local" then CONFIG.ToolSpace = "global" end
    for _, k in ipairs({ "MoveSnap", "RotSnap", "ScaleSnap" }) do
        if type(CONFIG[k]) ~= "number" or CONFIG[k] < 0 then CONFIG[k] = 1 end
    end
    -- target disimpan sebagai path ("Workspace/Map/Props"), dicocokkan ulang saat dipakai
    if type(t.target) == "string" and t.target ~= "" then S.target = t.target end
    local function strList(v, max)
        local out = {}
        if type(v) == "table" then
            for _, p in ipairs(v) do
                if type(p) == "string" and p ~= "" and #out < max then out[#out + 1] = p end
            end
        end
        return out
    end
    X.pins, X.recent = strList(t.pins, 12), strList(t.recent, 6)
    if table.find(SORTS, t.sort) then S.sort = t.sort end
    if table.find(KIND_LIST, t.filter) then S.filter = t.filter end
    if type(t.ui) == "table" then S.ui = t.ui end
    if type(t.studio) == "table" then S.studio = t.studio end
    if CONFIG.StudioTheme ~= "light" and CONFIG.StudioTheme ~= "dark" then CONFIG.StudioTheme = "light" end
    TB.restore(t.toolbox)
    PLG.enabledLoad(t.plugins)
end

local saveQueued = false
