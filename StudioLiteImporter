-- Daftar virtual: hanya baris yang terlihat dibuat (pool), tinggi baris seragam
-- ---------------------------------------------------------------
function UI.vlist(parent, rowH, create, paint)
    local sf = new("ScrollingFrame", {
        Name = "VList", BackgroundTransparency = 1, BorderSizePixel = 0, Size = U2(1, 0, 1, 0),
        ScrollBarThickness = 6, ScrollBarImageColor3 = T.lineStrong, CanvasSize = U2(0, 0, 0, 0),
        ScrollingDirection = Enum.ScrollingDirection.Y, ElasticBehavior = Enum.ElasticBehavior.Never,
        VerticalScrollBarInset = Enum.ScrollBarInset.None, Active = true,
    }, parent)
    local holder = new("Frame", { Name = "Holder", BackgroundTransparency = 1, Size = U2(1, 0, 0, 0), BorderSizePixel = 0 }, sf)
    local L = { sf = sf, holder = holder, n = 0, pool = {}, rowH = rowH }

    local function viewH()
        local h = sf.AbsoluteSize.Y / UI.sc
        if h <= 4 then h = 300 end
        return h
    end
    local function viewTop()
        local t = (sf.AbsolutePosition.Y - holder.AbsolutePosition.Y) / UI.sc
        return math.max(0, t)
    end

    function L.refresh(force)
        local top, h = viewTop(), viewH()
        local first = math.max(1, math.floor(top / rowH))
        local last = math.min(L.n, math.ceil((top + h) / rowH) + 1)
        local need = last - first + 1
        if need < 0 then need = 0 end
        if #L.pool < need + 1 then
            while #L.pool < need + 3 do L.pool[#L.pool + 1] = create(holder) end
            force = true
            for _, r in ipairs(L.pool) do r.index = nil end
        end
        local P = #L.pool
        local used = {}
        for i = first, last do
            local slot = (i - 1) % P + 1
            local r = L.pool[slot]
            used[slot] = true
            if force or r.index ~= i or not r.root.Visible then
                r.index = i
                r.root.Position = U2(0, 0, 0, (i - 1) * rowH)
                r.root.Visible = true
                paint(r, i)
            end
        end
        for k = 1, P do
            if not used[k] then
                local r = L.pool[k]
                if r.root.Visible then r.root.Visible = false end
                r.index = nil
            end
        end
    end

    function L.setCount(n)
        L.n = n
        holder.Size = U2(1, 0, 0, n * rowH)
        sf.CanvasSize = U2(0, 0, 0, n * rowH)
        L.refresh(true)
    end

    function L.scrollTo(i, center)
        local h = viewH()
        local y0, y1 = (i - 1) * rowH, i * rowH
        local top = viewTop()
        local target
        if center then
            target = y0 - (h - rowH) / 2
        elseif y0 < top then
            target = y0
        elseif y1 > top + h then
            target = y1 - h
        end
        if target then
            local maxY = math.max(0, L.n * rowH - h)
            sf.CanvasPosition = V2(0, math.clamp(target, 0, maxY))
        end
    end

    on(holder:GetPropertyChangedSignal("AbsolutePosition"), function() L.refresh(false) end)
    on(sf:GetPropertyChangedSignal("AbsoluteSize"), function() L.refresh(false) end)
    return L
end

