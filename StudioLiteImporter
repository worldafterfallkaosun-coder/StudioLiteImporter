        local c = { card = card }
        c.name = label(head, { Position = UDim2.fromOffset(10, 5), Size = UDim2.new(1, -150, 0, 16), Font = Enum.Font.GothamBold, TextSize = 12, TextTruncate = Enum.TextTruncate.AtEnd })
