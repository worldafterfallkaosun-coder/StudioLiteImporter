local ROW_CAP = 30000

function EX.rebuild()
    EX.dirty = false
    if EX.query ~= "" then return end
    local rows = {}
    local function add(inst, depth)
        if #rows >= ROW_CAP then return end
        local n = X.kidCount(inst)
        rows[#rows + 1] = { inst = inst, depth = depth, has = n > 0 }
        if n > 0 and ST.expanded[inst] then
            for _, c in ipairs(kidsOf2(inst)) do add(c, depth + 1) end
        end
    end
    for _, r in ipairs(serviceRoots()) do add(r, 0) end
    EX.rows = rows
    EX.L.setCount(#rows)
    if EX.pendingScroll then
        local target = EX.pendingScroll
        EX.pendingScroll = nil
        for i, d in ipairs(rows) do
            if d.inst == target then EX.L.scrollTo(i, false) break end
        end
    end
end

function EX.search(q)
    EX.searchTok = EX.searchTok + 1
    local tok = EX.searchTok
    EX.query = q
    if q == "" then
        EX.dirty = true
        return
    end
    task.spawn(function()
        local mode, needle = "name", q:lower()
        local cls = q:match("^[Cc]lass:%s*(.+)$")
        if cls then mode, needle = "class", cls:lower() end
        local keep, matches, visited = {}, {}, 0
        for _, root in ipairs(serviceRoots()) do
            local okd, desc = pcall(function() return root:GetDescendants() end)
            if okd then
                desc[#desc + 1] = root
                for _, d in ipairs(desc) do
                    visited = visited + 1
                    if visited % 4000 == 0 then
                        task.wait()
                        if tok ~= EX.searchTok then return end
                    end
                    local hay = (mode == "class") and d.ClassName:lower() or d.Name:lower()
                    if hay:find(needle, 1, true) then
                        matches[#matches + 1] = d
                        local p = d
                        while p and p ~= game and not keep[p] do
                            keep[p] = true
                            p = p.Parent
                        end
                        if #matches >= 3000 then break end
                    end
                end
            end
            if #matches >= 3000 then break end
        end
        if tok ~= EX.searchTok then return end
        local rows = {}
        local function add(inst, depth)
            if #rows >= ROW_CAP then return end
            local kc = {}
            for _, c in ipairs(kidsOf2(inst)) do
                if keep[c] then kc[#kc + 1] = c end
            end
            rows[#rows + 1] = { inst = inst, depth = depth, has = #kc > 0, forced = true }
            for _, c in ipairs(kc) do add(c, depth + 1) end
        end
        for _, r in ipairs(serviceRoots()) do
            if keep[r] then add(r, 0) end
        end
        EX.rows = rows
        EX.L.setCount(#rows)
        EX.status.Text = #matches .. (#matches >= 3000 and "+" or "") .. " match"
    end)
end

function EX.paintSel()
    local set = {}
    for _, i in ipairs(SEL.list) do set[i] = true end
    EX.selSet = set
    if EX.L then EX.L.refresh(true) end
end

local function rowIndexAt(screenY)
    local top = EX.L.holder.AbsolutePosition.Y
    local idx = math.floor((screenY - top) / (EX.rowH * UI.sc)) + 1
    if idx >= 1 and idx <= #EX.rows then return idx end
    return nil
end

local function rangeSelect(a, b)
    local ia, ib
    for i, d in ipairs(EX.rows) do
        if d.inst == a then ia = i end
        if d.inst == b then ib = i end
    end
    if not ia or not ib then return { b } end
    if ia > ib then ia, ib = ib, ia end
    local out = {}
    for i = ia, ib do out[#out + 1] = EX.rows[i].inst end
    return out
end

local function applySelect(inst, input, release)
    local ctrl = UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl) or UIS:IsKeyDown(Enum.KeyCode.LeftMeta)
    local shift = UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.RightShift)
    if ST.multi then ctrl = true end
    if shift and EX.anchor and EX.anchor ~= inst then
        setSel(rangeSelect(EX.anchor, inst), true)
        return
    end
    EX.anchor = inst
    if ctrl then
        local list, found = {}, false
        for _, i in ipairs(SEL.list) do
            if i == inst then found = true else list[#list + 1] = i end
        end
        if not found then list[#list + 1] = inst end
        setSel(list, true)
    else
        setSel({ inst }, true)
    end
end

local function endDrag(commit)
    local d = EX.drag
    EX.drag = nil
    if not d then return end
    pcall(function() d.ghost:Destroy() end)
    if EX.dropRow then
        pcall(function() EX.dropRow.drop.Visible = false end)
        EX.dropRow = nil
    end
    if commit and d.target then
        if ACT.reparent(d.items, d.target) then
            SEL.refresh()
        end
    end
end

local function startDrag(press)
    local items = {}
    if EX.selSet[press.inst] then
        for _, i in ipairs(SEL.list) do items[#items + 1] = i end
    else
        items = { press.inst }
    end
    items = topLevel(items)
    for _, i in ipairs(items) do
        if locked(i) then return end
    end
    local ghost = frame(UI.pop, { Size = UDim2.fromOffset(150, 24), BackgroundColor3 = T.panel, ZIndex = 35, Active = false })
    corner(ghost, 5)
    stroke(ghost, T.accent, 1)
    lbl(ghost, { Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -12, 1, 0), Text = (#items == 1) and items[1].Name or (#items .. " objek"), TextSize = 13,
        TextTruncate = Enum.TextTruncate.AtEnd })
    EX.drag = { items = items, ghost = ghost }
end

local function updateDrag(p)
    local d = EX.drag
    if not d then return end
    local dp = UI.toDesign(p)
    d.ghost.Position = UDim2.fromOffset(dp.X + 12, dp.Y + 10)
    local idx = rowIndexAt(p.Y)
    local inside = EX.L.sf.AbsolutePosition
    local sz = EX.L.sf.AbsoluteSize
    if p.X < inside.X or p.X > inside.X + sz.X or p.Y < inside.Y or p.Y > inside.Y + sz.Y then idx = nil end
    local target
    if idx then
        local cand = EX.rows[idx].inst
        local ok = canHold(cand)
        if ok then
            for _, i in ipairs(d.items) do
                if i == cand or cand:IsDescendantOf(i) then ok = false break end
            end
        end
        if ok then target = cand end
    end
    d.target = target
    if EX.dropRow then
        pcall(function() EX.dropRow.drop.Visible = false end)
        EX.dropRow = nil
    end
    if target then
        for _, r in ipairs(EX.L.pool) do
            if r.index == idx then
                r.drop.Visible = true
                EX.dropRow = r
            end
        end
    end
    -- gulir otomatis di tepi
    if p.Y < inside.Y + 22 then
        EX.L.sf.CanvasPosition = EX.L.sf.CanvasPosition - V2(0, 10)
    elseif p.Y > inside.Y + sz.Y - 22 then
        EX.L.sf.CanvasPosition = EX.L.sf.CanvasPosition + V2(0, 10)
    end
end

local function createExRow(parent)
    local r = {}
    r.root = btn(parent, { Size = U2(1, 0, 0, EX.rowH), Visible = false, BackgroundTransparency = 1 })
    r.drop = frame(r.root, { Size = U2(1, 0, 1, 0), BackgroundTransparency = 0.7, BackgroundColor3 = T.accent, Visible = false, Active = false })
    stroke(r.drop, T.accent, 1)
    r.arrow = btn(r.root, { Size = UDim2.fromOffset(18, EX.rowH), Position = UDim2.fromOffset(0, 0) })
    r.tR = tri(r.arrow, "right", T.icon, 6, { Position = U2(0.5, 0, 0.5, 0) })
    r.tD = tri(r.arrow, "down", T.icon, 6, { Position = U2(0.5, 0, 0.5, 0), Visible = false })
    r.iconHolder = new("Frame", { Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1, Active = false }, r.root)
    r.text = lbl(r.root, { Size = UDim2.new(1, -60, 1, 0), TextSize = 13, TextTruncate = Enum.TextTruncate.AtEnd, Active = false })
    r.plus = btn(r.root, { Size = UDim2.fromOffset(20, 18), Position = U2(1, -26, 0.5, -9), Visible = false, BackgroundTransparency = 1 })
    corner(r.plus, 4)
    lbl(r.plus, { Size = U2(1, 0, 1, 0), Text = "+", TextSize = 18, Font = FONTM, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = T.textDim })
    hoverable(r.plus)
    on(r.root.MouseEnter, function()
        r.hover = true
        local d = r.index and EX.rows[r.index]
        if d and not UIS.TouchEnabled then r.plus.Visible = canHold(d.inst) end
        if d and not EX.selSet[d.inst] then r.root.BackgroundColor3, r.root.BackgroundTransparency = T.hover, 0 end
    end)
    on(r.root.MouseLeave, function()
        r.hover = false
        local d = r.index and EX.rows[r.index]
        if d and not EX.selSet[d.inst] then
            r.root.BackgroundTransparency = 1
            r.plus.Visible = false
        end
    end)
    on(r.plus.MouseButton1Click, function()
        local d = r.index and EX.rows[r.index]
        if d then ACT.pickInsert(d.inst) end
    end)
    on(r.arrow.MouseButton1Click, function()
        local d = r.index and EX.rows[r.index]
        if d and d.has then
            local alt = UIS:IsKeyDown(Enum.KeyCode.LeftAlt) or UIS:IsKeyDown(Enum.KeyCode.RightAlt)
            if alt then ACT.expandAll(d.inst, not ST.expanded[d.inst]) else ACT.expand(d.inst, not ST.expanded[d.inst]) end
        end
    end)
    on(r.root.InputBegan, function(input)
        local d = r.index and EX.rows[r.index]
        if not d then return end
        local inst = d.inst
        UI.closeMenus()
        ST.lastFocus = "ex"
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            if not EX.selSet[inst] then applySelect(inst, input) end
            local p = pointer(input)
            ACT.contextMenu(inst, p.X, p.Y)
        elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local touch = input.UserInputType == Enum.UserInputType.Touch
            local press = { inst = inst, pos = pointer(input), t = os.clock(), touch = touch, input = input, wasSel = EX.selSet[inst] }
            EX.press = press
            if not touch then
                local mod = UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl) or UIS:IsKeyDown(Enum.KeyCode.LeftShift)
                    or UIS:IsKeyDown(Enum.KeyCode.RightShift) or UIS:IsKeyDown(Enum.KeyCode.LeftMeta)
                if not press.wasSel or mod then
                    applySelect(inst, input)
                    press.applied = true
                end
            else
                task.delay(0.45, function()
                    if EX.press == press and not press.moved and not press.done then
                        press.long = true
                        if not EX.selSet[inst] then applySelect(inst, input) end
                        ACT.contextMenu(inst, press.pos.X, press.pos.Y)
                    end
                end)
            end
        end
    end)
    return r
end

local function paintExRow(r, i)
    local d = EX.rows[i]
    if not d then r.root.Visible = false return end
    local inst = d.inst
    local sel = EX.selSet[inst]
    r.root.BackgroundColor3 = sel and T.sel or T.hover
    r.root.BackgroundTransparency = sel and 0 or 1
    local x = 4 + d.depth * 14
    r.arrow.Position = UDim2.fromOffset(x - 2, 0)
    r.arrow.Visible = d.has
    local open = d.has and (ST.expanded[inst] or d.forced)
    r.tR.Visible = d.has and not open
    r.tD.Visible = d.has and open and true or false
    r.tR.BackgroundColor3, r.tD.BackgroundColor3 = T.icon, T.icon
    r.iconHolder.Position = UDim2.fromOffset(x + 16, 3)
    local cn = inst.ClassName
    if r.class ~= cn then
        r.class = cn
        for _, c in ipairs(r.iconHolder:GetChildren()) do c:Destroy() end
        UI.icon(r.iconHolder, cn, 16)
    end
    r.text.Position = UDim2.fromOffset(x + 38, 0)
    r.text.Size = UDim2.new(1, -(x + 62), 1, 0)
    r.text.Text = inst.Name
    r.text.TextColor3 = sel and T.selText or (locked(inst) and T.textDim or T.text)
    r.drop.Visible = (EX.dropRow == r)
    r.plus.Visible = canHold(inst) and ((sel and #SEL.list == 1) or (r.hover and not UIS.TouchEnabled)) and true or false
    local isTarget = false
    local tg = S.targetInst
    if tg and tg == inst then isTarget = true end
    r.text.Font = isTarget and FONTB or FONT
end

function EX.build(parent)
    local top = frame(parent, { Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = T.panel })
    local box = frame(top, { Position = UDim2.fromOffset(8, 5), Size = UDim2.new(1, -16, 0, 25), BackgroundColor3 = T.input })
    corner(box, 5)
    stroke(box, T.inputLine, 1)
    UI.magnifier(box, 8, 6)
    local tb = new("TextBox", { Position = UDim2.fromOffset(26, 0), Size = UDim2.new(1, -60, 1, 0), BackgroundTransparency = 1, Text = "",
        PlaceholderText = "Filter workspace (Ctrl+Shift+X)", PlaceholderColor3 = T.textDim, ClearTextOnFocus = false, TextColor3 = T.text, Font = FONT, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left, BorderSizePixel = 0 }, box)
    EX.filterBox = tb
    EX.status = lbl(box, { Position = U2(1, -80, 0, 0), Size = UDim2.fromOffset(52, 25), Text = "", TextSize = 11, TextColor3 = T.textDim,
        TextXAlignment = Enum.TextXAlignment.Right, Active = false })
    local clear = btn(box, { Position = U2(1, -24, 0, 2), Size = UDim2.fromOffset(20, 21), Visible = false })
    lbl(clear, { Size = U2(1, 0, 1, 0), Text = "x", TextXAlignment = Enum.TextXAlignment.Center, TextSize = 15, TextColor3 = T.textDim })
    on(clear.MouseButton1Click, function() tb.Text = "" end)
    local tok = 0
    on(tb:GetPropertyChangedSignal("Text"), function()
        clear.Visible = tb.Text ~= ""
        tok = tok + 1
        local mine = tok
        task.delay(0.3, function()
            if mine == tok then
                EX.status.Text = ""
                EX.search(tb.Text)
            end
        end)
    end)
    on(tb.Focused, function() ST.lastFocus = "ex" end)
    frame(parent, { Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = T.line })
    local holder = new("Frame", { Position = UDim2.fromOffset(0, 35), Size = UDim2.new(1, 0, 1, -35), BackgroundTransparency = 1, ClipsDescendants = true }, parent)
    EX.L = UI.vlist(holder, EX.rowH, createExRow, paintExRow)

    -- gerakan / lepas pointer (global)
    bind2(UIS.InputChanged, function(input)
        local press = EX.press
        if not press or not isMove(input) then return end
        local p = pointer(input)
        local dist = (p - press.pos).Magnitude
        if press.touch then
            if dist > 10 then press.moved = true end
        else
            if not EX.drag and dist > 6 then
                press.moved = true
                startDrag(press)
            end
            if EX.drag then updateDrag(p) end
        end
    end)
    bind2(UIS.InputEnded, function(input)
        local press = EX.press
        if not press then return end
        if input.UserInputType ~= press.input.UserInputType then return end
        EX.press = nil
        press.done = true
        if EX.drag then
            endDrag(true)
            return
        end
        if press.long or press.moved then return end
        local inst = press.inst
        if press.touch then
            applySelect(inst, input)
        elseif not press.applied then
            setSel({ inst }, true) -- klik di item yang sudah terpilih: jadi pilihan tunggal
            EX.anchor = inst
        end
        local now = os.clock()
        local last = EX.lastClick
        if last and last.inst == inst and now - last.t < 0.35 then
            EX.lastClick = nil
            local d
            for _, row in ipairs(EX.rows) do if row.inst == inst then d = row break end end
            if inst:IsA("LuaSourceContainer") and not locked(inst) then ACT.openEditor(inst)
            elseif d and d.has then ACT.expand(inst, not ST.expanded[inst])
            elseif not locked(inst) then ACT.rename(inst) end
        else
            EX.lastClick = { inst = inst, t = now }
        end
    end)

    -- perubahan pohon
    local function visibleParent(p)
        return p and (p == game or p.Parent == game or ST.expanded[p])
    end
    bind2(game.DescendantAdded, function(d)
        if visibleParent(d.Parent) then EX.dirty = true end
    end)
    bind2(game.DescendantRemoving, function(d)
        if visibleParent(d.Parent) then EX.dirty = true end
    end)
    local myGen = gen
    task.spawn(function()
        local acc = 0
        while alive() and myGen == gen do
            task.wait(0.2)
            if UI.frame and UI.frame.Parent and SS.ex then
                if EX.dirty then
                    pcall(EX.rebuild)
                    if EX.query ~= "" then EX.dirty = false end
                else
                    acc = acc + 1
                    if acc % 3 == 0 then EX.L.refresh(true) end
                end
            end
        end
    end)
    EX.dirty = true
    for _, r in ipairs(serviceRoots()) do
        if r == workspace then ST.expanded[r] = true end
    end
    pcall(EX.rebuild)
    EX.paintSel()
end

function EX.onSelection()
    EX.paintSel()
    if not EX.selfSel and SS.expandSelect and SEL.list[1] and EX.query == "" then
        local first = SEL.list[1]
        local visible = false
        for _, d in ipairs(EX.rows) do
            if d.inst == first then visible = true break end
        end
        if not visible then
            ACT.reveal(first)
        else
            for i, d in ipairs(EX.rows) do
                if d.inst == first then EX.L.scrollTo(i, false) break end
            end
        end
    end
end

