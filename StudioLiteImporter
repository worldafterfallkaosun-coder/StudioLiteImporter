-- ---- diagnosa: struktur GUI Explorer bawaan Studio Lite ----
function E.scanExplorerGui()
    local pg = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then
        notify("PlayerGui tidak ditemukan.", "err")
        return
    end
    local lines = { "# Scan GUI Explorer Studio Lite", "PlaceId: " .. tostring(game.PlaceId), "", "== ScreenGui di PlayerGui" }
    for _, g in ipairs(kidsOf(pg)) do
        lines[#lines + 1] = string.format('%s "%s" (%d turunan)', g.ClassName, g.Name, #g:GetDescendants())
    end
    local function dump(inst, depth)
        if depth > 3 then return end
        for i, c in ipairs(kidsOf(inst)) do
            if i > 12 then
                lines[#lines + 1] = string.rep("  ", depth) .. "..."
                break
            end
            lines[#lines + 1] = string.rep("  ", depth) .. describe(c)
            dump(c, depth + 1)
        end
    end
    local hits = 0
    for _, d in ipairs(pg:GetDescendants()) do
        if d.Name:lower():find("explorer", 1, true) then
            hits = hits + 1
            if hits > 8 then break end
            lines[#lines + 1] = ""
            lines[#lines + 1] = "== " .. X.pathOf(d) .. "  [" .. d.ClassName .. "]"
            dump(d, 1)
        end
    end
    if hits == 0 then
        lines[#lines + 1] = ""
        lines[#lines + 1] = "(tidak ada GUI bernama 'explorer' di PlayerGui)"
    end
    local report = table.concat(lines, "\n")
    local saved
    if writefile then
        ensureFolder()
        local p = CONFIG.Folder .. "/explorer_gui_dump.txt"
        if pcall(writefile, p, report) then saved = p end
    end
    local clip = setclipboard or toclipboard
    local copied = clip and pcall(clip, report)
    logLine(report, "info")
    notify(string.format("Scan GUI Explorer: %d GUI cocok.%s%s", hits,
        saved and (" Disimpan: " .. saved .. ".") or "", copied and " Disalin ke clipboard." or ""), "info")
end


