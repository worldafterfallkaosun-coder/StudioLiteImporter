    local function renderX()
        local rows = X.rows
        local n = #rows
        local canvasH = n * XR_H + 6
        if canvasH ~= xLastH then
            xLastH = canvasH
            xList.CanvasSize = UDim2.new(0, 0, 0, canvasH)
        end
        local need = math.ceil(math.max(xList.AbsoluteSize.Y, 60) / XR_H) + 3
        while #xPool < need do xPool[#xPool + 1] = makeXRow() end
        curTarget = E.getTarget()
        local first = math.max(1, math.floor(xList.CanvasPosition.Y / XR_H) + 1)
        for i, row in ipairs(xPool) do
            local r = rows[first + i - 1]
            if r then
                row.r = r
                row.frame.Position = UDim2.fromOffset(4, (first + i - 2) * XR_H + 3)
                row.frame.Visible = true
                paintXRow(row)
            else
                row.r = nil
                row.frame.Visible = false
            end
        end
        xEmpty.Visible = n == 0
    end

