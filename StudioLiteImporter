function ACT.copy(cut)
    local list = topLevel(selList())
    local out = {}
    for _, i in ipairs(list) do
        if not locked(i) then out[#out + 1] = i end
    end
    if #out == 0 then notify("Pilih objek dulu.", "warn") return end
    if cut then
        ST.clip, ST.clipCut = out, true
        setStatus("Cut " .. #out .. " objek (paste untuk memindah)", "info")
    else
        local clones = {}
        for _, i in ipairs(out) do
            local okc, c = pcall(function() return i:Clone() end)
            if okc and c then clones[#clones + 1] = c end
        end
        if #clones == 0 then notify("Copy gagal (objek tidak Archivable).", "err") return end
        ST.clip, ST.clipCut = clones, false
        setStatus("Copy " .. #clones .. " objek", "info")
    end
end

function ACT.paste(parent)
    parent = parent or SEL.list[1] or workspace
    if not canHold(parent) then notify("Tidak bisa paste ke " .. tostring(parent.Name) .. ".", "warn") return end
    if not ST.clip or #ST.clip == 0 then notify("Clipboard kosong.", "warn") return end
    local made, olds = {}, {}
    if ST.clipCut then
        for _, i in ipairs(ST.clip) do
            if i.Parent and i ~= parent and not parent:IsDescendantOf(i) then
                olds[#olds + 1] = { i, i.Parent }
                pcall(function() i.Parent = parent end)
                made[#made + 1] = i
            end
        end
        ST.clip, ST.clipCut = {}, false
        HIST.push("Move " .. #made, function()
            for _, o in ipairs(olds) do pcall(function() o[1].Parent = o[2] end) end
        end, function()
            for _, o in ipairs(olds) do pcall(function() o[1].Parent = parent end) end
        end)
    else
        for _, i in ipairs(ST.clip) do
            local okc, c = pcall(function() return i:Clone() end)
            if okc and c then
                c.Parent = parent
                made[#made + 1] = c
            end
        end
        HIST.push("Paste " .. #made, function()
            for _, c in ipairs(made) do pcall(function() c.Parent = nil end) end
        end, function()
            for _, c in ipairs(made) do pcall(function() c.Parent = parent end) end
        end)
    end
    if #made > 0 then
        ACT.reveal(made[1])
        setSel(made)
        setStatus("Paste " .. #made .. " objek -> " .. parent.Name, "ok")
    end
end

function ACT.reparent(list, newParent)
    if not canHold(newParent) then return false end
    local moved, olds = {}, {}
    for _, i in ipairs(topLevel(list)) do
        if not locked(i) and i ~= newParent and not newParent:IsDescendantOf(i) and i.Parent ~= newParent then
            olds[#olds + 1] = { i, i.Parent }
            pcall(function() i.Parent = newParent end)
            if i.Parent == newParent then moved[#moved + 1] = i end
        end
    end
    if #moved == 0 then return false end
    HIST.push("Reparent " .. #moved, function()
        for _, o in ipairs(olds) do pcall(function() o[1].Parent = o[2] end) end
    end, function()
        for _, o in ipairs(olds) do pcall(function() o[1].Parent = newParent end) end
    end)
    ST.expanded[newParent] = true
    EX.dirty = true
    setStatus("Dipindah: " .. #moved .. " objek -> " .. newParent.Name, "ok")
    return true
end

function ACT.zoomTo(list)
    list = list or selList()
    local cf, size
    local items = {}
    for _, i in ipairs(list) do
        if i:IsA("BasePart") or i:IsA("Model") then items[#items + 1] = i end
    end
    if #items == 0 then notify("Zoom To butuh Part / Model.", "warn") return end
    local center, sz = CORE.aabbOf(items)
    local cam = workspace.CurrentCamera
    if not center or not cam then return end
    local dist = math.max(sz.X, sz.Y, sz.Z) * 1.6 + 6
    local look = cam.CFrame.LookVector
    pcall(function() cam.CFrame = CFrame.lookAt(center - look * dist, center) end)
end

