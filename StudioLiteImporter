    bind(btnMax.MouseButton1Click, toggleMax)
    bind(btnClose.MouseButton1Click, hideWindow) -- hanya menyembunyikan; engine tetap jalan

    -- geser jendela lewat title bar, ketuk dua kali = maximize
    local lastTap = 0
    draggable(titleBar, Main, function(moved)
        if moved then
            if not W.maxed then
                W.x, W.y = Main.Position.X.Offset, Main.Position.Y.Offset
                persistRect()
            end
        else
            local now = os.clock()
            if now - lastTap < 0.35 then toggleMax() lastTap = 0 else lastTap = now end
        end
    end, function() return not W.maxed end)

