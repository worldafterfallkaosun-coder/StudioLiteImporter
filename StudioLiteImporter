-- ---- Tambah file manual (executor tanpa listfiles / path di luar scan) ----
function E.addManual(text)
    text = (text or ""):match("^%s*(.-)%s*$")
    if text == "" or not isfile then return false end
    local candidates = {
        text, CONFIG.Folder .. "/" .. text,
        CONFIG.Folder .. "/" .. text .. ".rbxmx", CONFIG.Folder .. "/" .. text .. ".rbxm",
    }
    for _, c in ipairs(candidates) do
        local okf, exists = pcall(isfile, c)
        if okf and exists then
            local entry = makeEntry(c)
            if entry then
                local dup = false
                for _, e in ipairs(S.entries) do if e.path == entry.path then dup = true break end end
                if not dup then
                    S.entries[#S.entries + 1] = entry
                    sortList(S.entries, "name")
                    S.known[entry.path] = true
                end
                S.selected[entry.path] = true
                E.applyView()
                fire("selection")
                notify("Ditambahkan manual: " .. entry.name, "ok")
                return true
            end
        end
    end
    return false
end

-- ===================================================================
-- EXPLORER LIVE (pohon instance Studio Lite -> pilihan "Import to")
-- ===================================================================
-- Explorer Studio Lite menampilkan isi game di sisi client, jadi sumbernya diambil
-- langsung dari DataModel (Workspace, ReplicatedStorage, StarterGui, dst.) lalu diikuti
-- perubahannya secara live. Hasilnya tampil di tab Explorer sebagai pohon yang bisa
-- dibuka-tutup, dicari, dipin, dan dipilih sebagai target import.

local function inGame(inst)
    return typeof(inst) == "Instance" and inst:IsDescendantOf(game)
end

local function kidsOf(inst)
    local ok, list = pcall(inst.GetChildren, inst)
    if ok and type(list) == "table" then return list end
    return {}
end

-- "Workspace/Map/Props". unique=true menambah #n untuk nama kembar (dipakai untuk simpan).
function X.pathOf(inst, unique)
    local parts, cur, guard = {}, inst, 0
    while cur and cur ~= game and guard < 100 do
        local seg = cur.Name
        if unique and cur.Parent then
            local same, idx = 0, 0
            for _, c in ipairs(kidsOf(cur.Parent)) do
                if c.Name == cur.Name then
                    same = same + 1
                    if c == cur then idx = same end
                end
            end
            if same > 1 then seg = seg .. "#" .. idx end
        end
        table.insert(parts, 1, seg)
        cur = cur.Parent
        guard = guard + 1
    end
    return table.concat(parts, "/")
end

local function pickChild(parent, seg)
    local name, idx = seg:match("^(.-)#(%d+)$")
    if name then
        local n = 0
        for _, c in ipairs(kidsOf(parent)) do
            if c.Name == name then
                n = n + 1
                if n == tonumber(idx) then return c end
            end
        end
    end
    return parent:FindFirstChild(seg)
end

function X.resolve(path)
    if type(path) ~= "string" or path == "" then return nil end
    local cur = game
    for seg in path:gmatch("[^/]+") do
        cur = pickChild(cur, seg)
        if not cur then return nil end
    end
    if cur == game then return nil end
    return cur
end

-- resolve dengan cache (objek yang hilang dicoba lagi paling cepat tiap 3 detik)
function X.lookup(path)
    local c = X.pathCache[path]
    if c and c.inst and inGame(c.inst) then return c.inst end
    local now = os.clock()
    if c and not c.inst and now - c.t < 3 then return nil end
    local inst = X.resolve(path)
    X.pathCache[path] = { inst = inst, t = now }
    return inst
end

function X.kidCount(inst)
    local c = X.kidCache[inst]
    local now = os.clock()
    if c and now - c[2] < 1.5 then return c[1] end
    local n = #kidsOf(inst)
    X.kidCache[inst] = { n, now }
    return n
end

local function sortedKids(inst)
    local list = kidsOf(inst)
    X.kidCache[inst] = { #list, os.clock() }
    if #list <= 2000 then
        local keyed = table.create(#list)
        for i, c in ipairs(list) do keyed[i] = { c, c.Name:lower() } end
        table.sort(keyed, function(a, b)
            if a[2] ~= b[2] then return a[2] < b[2] end
            return a[1].ClassName < b[1].ClassName
        end)
        for i, k in ipairs(keyed) do list[i] = k[1] end
    end
    return list
end

function X.roots()
    local out, seen = {}, {}
    local function add(svc)
        if svc and not seen[svc] then
            seen[svc] = true
            out[#out + 1] = svc
        end
    end
    for _, n in ipairs(ROOT_ORDER) do
        local ok, svc = pcall(function() return game:FindService(n) end)
        if ok then add(svc) end
    end
    if CONFIG.ExplorerAllServices then
        for _, c in ipairs(kidsOf(game)) do
            if not ROOT_HIDE[c.ClassName] then add(c) end
        end
    end
    return out
end

-- ---- target import ----
function E.getTarget()
    local t = S.targetInst
    if t and inGame(t) then return t end
    local r = X.lookup(S.target)
    S.targetInst = r
    return r
end

function E.setTarget(inst)
    if S.busy then
        notify("Tunggu batch selesai dulu sebelum ganti target.", "warn")
        return false
    end
    if not inGame(inst) then
        notify("Target tidak valid (objek sudah dihapus).", "warn")
        return false
    end
    S.targetInst = inst
    S.target = X.pathOf(inst, true)
    X.pathCache[S.target] = { inst = inst, t = os.clock() }
    X.lastTargetOk = true
    E.saveSettings()
    fire("target")
    setStatus("Target import: " .. X.pathOf(inst), "ok")
    return true
end

function X.pushRecent(inst)
    local p = X.pathOf(inst, true)
    local i = table.find(X.recent, p)
    if i then table.remove(X.recent, i) end
    table.insert(X.recent, 1, p)
    while #X.recent > 6 do table.remove(X.recent) end
    X.pathCache[p] = { inst = inst, t = os.clock() }
    X.dirty = true
    E.saveSettings()
end

function X.togglePin(p, inst)
    local i = table.find(X.pins, p)
    if i then
        table.remove(X.pins, i)
    else
        if #X.pins >= 12 then
            notify("Favorit penuh (maks 12). Lepas salah satu dulu.", "warn")
            return
        end
        X.pins[#X.pins + 1] = p
    end
    if inst then X.pathCache[p] = { inst = inst, t = os.clock() } end
    E.saveSettings()
    X.refresh(true)
end

-- buka semua induk objek supaya kelihatan di pohon
function X.reveal(inst)
    if not inGame(inst) then return end
    local p, guard = inst.Parent, 0
    while p and p ~= game and guard < 100 do
        X.expanded[p] = true
        p = p.Parent
        guard = guard + 1
    end
end

function X.toggle(inst)
    if X.expanded[inst] then X.expanded[inst] = nil else X.expanded[inst] = true end
    X.refresh(true)
end

function X.collapseAll()
    X.expanded = setmetatable({}, { __mode = "k" })
    X.refresh(true)
end

-- ---- bangun daftar baris (mode pohon / mode hasil pencarian) ----
function X.build()
    local rows = {}
    local function head(text) rows[#rows + 1] = { kind = "head", text = text } end

    X.pinSet = setmetatable({}, { __mode = "k" })
    for _, p in ipairs(X.pins) do
        local inst = X.lookup(p)
        if inst then X.pinSet[inst] = p end
    end

    if X.query ~= "" then
        if X.searching then
            head("MENCARI '" .. X.query .. "' ...")
        else
            local txt = "HASIL: " .. #X.results
            if X.searchTrunc then txt = txt .. " (dibatasi, persempit kata kunci)" end
            if #X.results == 0 then txt = txt .. " - coba kata lain" end
            head(txt)
            for _, r in ipairs(X.results) do
                if inGame(r.inst) then rows[#rows + 1] = r end
            end
        end
        return rows
    end

    if #X.pins > 0 then
        head("FAVORIT")
        for _, p in ipairs(X.pins) do
            rows[#rows + 1] = { kind = "path", path = p, inst = X.lookup(p), pinned = true }
        end
    end
    if #X.recent > 0 then
        head("TERAKHIR DIPAKAI")
        for _, p in ipairs(X.recent) do
            rows[#rows + 1] = { kind = "path", path = p, inst = X.lookup(p) }
        end
    end
    head("EXPLORER (LIVE)")

    local function walk(inst, depth)
        rows[#rows + 1] = { kind = "node", inst = inst, depth = depth }
        if X.expanded[inst] then
            local kids = sortedKids(inst)
            local cap = CONFIG.ExplorerMaxChildren
            for i, c in ipairs(kids) do
                if i > cap then
                    rows[#rows + 1] = { kind = "more", depth = depth + 1, n = #kids - cap }
                    break
                end
                walk(c, depth + 1)
            end
        end
    end
    for _, r in ipairs(X.roots()) do walk(r, 0) end
    return rows
end

local function sameRows(a, b)
    if #a ~= #b then return false end
    for i = 1, #a do
        local x, y = a[i], b[i]
        if x.kind ~= y.kind or x.inst ~= y.inst or x.depth ~= y.depth or x.path ~= y.path
            or x.text ~= y.text or x.n ~= y.n or x.pinned ~= y.pinned then
            return false
        end
    end
    return true
end

function X.refresh(force)
    if not alive() then return end
    X.dirty = false
    local rows = X.build()
    if force or not sameRows(rows, X.rows) then
        X.rows = rows
        X.stamp = os.date("%H:%M:%S")
        fire("explorerView")
    else
        fire("explorerPaint")
    end
    local ok = E.getTarget() ~= nil
    if ok ~= X.lastTargetOk then
        X.lastTargetOk = ok
        fire("target")
    end
end

-- ---- pencarian (async, tidak membekukan game) ----
function X.search(q, silent)
    local terms = {}
    for w in (q or ""):lower():gmatch("%S+") do terms[#terms + 1] = w end
    if silent and X.searchBusy then return end
    X.searchToken = X.searchToken + 1
    local token = X.searchToken
    if #terms == 0 then
        X.results, X.searching, X.searchBusy, X.searchTrunc = {}, false, false, false
        X.dirty = true
        return
    end
    X.searchBusy = true
    X.lastSearch = os.clock()
    if not silent then
        X.searching = true
        X.dirty = true
    end

    task.spawn(function()
        local found, visited, truncated = {}, 0, false
        local stack = {}
        local roots = X.roots()
        for i = #roots, 1, -1 do stack[#stack + 1] = roots[i] end

        while #stack > 0 do
            if token ~= X.searchToken or not alive() then return end
            local inst = table.remove(stack)
            visited = visited + 1
            local hay = inst.Name:lower() .. " " .. inst.ClassName:lower()
            local okm = true
            for _, t in ipairs(terms) do
                if not hay:find(t, 1, true) then okm = false break end
            end
            if okm then
                if #found >= CONFIG.ExplorerSearchResults then
                    truncated = true
                    break
                end
                found[#found + 1] = inst
            end
            if visited >= CONFIG.ExplorerSearchMax then
                truncated = true
                break
            end
            if not inst:IsA("Terrain") then
                local list = kidsOf(inst)
                for i = #list, 1, -1 do stack[#stack + 1] = list[i] end
            end
            if visited % 1500 == 0 then task.wait() end
        end
        if token ~= X.searchToken or not alive() then return end

        table.sort(found, function(a, b)
            local an, bn = a.Name:lower(), b.Name:lower()
            if an ~= bn then return an < bn end
            return a.ClassName < b.ClassName
        end)
        local res = {}
        for _, inst in ipairs(found) do
            local par = inst.Parent
            res[#res + 1] = {
                kind = "node", inst = inst, depth = 0, flat = true,
                sub = inst.ClassName .. " | " .. ((par and par ~= game) and X.pathOf(par) or "game"),
            }
        end
        X.results, X.searchTrunc = res, truncated
        X.searching, X.searchBusy = false, false
        X.refresh(true)
    end)
end

-- dipanggil dari kolom cari (debounce 0.35 detik)
function X.setQuery(text)
    text = (text or ""):match("^%s*(.-)%s*$")
    if text == X.query then return end
    X.query = text
    X.qToken = X.qToken + 1
    local tok = X.qToken
    if text == "" then
        X.search("")
        X.refresh(true)
    else
        X.searching = true
        X.dirty = true
        task.delay(0.35, function()
            if tok == X.qToken and alive() then
                X.search(text)
                X.refresh(true)
            end
        end)
    end
end

-- ---- live: dengarkan perubahan di seluruh game ----
function X.hook()
    if X.hooked then return end
    X.hooked = true
    local function touch(d)
        if X.query ~= "" then
            X.dirty, X.searchStale = true, true
            return
        end
        local p = d.Parent
        if p == game or X.expanded[p] then X.dirty = true end
    end
    local ok = pcall(function()
        bind(game.DescendantAdded, touch)
        bind(game.DescendantRemoving, touch)
    end)
    if not ok then
        logLine("Explorer live: event DescendantAdded tidak tersedia, pakai polling tiap "
            .. CONFIG.ExplorerRefresh .. " detik.", "warn")
    end
end

