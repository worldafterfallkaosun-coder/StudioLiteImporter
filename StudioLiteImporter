local ROWM = 25

function UI.ensureCatcher()
    if UI.catcher and UI.catcher.Parent then return end
    local c = new("TextButton", { Name = "Catcher", Size = U2(1, 0, 1, 0), BackgroundTransparency = 1, Text = "",
        AutoButtonColor = false, ZIndex = 1, Active = true }, UI.pop)
    on(c.InputBegan, function(input)
        if isPress(input) or input.UserInputType == Enum.UserInputType.MouseButton2 then UI.closeMenus() end
    end)
    UI.catcher = c
end

function UI.closeMenus(fromLevel)
    fromLevel = fromLevel or 1
    for i = #UI.menus, fromLevel, -1 do
        local m = UI.menus[i]
        if m and m.frame then pcall(function() m.frame:Destroy() end) end
        UI.menus[i] = nil
    end
    if #UI.menus == 0 and UI.catcher then
        pcall(function() UI.catcher:Destroy() end)
        UI.catcher = nil
    end
end

-- items: { text, key, fn, checked, disabled, sub, sep, icon(parent) }
-- sx, sy: koordinat layar (piksel). opts: minW, level, leftX, scrollTo
function UI.menu(items, sx, sy, opts)
    opts = opts or {}
    local level = opts.level or 1
    if level == 1 then UI.closeMenus(1) else UI.closeMenus(level) end
    UI.ensureCatcher()

    local vis = {}
    for _, it in ipairs(items) do
        if it.sep then
            if #vis > 0 and not vis[#vis].sep then vis[#vis + 1] = it end
        elseif not it.hidden then
            vis[#vis + 1] = it
        end
    end
    while #vis > 0 and vis[#vis].sep do vis[#vis] = nil end
    if #vis == 0 then return end

    local W, H = opts.minW or 190, 8
    for _, it in ipairs(vis) do
        if it.sep then
            H = H + 7
        else
            H = H + ROWM
            local w = textWidth(it.text, 13) + 56 + (it.key and (textWidth(it.key, 12) + 28) or 0) + (it.sub and 10 or 0)
            if w > W then W = w end
        end
    end
    local sz = UI.size()
    local maxH = math.min(opts.maxH or 440, sz.Y - 16)
    local scrolling = H > maxH
    local boxH = scrolling and maxH or H

    local d = UI.toDesign(V2(sx, sy))
    local x, y = d.X, d.Y
    if x + W > sz.X - 4 then
        if level > 1 and opts.leftX then
            x = UI.toDesign(V2(opts.leftX, 0)).X - W + 2
        else
            x = sz.X - W - 4
        end
    end
    x = math.max(4, x)
    if y + boxH > sz.Y - 4 then y = sz.Y - boxH - 4 end
    y = math.max(4, y)

    local m = {}
    local f = new("Frame", { Name = "Menu" .. level, Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(W, boxH),
        BackgroundColor3 = T.panel, BorderSizePixel = 0, ZIndex = 5 + level, Active = true }, UI.pop)
    corner(f, 6)
    stroke(f, T.lineStrong, 1)
    local sh = new("Frame", { Name = "Shadow", Position = UDim2.fromOffset(x - 1, y + 2), Size = UDim2.fromOffset(W + 2, boxH + 2),
        BackgroundColor3 = T.shadow, BackgroundTransparency = 0.82, BorderSizePixel = 0, ZIndex = 4 + level }, UI.pop)
    corner(sh, 7)
    new("Frame", { Name = "ShadowTie", Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1 }, f) -- placeholder
    f.Destroying:Connect(function() pcall(function() sh:Destroy() end) end)
    m.frame = f
    UI.menus[level] = m

    local body = f
    if scrolling then
        body = new("ScrollingFrame", { Size = U2(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0,
            ScrollBarThickness = 5, CanvasSize = UDim2.fromOffset(0, H), ScrollBarImageColor3 = T.lineStrong }, f)
    end

    local yy, rowOf = 4, {}
    local hoverTok = 0
    for idx, it in ipairs(vis) do
        if it.sep then
            new("Frame", { Position = UDim2.fromOffset(8, yy + 3), Size = UDim2.new(1, -16, 0, 1), BackgroundColor3 = T.line, BorderSizePixel = 0 }, body)
            yy = yy + 7
        else
            local b = btn(body, { Position = UDim2.fromOffset(4, yy), Size = UDim2.new(1, -8, 0, ROWM - 1), AutoButtonColor = false })
            corner(b, 4)
            rowOf[idx] = b
            local dim = it.disabled
            if it.checked then
                local box = new("Frame", { Position = UDim2.fromOffset(6, 4), Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1 }, b)
                drawCheck(box, dim and T.textDisabled or T.accent, 14)
            elseif it.icon then
                local box = new("Frame", { Position = UDim2.fromOffset(6, 4), Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1 }, b)
                pcall(it.icon, box)
            end
            lbl(b, { Position = UDim2.fromOffset(28, 0), Size = UDim2.new(1, -36, 1, 0), Text = it.text, TextSize = 13,
                TextColor3 = dim and T.textDisabled or T.text, TextTruncate = Enum.TextTruncate.AtEnd })
            if it.key then
                lbl(b, { Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, it.sub and -22 or -10, 1, 0), Text = it.key,
                    TextSize = 12, TextColor3 = T.textDim, TextXAlignment = Enum.TextXAlignment.Right })
            end
            if it.sub then
                tri(b, "right", dim and T.textDisabled or T.icon, 6, { Position = U2(1, -12, 0.5, 0) })
            end
            local function openSub()
                if not it.sub or dim then return end
                local ap, as = b.AbsolutePosition, b.AbsoluteSize
                UI.menu(it.sub, ap.X + as.X - 2, ap.Y - 4, { level = level + 1, leftX = ap.X })
            end
            on(b.MouseEnter, function()
                if not dim then b.BackgroundColor3, b.BackgroundTransparency = T.btnHover, 0 end
                hoverTok = hoverTok + 1
                local tok = hoverTok
                if it.sub then
                    task.delay(0.18, function()
                        if tok == hoverTok and b.Parent then openSub() end
                    end)
                else
                    if #UI.menus > level then UI.closeMenus(level + 1) end
                end
            end)
            on(b.MouseLeave, function() b.BackgroundTransparency = 1 end)
            on(b.MouseButton1Click, function()
                if dim then return end
                if it.sub then openSub() return end
                UI.closeMenus()
                if it.fn then task.defer(function() local ok, e = pcall(it.fn) if not ok then logLine("Menu: " .. tostring(e), "err") end end) end
            end)
            yy = yy + ROWM
        end
    end
    if scrolling and opts.scrollTo then
        local target = (opts.scrollTo - 1) * ROWM - (boxH - ROWM) / 2
        pcall(function() body.CanvasPosition = V2(0, math.clamp(target, 0, H - boxH)) end)
    end
    return f
end

