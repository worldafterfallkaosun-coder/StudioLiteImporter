    r.sw = btn(r.valHolder, { Position = UDim2.fromOffset(6, 5), Size = UDim2.fromOffset(20, 14), BackgroundTransparency = 0 })
    corner(r.sw, 3)
    stroke(r.sw, T.lineStrong, 1)
    -- input teks
    r.tb = new("TextBox", { Position = UDim2.fromOffset(6, 1), Size = UDim2.new(1, -12, 1, -2), BackgroundTransparency = 1, Text = "", ClearTextOnFocus = false,
