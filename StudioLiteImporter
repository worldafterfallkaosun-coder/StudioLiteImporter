    end)
    on(r.nameBtn.MouseButton1Click, function()
        local d = r.d
        if not d then return end
        if d.k == "prop" and d.p.attr then
            local t = PR.targets[1]
            UI.menu({
                { text = "Delete attribute", fn = function()
                    local old = t:GetAttribute(d.p.name)
                    pcall(function() t:SetAttribute(d.p.name, nil) end)
                    HIST.push("Delete Attribute", function() pcall(function() t:SetAttribute(d.p.name, old) end) PR.rebuild() end,
                        function() pcall(function() t:SetAttribute(d.p.name, nil) end) PR.rebuild() end)
                    PR.rebuild()
