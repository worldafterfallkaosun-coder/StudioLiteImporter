ACT.TEMPLATES = {
    Script = 'print("Hello world!")\n',
    LocalScript = 'print("Hello world!")\n',
    ModuleScript = 'local module = {}\n\nreturn module\n',
}

-- pastikan script punya SL_CodeTextBox (struktur yang dibaca editor bawaan). return ok, keterangan, textbox
function ACT.ensureScriptHolder(inst, src)
    if not inst or not inst:IsA("LuaSourceContainer") then return false, "bukan script" end
    local box = inst:FindFirstChild(HOLDER_BOX)
    if box and box:IsA("TextBox") then return true, "sudah ada", box end
    src = src or ""
    local okI, stats = pcall(installScriptText, { { inst = inst, class = inst.ClassName, source = src } })
    box = inst:FindFirstChild(HOLDER_BOX)
    if okI and stats and stats.ok > 0 and box then return true, "native", box end
    -- fallback: struktur minimal (SL_CodeTextBox + SaveChangesTo menunjuk dirinya sendiri)
    local okF, errF = pcall(function()
        local tb = Instance.new("TextBox")
        tb.Name = HOLDER_BOX
        tb.MultiLine = true
        tb.ClearTextOnFocus = false
        tb.Text = src
        tb.Parent = inst
        local ptr = Instance.new("ObjectValue")
        ptr.Name = HOLDER_PTR
        ptr.Value = tb
        ptr.Parent = tb
    end)
    box = inst:FindFirstChild(HOLDER_BOX)
    if box then return true, "fallback", box end
    return false, tostring(errF or (okI and stats and stats.firstReason) or "gagal membuat SL_CodeTextBox")
end

function ACT.readSource(inst)
    local box = inst:FindFirstChild(HOLDER_BOX)
    if box and box:IsA("TextBox") then
        local ok, t = pcall(function() return box.Text end)
        if ok and type(t) == "string" then return t, box end
    end
    local ok, s = pcall(function() return inst.Source end)
    if ok and type(s) == "string" then return s, nil end
    return "", nil
end

function ACT.writeSource(inst, text)
    text = tostring(text or "")
    text = text:gsub("\r\n", "\n")
    text = text:gsub("\r", "\n")
    local box = inst:FindFirstChild(HOLDER_BOX)
    if not (box and box:IsA("TextBox")) then
        local ok, why, b = ACT.ensureScriptHolder(inst, text)
        if not ok then return false, why end
        box = b
    end
    local okW = pcall(function() box.Text = text end)
    local ptr = box and box:FindFirstChild(HOLDER_PTR)
    if ptr and ptr:IsA("ObjectValue") and ptr.Value and ptr.Value ~= box then
        pcall(function()
            local h = ptr.Value
            if h:IsA("ValueBase") then h.Value = text else h.Text = text end
        end)
    end
    pcall(function() inst:SetAttribute("SL_SourceLen", #text) end)
    if not okW then return false, "gagal menulis ke SL_CodeTextBox" end
    return true
end

-- ===================================================================
-- v8: Editor script docked seperti Roblox Studio (bukan modal 780x560 yang menutup semua panel)
--   - menempel di area tengah (di antara Toolbox & Explorer/Properties, di atas Output)
--   - tab dokumen (banyak script terbuka sekaligus), nomor baris, warna sintaks, status Ln/Col
--   - tombol: Save, A-, A+, Wrap, Color, Size (100% / 60% / 35% tinggi), x
-- Semua state ada di ACT.ed supaya tidak menambah variabel local di level atas (batas 200 local).
-- ===================================================================
do
    local KW = {}
    for w in ("and break do else elseif end for function if in local not or repeat return then until while continue true false nil"):gmatch("%S+") do KW[w] = true end
    local BI = {}
    for w in ("game workspace script self print warn error pairs ipairs next type typeof tostring tonumber require pcall xpcall select assert setmetatable getmetatable rawget rawset rawequal rawlen unpack task math string table os coroutine utf8 bit32 debug Instance Vector3 Vector2 CFrame Color3 BrickColor UDim UDim2 Enum TweenInfo Ray Random Region3 NumberRange NumberSequence ColorSequence Rect Font wait spawn delay tick time shared _G _VERSION Drawing getgenv getrenv getfenv setfenv loadstring"):gmatch("%S+") do BI[w] = true end

    local PAL = {
        dark = { kw = "#F86D7C", str = "#ADF195", num = "#FFC600", com = "#7F8793", bi = "#84D6F7" },
        light = { kw = "#0033CC", str = "#A31515", num = "#098658", com = "#2E8B3A", bi = "#267F99" },
    }
    local ESC = { ["&"] = "&amp;", ["<"] = "&lt;", [">"] = "&gt;", ['"'] = "&quot;", ["'"] = "&apos;" }
    local function escRT(s) return (s:gsub("[&<>\"']", ESC)) end

    -- Pewarna sintaks Luau -> string RichText. Dipanggil lewat pcall; kalau gagal editor jatuh ke teks polos.
    function ACT.highlight(src)
        local pal = PAL[T.name == "dark" and "dark" or "light"]
        local out, n = {}, 0
        local len = #src
        local i = 1
        local function put(s, col)
            if s == "" then return end
            n = n + 1
            if col then out[n] = '<font color="' .. col .. '">' .. escRT(s) .. "</font>"
            else out[n] = escRT(s) end
        end
        while i <= len do
            local c = src:sub(i, i)
            if c == "-" and src:sub(i + 1, i + 1) == "-" then
                local eq = src:match("^%-%-%[(=*)%[", i)
                local e
                if eq then
                    local _, ce = src:find("]" .. eq .. "]", i + 4 + #eq, true)
                    e = ce or len
                else
                    local nl = src:find("\n", i, true)
                    e = nl and (nl - 1) or len
                end
                put(src:sub(i, e), pal.com)
                i = e + 1
            elseif c == '"' or c == "'" or c == "`" then
                local j = i + 1
                while j <= len do
                    local d = src:sub(j, j)
                    if d == "\\" then j = j + 2
                    elseif d == c or d == "\n" then break
                    else j = j + 1 end
                end
                local e
                if j <= len and src:sub(j, j) == c then e = j else e = math.min(j - 1, len) end
                put(src:sub(i, e), pal.str)
                i = e + 1
            elseif c == "[" and src:match("^%[=*%[", i) then
                local eq = src:match("^%[(=*)%[", i)
                local _, ce = src:find("]" .. eq .. "]", i + 2 + #eq, true)
                local e = ce or len
                put(src:sub(i, e), pal.str)
                i = e + 1
            elseif c:match("%d") or (c == "." and src:sub(i + 1, i + 1):match("%d")) then
                local s = src:match("^0[xX][%x_]+", i) or src:match("^0[bB][01_]+", i)
                    or src:match("^%d[%d_]*%.?[%d_]*[eE][%+%-]?%d+", i) or src:match("^%d[%d_]*%.?[%d_]*", i)
                    or src:match("^%.%d+", i) or c
                put(s, pal.num)
                i = i + #s
            elseif c:match("[%a_]") then
                local w = src:match("^[%a_][%w_]*", i)
                local col
                if KW[w] then col = pal.kw
                elseif BI[w] then
                    col = pal.bi
                    local pc = (i > 1) and src:sub(i - 1, i - 1) or ""
                    if pc == "." or pc == ":" then col = nil end -- properti / method, bukan global
                end
                put(w, col)
                i = i + #w
            else
                local s = src:match("^[^%a_%d\"'`%-%[%.]+", i)
                if not s then s = c end
                put(s, nil)
                i = i + #s
            end
        end
        return table.concat(out)
    end

    local function lineNums(n)
        local t = {}
        for k = 1, n do t[k] = tostring(k) end
        return table.concat(t, "\n")
    end

    local function setPill(b, state)
        b.BackgroundColor3 = state and T.accent or T.panelHead
