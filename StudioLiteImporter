        TextTruncate = Enum.TextTruncate.AtEnd }, r.valHolder)
    r.dd = tri(r.valHolder, "down", T.textDim, 5, { Position = U2(1, -12, 0.5, 0), Visible = false })
    r.act = btn(r.valHolder, { Size = U2(1, 0, 1, 0), Visible = false })
    r.del = btn(r.root, { Size = UDim2.fromOffset(20, 18), Visible = false })
    corner(r.del, 4)
    lbl(r.del, { Size = U2(1, 0, 1, 0), Text = "x", TextXAlignment = Enum.TextXAlignment.Center, TextSize = 14, TextColor3 = T.textDim })
