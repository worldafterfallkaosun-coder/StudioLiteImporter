end

local function fmtBytes(n)
    if n < 1024 then return n .. " B" end
    if n < 1048576 then return string.format("%.1f KB", n / 1024) end
    return string.format("%.2f MB", n / 1048576)
end

-- ---- Pengaturan tersimpan ----
local PERSIST = { "DisableScripts", "SpawnInFrontOfCamera", "InstallScriptText", "AutoScan",
    "ScanScope", "AutoImportNew", "AutoHideAfterImport" }

function E.loadSettings()
    if not (isfile and readfile) then return end
    local ok, raw = pcall(function()
        if isfile(CONFIG.SettingsFile) then return readfile(CONFIG.SettingsFile) end
    end)
    if not ok or type(raw) ~= "string" then return end
    local okj, t = pcall(function() return HttpService:JSONDecode(raw) end)
    if not okj or type(t) ~= "table" then return end
    for _, k in ipairs(PERSIST) do
        if t[k] ~= nil then CONFIG[k] = t[k] end
    end
    if CONFIG.ScanScope ~= "all" and CONFIG.ScanScope ~= "folder" then CONFIG.ScanScope = "all" end
    if table.find(TARGETS, t.target) then S.target = t.target end
    if table.find(SORTS, t.sort) then S.sort = t.sort end
    if t.filter == "all" or t.filter == "rbxm" or t.filter == "rbxmx" then S.filter = t.filter end
    if type(t.ui) == "table" then S.ui = t.ui end
end

local saveQueued = false
function E.saveSettings()
    if not (writefile and alive()) or saveQueued then return end
    saveQueued = true
    task.delay(1, function()
        saveQueued = false
        local data = { target = S.target, sort = S.sort, filter = S.filter, ui = S.ui }
        for _, k in ipairs(PERSIST) do data[k] = CONFIG[k] end
        local ok, json = pcall(function() return HttpService:JSONEncode(data) end)
        if ok then
            ensureFolder()
            pcall(writefile, CONFIG.SettingsFile, json)
        end
    end)
end

-- ---- Daftar / filter / urutan ----
local function sortList(list, mode)
    table.sort(list, function(a, b)
        if mode == "name_desc" then
            if a.lname ~= b.lname then return a.lname > b.lname end
        elseif mode == "folder" then
            if a.ldir ~= b.ldir then return a.ldir < b.ldir end
            if a.lname ~= b.lname then return a.lname < b.lname end
        elseif mode == "format" then
            if a.ext ~= b.ext then return a.ext < b.ext end
            if a.lname ~= b.lname then return a.lname < b.lname end
        else
            if a.lname ~= b.lname then return a.lname < b.lname end
        end
        return a.path < b.path
    end)
end

function E.applyView()
    local terms = {}
    for w in S.query:lower():gmatch("%S+") do terms[#terms + 1] = w end
    local v = {}
    local counts = { all = 0, rbxm = 0, rbxmx = 0 }
    for _, e in ipairs(S.entries) do
        local okm = true
        for _, t in ipairs(terms) do
            if not e.lower:find(t, 1, true) then okm = false break end
        end
        if okm then
            counts.all = counts.all + 1
            counts[e.ext] = counts[e.ext] + 1
            if S.filter == "all" or S.filter == e.ext then v[#v + 1] = e end
        end
    end
    sortList(v, S.sort)
    S.view, S.counts = v, counts
    fire("view")
end

function E.selCount()
    local n = 0
    for _ in pairs(S.selected) do n = n + 1 end
    return n
end

function E.selectedList()
    local l = {}
    for _, e in ipairs(S.entries) do
        if S.selected[e.path] then l[#l + 1] = e end
    end
    return l
end

function E.toggle(e)
    if S.busy then return end
    S.selected[e.path] = (not S.selected[e.path]) or nil
    fire("selection")
end

function E.selectView()
    if S.busy then return end
    for _, e in ipairs(S.view) do S.selected[e.path] = true end
    fire("selection")
end

function E.clearSel()
    if S.busy then return end
    S.selected = {}
    fire("selection")
end

function E.setFocus(e)
    S.focus = e
    fire("focus")
    if e and not S.infoCache[e.path] then
        task.spawn(function()
            local info, err = inspectFile(e)
            S.infoCache[e.path] = info or { err = err }
            if S.focus == e then fire("focus") end
        end)
    end
end

-- ---- Scan ----
local function rescan(silent)
    if S.scanning or not alive() then return end
    S.scanning = true
    fire("scanning", true)
    local okS, entries, info = pcall(scanFiles, CONFIG.ScanScope, function() task.wait() end)
    if not okS then
        S.scanning = false
        fire("scanning", false)
        notify("Scan error: " .. tostring(entries), "err")
        return
    end

    sortList(entries, "name")
    local paths, alive_, fresh = {}, {}, {}
    for i, e in ipairs(entries) do
        paths[i] = e.path
        alive_[e.path] = true
        if S.firstScan and not S.known[e.path] then fresh[#fresh + 1] = e end
    end
    local sig = #entries .. ":" .. table.concat(paths, "|")
    local changed = sig ~= S.sig
    if changed then
        S.sig = sig
        S.entries = entries
        for p in pairs(S.selected) do if not alive_[p] then S.selected[p] = nil end end
        for p in pairs(S.status) do if not alive_[p] then S.status[p] = nil end end
        for _, e in ipairs(entries) do S.known[e.path] = true end
        if S.focus and not alive_[S.focus.path] then S.focus = nil end
        E.applyView()
        fire("selection")
        fire("focus")
    end
    S.scanning = false
    fire("scanning", false)

    if info.err then
        notify(info.err, "err")
    elseif not silent or (changed and S.firstScan) then
        local msg
        if #fresh > 0 and silent then
            msg = string.format("%d file baru terdeteksi (total %d)", #fresh, #entries)
        else
            msg = string.format("Scan selesai: %d file .rbxm/.rbxmx", #entries)
            if info.truncated then msg = msg .. " (dibatasi " .. CONFIG.MaxEntries .. " entri)" end
        end
        if not silent or #fresh > 0 then notify(msg, "ok") else setStatus(msg, "info") end
    end
    S.firstScan = true

    -- auto-import file baru dari folder import
    if CONFIG.AutoImportNew and #fresh > 0 and not S.busy then
        local pick = {}
        for _, e in ipairs(fresh) do
            if e.path:sub(1, #CONFIG.Folder + 1) == CONFIG.Folder .. "/" then pick[#pick + 1] = e end
        end
        if #pick > 0 then E.runBatch(pick) end
    end
end

function E.rescan(silent) task.spawn(rescan, silent) end

-- ---- Import satu file ----
-- return: ok, pesan, objek yang ditambahkan, daftar script
local function doImport(path, opts, placeState)
    local objs, how, data = loadFile(path)
    if not objs then return false, how end

    local scripts, parseErr = gatherScripts(data, objs)
    local outDir = exportScripts(path, scripts)

    -- pasang teks script SEBELUM objek masuk ke game (struktur editor Studio Lite)
    local stats = { ok = 0, fail = 0, notes = {} }
    if CONFIG.InstallScriptText and #scripts > 0 then
        local oki, res = pcall(installScriptText, scripts)
        if oki then
            stats = res
        else
            stats.fail = #scripts
            stats.firstReason = tostring(res)
        end
    end

    local target = game:GetService(opts.target)
    local added = {}
    for _, obj in ipairs(objs) do
        sanitize(obj)
        if target == workspace and CONFIG.SpawnInFrontOfCamera then
            placeInFront(obj, placeState)
        end
        local ok = pcall(function() obj.Parent = target end)
        if ok then added[#added + 1] = obj end
    end

    local msg = string.format("%s -> %s: %d objek (via %s)", displayName(path), opts.target, #added, how)
    if #scripts > 0 then
        if CONFIG.InstallScriptText then
            msg = msg .. string.format(", teks script %d/%d", stats.ok, #scripts)
            if stats.fail > 0 then msg = msg .. " (gagal: " .. tostring(stats.firstReason) .. ")" end
        else
            msg = msg .. string.format(", %d script (teks tidak dipasang)", #scripts)
        end
    end
    if parseErr then msg = msg .. " | peringatan baca file: " .. parseErr:sub(1, 80) end
    if outDir and stats.fail > 0 then msg = msg .. " | cadangan .lua: " .. outDir end
    return #added > 0, (#added > 0) and msg or (msg .. " | tidak ada objek yang bisa dipasang"), added, scripts, stats
end

-- ---- Batch import ----
function E.runBatch(list)
    if S.busy then notify("Masih ada proses berjalan.", "warn") return end
    if #list == 0 then notify("Belum ada file dipilih.", "warn") return end
    S.busy, S.cancel = true, false
    fire("busy", true)

    local function body()
        local total = #list
        local batch = { objs = {}, target = S.target, count = total }
        local okN, failN, objN, scriptN = 0, 0, 0, 0
        local placeState = { offset = 0 }
        local allScripts = {}
        local report = {
            "# Import log " .. os.date("%Y-%m-%d %H:%M:%S"),
            "target: " .. S.target, "file: " .. total, "",
        }
        logLine(string.format("Batch dimulai: %d file -> %s", total, S.target), "info")

        for i, e in ipairs(list) do
            if S.cancel or not alive() then
                logLine(string.format("Dibatalkan sebelum file %d/%d", i, total), "warn")
                break
            end
            S.status[e.path] = "busy"
            fire("progress", (i - 1) / total, string.format("Import %d/%d: %s", i, total, e.name))
            fire("rows")
            task.wait()

            local okc, ok, msg, added, scripts, stats = pcall(doImport, e.raw, { target = S.target }, placeState)
            if not okc then
                msg = tostring(ok)
                ok = false
            end

            if ok then
                S.status[e.path], S.reason[e.path] = "ok", nil
                S.selected[e.path] = nil
                okN = okN + 1
                for _, o in ipairs(added) do batch.objs[#batch.objs + 1] = o end
                objN = objN + #added
                scriptN = scriptN + #scripts
                for _, s in ipairs(scripts) do
                    s.file = e.name
                    allScripts[#allScripts + 1] = s
                end
                logLine(msg, "ok")
                report[#report + 1] = "[OK] " .. msg
                for j, s in ipairs(scripts) do
                    report[#report + 1] = string.format("    (%d) %s [%s] %d byte -> %s",
                        j, s.path, s.class, #s.source, tostring(stats.notes[j] or "teks tidak dipasang"))
                end
            else
                S.status[e.path], S.reason[e.path] = "fail", tostring(msg)
                failN = failN + 1
                logLine(e.name .. ": " .. tostring(msg), "err")
                report[#report + 1] = "[GAGAL] " .. e.name .. ": " .. tostring(msg)
            end
            fire("progress", i / total, string.format("Selesai %d/%d", i, total))
            fire("selection")
            fire("rows")
            task.wait()
        end

        if #batch.objs > 0 then
            S.history[#S.history + 1] = batch
            if #S.history > 20 then table.remove(S.history, 1) end
        end
        if #allScripts > 0 then
            S.scriptList, S.scriptIdx = allScripts, 0
        end
        if writefile then
            ensureFolder()
            pcall(writefile, CONFIG.Folder .. "/import_log.txt", table.concat(report, "\n"))
        end

        local summary = string.format("Batch selesai: %d berhasil, %d gagal | %d objek, %d script",
            okN, failN, objN, scriptN)
        if S.cancel then summary = "Batch dibatalkan. " .. summary end
        notify(summary, failN > 0 and (okN > 0 and "warn" or "err") or "ok")
        if okN > 0 and CONFIG.AutoHideAfterImport then fire("autohide") end
    end

    task.spawn(function()
        local ok, err = pcall(body)
        if not ok then notify("Error batch: " .. tostring(err), "err") end
        S.busy, S.cancel = false, false
        fire("busy", false)
        fire("progress", 0, "")
        fire("history")
        fire("selection")
        fire("rows")
    end)
end

function E.cancel()
    if S.busy then
        S.cancel = true
        setStatus("Membatalkan setelah file ini selesai...", "warn")
    end
end

-- ---- Undo ----
function E.undo(all)
    if S.busy then return end
    local n, batches = 0, 0
    while #S.history > 0 do
        local b = table.remove(S.history)
        for _, o in ipairs(b.objs) do
            if o and o.Parent then
                pcall(function() o:Destroy() end)
                n = n + 1
            end
        end
        batches = batches + 1
        if not all then break end
    end
    if batches == 0 then
        notify("Tidak ada batch yang bisa di-undo.", "warn")
    else
        notify(string.format("Undo %d batch: %d objek dihapus.", batches, n), "info")
    end
    fire("history")
end

-- ---- Salin script (clipboard) ----
function E.copyNextScript()
    local n = #S.scriptList
    if n == 0 then notify("Belum ada script dari import terakhir.", "warn") return end
    S.scriptIdx = S.scriptIdx % n + 1
    local s = S.scriptList[S.scriptIdx]
    local clip = setclipboard or toclipboard
    if s.source == "" then
        notify(string.format("Source %s kosong / tidak terbaca (%d/%d).", s.path, S.scriptIdx, n), "err")
    elseif not clip then
        notify("Executor tidak punya setclipboard. Ambil dari folder scripts_out.", "err")
    elseif pcall(clip, s.source) then
        notify(string.format("Disalin: %s [%s] (%d/%d)", s.path, s.class, S.scriptIdx, n), "ok")
    else
        notify("Gagal menyalin ke clipboard.", "err")
    end
end

function E.scanStudioLite()
