        toastLbl.TextColor3 = KIND[kind] or T.text
        toastLbl.TextTransparency = 0
        toastFrame.BackgroundTransparency = 0
        toastStroke.Transparency = 0
        local mx, my = mini.Position.X.Offset, mini.Position.Y.Offset
        local right = mx > viewport().X / 2
        toastFrame.AnchorPoint = Vector2.new(right and 1 or 0, 0)
        toastFrame.Position = UDim2.fromOffset(right and (mx + 44) or mx, (my > 44) and (my - 36) or (my + 50))
        toastFrame.Visible = true
        task.delay(3.2, function()
            if toastToken ~= tok or not alive() then return end
            tween(toastFrame, 0.3, { BackgroundTransparency = 1 })
            tween(toastLbl, 0.3, { TextTransparency = 1 })
            tween(toastStroke, 0.3, { Transparency = 1 })
            task.delay(0.32, function()
                if toastToken == tok and alive() then toastFrame.Visible = false end
            end)
        end)
    end

    local function persistRect()
        S.ui = {
            x = W.x, y = W.y, w = W.w, h = W.h,
            mx = mini.Position.X.Offset, my = mini.Position.Y.Offset,
        }
        E.saveSettings()
    end

    -- ---- Drag generik (mouse & touch) ----
    local function draggable(handle, target, onEnd, canDrag)
        local dragging, moved, dragStart, startPos = false, false, nil, nil
        bind(handle.InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                if canDrag and not canDrag() then
                    if onEnd then onEnd(false) end
                    return
                end
                dragging, moved = true, false
                dragStart, startPos = input.Position, target.Position
                local c
                c = input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                        c:Disconnect()
                        if onEnd then onEnd(moved) end
                    end
                end)
            end
        end)
        bind(UIS.InputChanged, function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                local d = input.Position - dragStart
                if not moved and d.Magnitude < 5 then return end
                moved = true
                local vp = viewport()
                local nx = math.clamp(startPos.X.Offset + d.X, -(target.AbsoluteSize.X - 70), vp.X - 70)
                local ny = math.clamp(startPos.Y.Offset + d.Y, 0, vp.Y - 30)
                target.Position = UDim2.fromOffset(nx, ny)
            end
        end)
    end

