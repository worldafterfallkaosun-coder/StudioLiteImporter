    local function setRowLayout(row, depth, showArrow)
        local indent = 4 + math.min(depth, 12) * 10
        row.arrowBtn.Position = UDim2.fromOffset(indent, 0)
        local nx = indent + (showArrow and 24 or 8)
        row.name.Position = UDim2.fromOffset(nx, 3)
        row.name.Size = UDim2.new(1, -(nx + 108), 0, 15)
        row.sub.Position = UDim2.fromOffset(nx, 18)
        row.sub.Size = UDim2.new(1, -(nx + 108), 0, 11)
    end

    local function paintXRow(row)
        local r = row.r
        if not r then return end
        local f = row.frame
        if r.kind == "head" then
            f.BackgroundTransparency = 1
            row.stroke.Transparency = 1
            row.head.Visible, row.head.Text = true, r.text
            row.arrowBtn.Visible, row.name.Visible, row.sub.Visible = false, false, false
            row.badge.Visible, row.pin.Visible = false, false
            return
        end
        f.BackgroundTransparency = 0
        row.head.Visible = false
        row.name.Visible, row.sub.Visible = true, true

        if r.kind == "more" then
            setRowLayout(row, r.depth, true)
            f.BackgroundColor3 = T.row
            row.stroke.Transparency = 1
            row.name.Text = "+" .. r.n .. " item lainnya"
            row.name.TextColor3 = T.sub
            row.sub.Text = "Pakai kolom cari untuk menemukannya"
            row.arrowBtn.Visible, row.badge.Visible, row.pin.Visible = false, false, false
            return
        end

        local inst = r.inst
        local present = inst ~= nil and inGame(inst)
        local isT = present and inst == curTarget
        local pinned, showArrow = false, false

        if r.kind == "path" then
            pinned = table.find(X.pins, r.path) ~= nil
            setRowLayout(row, 0, false)
            row.name.Text = present and inst.Name or (r.path:match("[^/]+$") or r.path)
            row.sub.Text = present and X.pathOf(inst) or ("tidak ditemukan | " .. r.path)
        else
            pinned = present and X.pinSet[inst] ~= nil
            setRowLayout(row, r.depth or 0, not r.flat)
            row.name.Text = present and inst.Name or "(dihapus)"
            if not present then
                row.sub.Text = ""
            elseif r.flat then
                row.sub.Text = r.sub or inst.ClassName
            else
                local n = X.kidCount(inst)
                row.sub.Text = inst.ClassName .. (n > 0 and (" | " .. n .. " anak") or "")
                showArrow = n > 0
                if showArrow then row.arrow.Rotation = X.expanded[inst] and 90 or 0 end
            end
        end

        row.arrowBtn.Visible = showArrow
        row.name.TextColor3 = present and (isT and T.okText or T.text) or T.sub
        f.BackgroundColor3 = isT and T.rowSel or T.row
        row.stroke.Transparency = isT and 0 or 1
        row.badge.Visible = isT
        row.pin.Visible = present or pinned
        row.pin.Text = pinned and "UNPIN" or "PIN"
        row.pin.BackgroundColor3 = pinned and Color3.fromRGB(150, 105, 35) or T.panel2
    end

