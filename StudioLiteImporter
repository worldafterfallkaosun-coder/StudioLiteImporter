    -- ---- Operasi jendela ----
    local function maxRect()
        local vp = viewport()
        local w, h = math.min(vp.X - 20, 820), math.min(vp.Y - 20, 560)
        return math.floor((vp.X - w) / 2), math.floor((vp.Y - h) / 2), w, h
    end

    local function applyRect(animated)
        local x, y, w, h
        if W.maxed then x, y, w, h = maxRect() else x, y, w, h = W.x, W.y, W.w, W.h end
        if W.minimized then h = TITLE_H end
        local pos, size = UDim2.fromOffset(x, y), UDim2.fromOffset(w, h)
        if animated then
            TweenService:Create(Main, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                { Position = pos, Size = size }):Play()
        else
            Main.Position, Main.Size = pos, size
        end
        Body.Visible = not W.minimized
        StatusBar.Visible = not W.minimized
        grip.Visible = not W.minimized and not W.maxed
    end

    local function toggleMin()
        W.minimized = not W.minimized
        applyRect(true)
    end

    local function toggleMax()
        if W.minimized then W.minimized = false end
        W.maxed = not W.maxed
        applyRect(true)
    end

    local function showWindow()
        if not W.hidden then return end
        W.hidden = false
        mini.Visible = false
        toastFrame.Visible = false
        Main.Visible = true
        mainScale.Scale = 0.92
        tween(mainScale, 0.18, { Scale = 1 }, Enum.EasingStyle.Back)
    end

    local function hideWindow()
        if W.hidden then return end
        W.hidden = true
        tween(mainScale, 0.12, { Scale = 0.92 })
        mini.Visible = true
        updateMini()
        task.delay(0.12, function()
            if alive() and W.hidden then Main.Visible = false end
        end)
    end

