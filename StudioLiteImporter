    b:SetAttribute("on", on and true or false)
    if on then
        b.BackgroundColor3, b.BackgroundTransparency = T.btnActive, 0
    else
        b.BackgroundTransparency = 1
    end
end

-- koordinat pointer dalam koordinat layar (cocok dengan AbsolutePosition ScreenGui IgnoreGuiInset)
local function pointer(input)
    if input and input.UserInputType == Enum.UserInputType.Touch then
        local ok, inset = pcall(function() return GuiService:GetGuiInset() end)
        inset = (ok and inset) or V2(0, 0)
        return V2(input.Position.X + inset.X, input.Position.Y + inset.Y)
    end
    return UIS:GetMouseLocation()
end

local function isPress(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end
local function isMove(input)
    return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
end

-- area yang bisa diseret (slider / splitter / palet warna). list = wadah koneksi global (default: bc)
local function dragArea(obj, onMove, onEnd, onStart, list)
    local active = false
    on(obj.InputBegan, function(input)
        if isPress(input) then
            active = true
            if onStart then onStart(pointer(input)) end
            onMove(pointer(input))
            local c
            c = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    active = false
                    c:Disconnect()
                    if onEnd then onEnd() end
                end
            end)
        end
    end)
    bind2(UIS.InputChanged, function(input)
        if active and isMove(input) then onMove(pointer(input)) end
    end, list)
end

local function fnum(n)
    if type(n) ~= "number" then return tostring(n) end
    if n ~= n then return "nan" end
    if n == math.huge then return "inf" elseif n == -math.huge then return "-inf" end
    if math.abs(n) >= 1e12 then return string.format("%.4g", n) end
    local s = string.format("%.4f", n)
    if s:find("%.") then
        s = s:gsub("0+$", "")
        s = s:gsub("%.$", "")
    end
    if s == "-0" then s = "0" end
    return s
end

local function nums(text)
    local t = {}
    for tok in tostring(text):gmatch("[-+]?%d*%.?%d+") do
        local n = tonumber(tok)
        if n then t[#t + 1] = n end
    end
    return t
end

local function setClip(text)
    local f = setclipboard or toclipboard
    if f then return pcall(f, text) end
    return false
end

